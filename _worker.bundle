    try {
      var ebUrl = "https://www.eventbriteapi.com/v3/events/search/?location.address=" + encodeURIComponent("Accra, Ghana") + "&location.within=50km&sort_by=date&expand=venue,category&size=" + Math.min(maxEvents, 50);
