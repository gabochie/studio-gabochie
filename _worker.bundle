      "SELECT COALESCE((SELECT COUNT(*) FROM subscribers WHERE subscribed_at >= datetime('now', '-30 days')) * 1.0 / NULLIF((SELECT COUNT(*) FROM page_views WHERE viewed_at >= datetime('now', '-30 days')), 0), 0) AS rate"
    ).first();
    let recent = [];
