    // ── Tutor Roadmap ──
    `CREATE TABLE IF NOT EXISTS tutor_roadmap_tasks (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        phase TEXT NOT NULL,
        phase_name TEXT NOT NULL DEFAULT '',
        phase_icon TEXT NOT NULL DEFAULT '',
        task TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'planned',
        sort_order INTEGER NOT NULL DEFAULT 0,
        timeline TEXT NOT NULL DEFAULT '',
        depends_on TEXT NOT NULL DEFAULT '',
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `INSERT OR IGNORE INTO tutor_roadmap_tasks (id, phase, phase_name, phase_icon, task, status, sort_order, timeline, depends_on) VALUES
        (1,  'phase_0', 'Subdomain & Foundation', '\u{1F310}', 'Add tutor.studio.gabochie.com as additional domain in Cloudflare Pages',               'planned', 1,  '~1 hour',    ''),
        (2,  'phase_0', 'Subdomain & Foundation', '\u{1F310}', 'Add host-based routing in _middleware.js',                                              'planned', 2,  '~1 hour',    ''),
        (3,  'phase_0', 'Subdomain & Foundation', '\u{1F310}', 'Copy base files or share via routing',                                                  'planned', 3,  '~1 hour',    ''),
        (4,  'phase_1', 'The Offer & Enrollment MVP', '\u{1F4B0}', 'Pricing packages DB table + admin CRUD',                                             'planned', 1,  '~4-5 days',  'phase_0'),
        (5,  'phase_1', 'The Offer & Enrollment MVP', '\u{1F4B0}', 'Discount codes DB table + admin CRUD',                                              'planned', 2,  '~4-5 days',  'phase_0'),
        (6,  'phase_1', 'The Offer & Enrollment MVP', '\u{1F4B0}', 'Flutterwave checkout for session/bookings',                                         'planned', 3,  '~4-5 days',  'phase_0'),
        (7,  'phase_1', 'The Offer & Enrollment MVP', '\u{1F4B0}', 'Student-facing booking form (tutor \u2192 subject \u2192 date \u2192 pay)',                       'planned', 4,  '~4-5 days',  'phase_0'),
        (8,  'phase_1', 'The Offer & Enrollment MVP', '\u{1F4B0}', 'Email notification on booking',                                                    'planned', 5,  '~4-5 days',  'phase_0'),
        (9,  'phase_1', 'The Offer & Enrollment MVP', '\u{1F4B0}', 'Booking confirmation page',                                                         'planned', 6,  '~4-5 days',  'phase_0'),
        (10, 'phase_2', 'Demand Engine', '\u{1F4E2}', 'Ratings & reviews DB table + API',                                                               'planned', 1,  '~3 days',    'phase_1'),
        (11, 'phase_2', 'Demand Engine', '\u{1F4E2}', 'Tutor detail pages (/tutor/{slug})',                                                             'planned', 2,  '~3 days',    'phase_1'),
        (12, 'phase_2', 'Demand Engine', '\u{1F4E2}', 'Sort/filter by price, rating, featured',                                                         'planned', 3,  '~3 days',    'phase_1'),
        (13, 'phase_2', 'Demand Engine', '\u{1F4E2}', 'SEO meta tags per tutor',                                                                       'planned', 4,  '~3 days',    'phase_1'),
        (14, 'phase_3', 'Full Enrollment Engine', '\u{1F510}', 'Student accounts/login',                                                               'planned', 1,  '~3 days',    'phase_2'),
        (15, 'phase_3', 'Full Enrollment Engine', '\u{1F510}', 'Student dashboard (upcoming bookings, history)',                                      'planned', 2,  '~3 days',    'phase_2'),
        (16, 'phase_3', 'Full Enrollment Engine', '\u{1F510}', 'Admin booking management (approve/decline/reschedule)',                               'planned', 3,  '~3 days',    'phase_2'),
        (17, 'phase_3', 'Full Enrollment Engine', '\u{1F510}', 'Cancel/reschedule booking flow',                                                       'planned', 4,  '~3 days',    'phase_2'),
        (18, 'phase_4', 'Delivery System', '\u{1F680}', 'Tutor availability calendar + weekly slots',                                                  'planned', 1,  '~5-6 days',  'phase_3'),
        (19, 'phase_4', 'Delivery System', '\u{1F680}', 'Zoom/Meet auto-link generation on confirmed booking',                                         'planned', 2,  '~5-6 days',  'phase_3'),
        (20, 'phase_4', 'Delivery System', '\u{1F680}', 'Session management (upcoming/completed/cancelled)',                                         'planned', 3,  '~5-6 days',  'phase_3'),
        (21, 'phase_4', 'Delivery System', '\u{1F680}', 'In-app messaging or WhatsApp notification',                                                  'planned', 4,  '~5-6 days',  'phase_3'),
        (22, 'phase_4', 'Delivery System', '\u{1F680}', 'File/resource sharing per session',                                                          'planned', 5,  '~5-6 days',  'phase_3')
      `,
    // ── Tutoring Waitlist ──
    `CREATE TABLE IF NOT EXISTS tutoring_waitlist (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        email TEXT NOT NULL,
        phone TEXT DEFAULT '',
        role TEXT NOT NULL DEFAULT 'both',
        subjects TEXT NOT NULL DEFAULT '[]',
        source TEXT NOT NULL DEFAULT 'tutoring_waitlist',
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_tutoring_waitlist_email ON tutoring_waitlist(email)`,
    `CREATE INDEX IF NOT EXISTS idx_tutoring_waitlist_role ON tutoring_waitlist(role)`,
    // ── Career Resource Leads (lead magnet) ──
    `CREATE TABLE IF NOT EXISTS career_resource_leads (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        email TEXT NOT NULL,
        name TEXT NOT NULL,
        resource_slug TEXT NOT NULL DEFAULT '',
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_crl_email ON career_resource_leads(email)`,
    // ── Course: Web Development for Ghanaians ──
    `INSERT OR IGNORE INTO programs (title, slug, tagline, description, duration, price, price_label, status, sample_content, full_content, sort_order) VALUES (
        'Web Development for Ghanaians',
        'web-development',
        'Build websites and start freelancing',
        'Learn HTML, CSS, and JavaScript from scratch. Build real projects \u2014 a personal portfolio, a business website, and a landing page \u2014 and learn how to start freelancing as a web developer.',
        'Self-paced',
        150,
        '',
        'active',
        '<h2>Module 1: How the Web Works & Your First HTML Page</h2><p>The web is a network of pages connected by links, served from computers called servers and viewed on devices called clients (your phone, laptop, or tablet). Every time you visit a website, your browser sends a request to a server, and the server sends back HTML, CSS, and JavaScript files that your browser turns into the page you see.</p><h3>What is HTML?</h3><p>HTML (HyperText Markup Language) is the structure of every web page. Think of it like the frame of a building \u2014 it defines where the walls, doors, and windows go. HTML uses tags to label content: headings, paragraphs, images, links, and more.</p><h3>Your First HTML Page</h3><p>Open any text editor (Notepad on Windows, TextEdit on Mac, or VS Code \u2014 download it free from code.visualstudio.com) and type this:</p><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;title&gt;My First Page&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;h1&gt;Hello, Ghana!&lt;/h1&gt;
  &lt;p&gt;This is my first web page.&lt;/p&gt;
&lt;/body&gt;
&lt;/html&gt;</pre><p>Save it as <code>index.html</code> and open it in your browser. You just built your first web page!</p><h3>Common HTML Tags</h3><ul><li><code>&lt;h1&gt;</code> to <code>&lt;h6&gt;</code> \u2014 Headings (h1 is largest, h6 is smallest)</li><li><code>&lt;p&gt;</code> \u2014 Paragraph</li><li><code>&lt;a href=""&gt;</code> \u2014 Link</li><li><code>&lt;img src=""&gt;</code> \u2014 Image</li><li><code>&lt;ul&gt;</code> / <code>&lt;ol&gt;</code> \u2014 Unordered/Ordered lists with <code>&lt;li&gt;</code> items</li><li><code>&lt;div&gt;</code> \u2014 A container/box for grouping content</li></ul><h3>Practice</h3><p>Create a page about yourself with: an h1 heading with your name, a paragraph about what you do, an image of something you love, and a link to your Instagram or WhatsApp.</p>',
        '<h2>Module 1: How the Web Works &amp; Your First HTML Page</h2><p>The web is a network of pages connected by links, served from computers called servers and viewed on devices called clients (your phone, laptop, or tablet). Every time you visit a website, your browser sends a request to a server, and the server sends back HTML, CSS, and JavaScript files that your browser turns into the page you see.</p><h3>What is HTML?</h3><p>HTML (HyperText Markup Language) is the structure of every web page. Think of it like the frame of a building \u2014 it defines where the walls, doors, and windows go. HTML uses tags to label content: headings, paragraphs, images, links, and more.</p><h3>Your First HTML Page</h3><p>Open any text editor (Notepad on Windows, TextEdit on Mac, or VS Code \u2014 download it free from code.visualstudio.com) and type this:</p><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;title&gt;My First Page&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;h1&gt;Hello, Ghana!&lt;/h1&gt;
  &lt;p&gt;This is my first web page.&lt;/p&gt;
&lt;/body&gt;
&lt;/html&gt;</pre><p>Save it as <code>index.html</code> and open it in your browser. You just built your first web page!</p><h3>Common HTML Tags</h3><ul><li><code>&lt;h1&gt;</code> to <code>&lt;h6&gt;</code> \u2014 Headings (h1 is largest, h6 is smallest)</li><li><code>&lt;p&gt;</code> \u2014 Paragraph</li><li><code>&lt;a href=""&gt;</code> \u2014 Link</li><li><code>&lt;img src=""&gt;</code> \u2014 Image</li><li><code>&lt;ul&gt;</code> / <code>&lt;ol&gt;</code> \u2014 Unordered/Ordered lists with <code>&lt;li&gt;</code> items</li><li><code>&lt;div&gt;</code> \u2014 A container/box for grouping content</li></ul><h3>Practice</h3><p>Create a page about yourself with: an h1 heading with your name, a paragraph about what you do, an image of something you love, and a link to your Instagram or WhatsApp.</p><hr><h2>Module 2: Styling with CSS \u2014 Make It Beautiful</h2><p>CSS (Cascading Style Sheets) controls how your HTML looks \u2014 colors, fonts, spacing, layout. If HTML is the frame of a building, CSS is the paint, furniture, and decor.</p><h3>Three Ways to Add CSS</h3><ul><li><strong>Inline</strong> \u2014 style attribute directly on an element: <code>&lt;p style=""color:red""&gt;</code></li><li><strong>Internal</strong> \u2014 <code>&lt;style&gt;</code> tag in the <code>&lt;head&gt;</code></li><li><strong>External</strong> \u2014 separate <code>.css</code> file linked via <code>&lt;link&gt;</code> (best for real projects)</li></ul><h3>Basic CSS Properties</h3><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">body {
  font-family: Arial, sans-serif;
  background-color: #f0f0f0;
  color: #333;
  margin: 0;
  padding: 20px;
}
h1 {
  color: #1a5276;
  text-align: center;
}
p {
  line-height: 1.6;
}</pre><h3>The Box Model</h3><p>Every element on a web page is a rectangular box with: <strong>content</strong> (the text/image inside), <strong>padding</strong> (space inside the border), <strong>border</strong> (the edge), and <strong>margin</strong> (space outside the border). Understanding the box model is the key to controlling layout.</p><div style=""background:#0A1628;padding:12px;border-radius:6px;font-size:13px;line-height:1.5"">margin \u2192 border \u2192 padding \u2192 [content]</div><h3>Practice</h3><p>Take the HTML page you created in Module 1 and add CSS. Give it a background color, change the font, center the heading, and add some padding around the content. Make it look clean and professional.</p><hr><h2>Module 3: JavaScript \u2014 Making Pages Interactive</h2><p>JavaScript is the programming language of the web. HTML is the structure, CSS is the style, and JavaScript is the behavior \u2014 it makes things happen when users click, type, or scroll.</p><h3>Your First JavaScript</h3><p>Add this inside a <code>&lt;script&gt;</code> tag before <code>&lt;/body&gt;</code>:</p><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">&lt;script&gt;
  alert(""Welcome to my website!"");
&lt;/script&gt;</pre><p>When the page loads, a popup appears. That''s JavaScript in action.</p><h3>Variables &amp; Data Types</h3><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">var name = ""Kwame"";          // String
var age = 25;                  // Number
var isStudent = true;          // Boolean
var skills = [""HTML"", ""CSS""];  // Array</pre><h3>Functions &amp; Events</h3><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">function changeText() {
  document.getElementById(""demo"").textContent = ""You clicked the button!"";
}</pre><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">&lt;button onclick=""changeText()""&gt;Click Me&lt;/button&gt;
&lt;p id=""demo""&gt;This text will change.&lt;/p&gt;</pre><h3>Practice</h3><p>Create a page with a button that, when clicked, shows a greeting message using the visitor''s name. Use a prompt to ask for their name, then display ""Hello, [Name]!"".</p><hr><h2>Module 4: Building a Business Website \u2014 Project 1</h2><p>Now you''ll build a real business website \u2014 a landing page for a small Ghanaian business (a restaurant, a fashion brand, or a tech service). This project ties together HTML, CSS, and JavaScript.</p><h3>What a Business Site Needs</h3><ul><li><strong>Hero section</strong> \u2014 Business name, tagline, and call-to-action button</li><li><strong>About section</strong> \u2014 What the business does and why it matters</li><li><strong>Services/Products</strong> \u2014 What they offer (with prices if applicable)</li><li><strong>Contact section</strong> \u2014 Phone number, WhatsApp link, email, or a simple form</li><li><strong>Footer</strong> \u2014 Social media links, copyright</li></ul><h3>Structure Your Project</h3><p>Create a folder called <code>my-business-site</code> with these files:</p><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">my-business-site/
  index.html
  style.css
  script.js
  images/</pre><p>Link the CSS in your HTML <code>&lt;head&gt;</code>: <code>&lt;link rel=""stylesheet"" href=""style.css""&gt;</code><br>Link the JS before <code>&lt;/body&gt;</code>: <code>&lt;script src=""script.js""&gt;&lt;/script&gt;</code></p><h3>Make It Responsive</h3><p>Add this to your CSS so the site looks good on mobile:</p><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">@media (max-width: 768px) {
  body { padding: 10px; }
  h1 { font-size: 24px; }
}</pre><h3>Practice</h3><p>Build a complete landing page for a business of your choice. Make sure it has at least: a hero, an about section, a services list, and a contact section with a WhatsApp link (wa.me/233XXXXXXXXX). Upload your images to the images folder.</p><hr><h2>Module 5: Portfolio Site &amp; Publishing Online \u2014 Project 2</h2><p>Your portfolio is your ticket to freelancing. Clients hire you based on what you can show them, not what you tell them. In this module, you''ll build a personal portfolio and publish it online for free.</p><h3>What a Portfolio Needs</h3><ul><li>Your name and title (e.g. ""Web Developer | Accra, Ghana"")</li><li>A professional photo (or a clean avatar)</li><li>Your skills (HTML, CSS, JavaScript, etc.)</li><li>Your projects (with links and descriptions)</li><li>Your contact info</li><li>Links to your social media / GitHub</li></ul><h3>Publishing with Netlify (Free)</h3><p>Netlify lets you publish a website for free in 2 minutes:</p><ol><li>Go to <a href=""https://netlify.com"" target=""_blank"">netlify.com</a> and sign up with your email or GitHub</li><li>Click ""Add new site"" \u2192 ""Deploy manually""</li><li>Drag and drop your project folder (the one with index.html)</li><li>Netlify gives you a free URL like <code>your-site.netlify.app</code></li></ol><p>You now have a live website on the internet. Share the link with anyone!</p><h3>Practice</h3><p>Build your personal portfolio site, publish it on Netlify, and share the link. Include at least 2 sample projects (even if they''re the ones you built in this course).</p><hr><h2>Module 6: Freelancing as a Web Developer</h2><p>With your skills (HTML, CSS, JavaScript) and your live portfolio, you''re ready to start freelancing. Ghanaian businesses, churches, NGOs, and startups all need websites \u2014 and many are willing to pay.</p><h3>Where to Find Clients</h3><ul><li><strong>WhatsApp</strong> \u2014 Post in business groups, share your portfolio link in your status</li><li><strong>Facebook / Instagram</strong> \u2014 Post before/after examples of sites you''ve built</li><li><strong>Upwork / Freelancer</strong> \u2014 Create a profile (even without prior work, you can bid on small projects)</li><li><strong>Local businesses</strong> \u2014 Walk into shops and restaurants that don''t have websites. Show them your portfolio on your phone and offer to build one for them.</li><li><strong>Fiverr</strong> \u2014 Create a gig offering ""Website Design"" starting at GH\xA2200</li></ul><h3>What to Charge</h3><ul><li>Single landing page: GH\xA2200-500</li><li>Multi-page business site: GH\xA2500-1500</li><li>With booking/contact form: GH\xA2800-2000</li></ul><h3>Getting Paid</h3><p>Use mobile money (MoMo), bank transfer, or payment links via Flutterwave or Paystack. Always ask for 50% upfront before starting, and 50% on completion.</p><h3>Building Confidence</h3><p>Offer to build a free website for a friend or a local church first \u2014 you get a real project for your portfolio, and they get a free site. Win-win. Then use that project to charge the next client.</p><h3>Final Challenge</h3><p>By the end of this course, publish your portfolio, reach out to 5 potential clients or post your services on social media, and build at least 1 paid or pro-bono website for someone else.</p>',
        10
      )`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'How the Web Works & Your First HTML Page', 'web-dev-module-1', 'Learn how the internet works and write your first HTML page.', 0 FROM programs WHERE slug = 'web-development'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Styling with CSS \u2014 Make It Beautiful', 'web-dev-module-2', 'Add colors, fonts, and layout to your pages with CSS.', 1 FROM programs WHERE slug = 'web-development'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'JavaScript \u2014 Making Pages Interactive', 'web-dev-module-3', 'Add interactivity with buttons, forms, and dynamic content.', 2 FROM programs WHERE slug = 'web-development'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Building a Business Website \u2014 Project 1', 'web-dev-module-4', 'Build a complete landing page for a Ghanaian business.', 3 FROM programs WHERE slug = 'web-development'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Portfolio Site & Publishing Online \u2014 Project 2', 'web-dev-module-5', 'Build your portfolio and publish it for free on Netlify.', 4 FROM programs WHERE slug = 'web-development'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Freelancing as a Web Developer', 'web-dev-module-6', 'Find clients, set prices, and start earning as a freelance web developer.', 5 FROM programs WHERE slug = 'web-development'`,
    // ── Course: Digital Marketing & Social Media ──
    `INSERT OR IGNORE INTO programs (title, slug, tagline, description, duration, price, price_label, status, sample_content, full_content, sort_order) VALUES (
        'Digital Marketing & Social Media',
        'digital-marketing',
        'Grow brands and earn from anywhere',
        'Learn to market businesses on social media, create content that sells, run ads, and build a career as a digital marketer. Practical, Ghana-focused, and results-driven.',
        'Self-paced',
        150,
        '',
        'active',
        '<h2>Module 1: The Ghana Digital Marketing Landscape</h2><p>Digital marketing in Ghana is booming. Over 26 million Ghanaians use mobile internet, and platforms like WhatsApp, Facebook, Instagram, and TikTok are where people spend their time. Businesses in Ghana are desperate for people who know how to market online \u2014 but most don''t know where to start.</p><h3>Why Digital Marketing Matters for Ghana</h3><ul><li>Over 10 million active social media users in Ghana (2025)</li><li>Small and medium businesses (SMEs) make up 70% of Ghana''s GDP but most have zero online presence</li><li>Businesses are willing to pay for social media management, ad campaigns, and content creation</li><li>Digital marketing can be done from anywhere \u2014 you don''t need an office or a laptop (a smartphone works)</li></ul><h3>The Core Skills of a Digital Marketer</h3><ul><li><strong>Content Creation</strong> \u2014 Writing posts, taking photos, recording videos</li><li><strong>Social Media Management</strong> \u2014 Posting consistently, engaging with followers, growing accounts</li><li><strong>Paid Advertising</strong> \u2014 Running Facebook/Instagram ads to reach new customers</li><li><strong>Analytics</strong> \u2014 Measuring what works and improving</li><li><strong>Copywriting</strong> \u2014 Writing words that sell</li></ul><h3>Practice</h3><p>Pick a Ghanaian business you know (a restaurant, a fashion brand, a barbershop, or a church). Write down: what social media platforms they use (or should use), what type of content would work for them, and who their target audience is.</p>',
        '<h2>Module 1: The Ghana Digital Marketing Landscape</h2><p>Digital marketing in Ghana is booming. Over 26 million Ghanaians use mobile internet, and platforms like WhatsApp, Facebook, Instagram, and TikTok are where people spend their time. Businesses in Ghana are desperate for people who know how to market online \u2014 but most don''t know where to start.</p><h3>Why Digital Marketing Matters for Ghana</h3><ul><li>Over 10 million active social media users in Ghana (2025)</li><li>Small and medium businesses (SMEs) make up 70% of Ghana''s GDP but most have zero online presence</li><li>Businesses are willing to pay for social media management, ad campaigns, and content creation</li><li>Digital marketing can be done from anywhere \u2014 you don''t need an office or a laptop (a smartphone works)</li></ul><h3>The Core Skills of a Digital Marketer</h3><ul><li><strong>Content Creation</strong> \u2014 Writing posts, taking photos, recording videos</li><li><strong>Social Media Management</strong> \u2014 Posting consistently, engaging with followers, growing accounts</li><li><strong>Paid Advertising</strong> \u2014 Running Facebook/Instagram ads to reach new customers</li><li><strong>Analytics</strong> \u2014 Measuring what works and improving</li><li><strong>Copywriting</strong> \u2014 Writing words that sell</li></ul><h3>Practice</h3><p>Pick a Ghanaian business you know (a restaurant, a fashion brand, a barbershop, or a church). Write down: what social media platforms they use (or should use), what type of content would work for them, and who their target audience is.</p><hr><h2>Module 2: Social Media Strategy &amp; Content Creation</h2><p>A strategy is a plan. Before you post anything, you need to know: who are you talking to, what do they care about, and what do you want them to do?</p><h3>Building a Social Media Strategy</h3><ul><li><strong>Goal</strong> \u2014 What do you want? (More followers? More sales? More bookings?)</li><li><strong>Audience</strong> \u2014 Who are they? (Age, location, interests, problems)</li><li><strong>Platform</strong> \u2014 Where are they? (Instagram for fashion, Facebook for older audiences, TikTok for Gen Z, WhatsApp for direct sales)</li><li><strong>Content Pillars</strong> \u2014 3-5 themes you''ll post about consistently</li><li><strong>Posting Schedule</strong> \u2014 How often? (Instagram: 4-5x/week, TikTok: daily, Facebook: 3x/week)</li></ul><h3>Creating Content with Your Phone</h3><p>You don''t need expensive equipment. Your smartphone is enough:</p><ul><li>Record in good lighting (near a window or under a lamp)</li><li>Use natural backgrounds or a clean wall</li><li>Speak clearly and confidently (even if you''re shy, practice makes perfect)</li><li>Use free editing apps: CapCut (video), Canva (graphics), Lightroom (photos)</li></ul><h3>Practice</h3><p>Create a 7-day content plan for the business you picked in Module 1. Write one post idea for each day, including the caption and the type of visual (photo, video, or graphic).</p><hr><h2>Module 3: Copywriting \u2014 Words That Sell</h2><p>Copywriting is the art of writing words that make people take action \u2014 buy a product, sign up for a service, or share a post. Every caption, every ad, every WhatsApp broadcast is copy.</p><h3>The AIDA Formula</h3><ul><li><strong>Attention</strong> \u2014 Grab their attention with a bold statement or question</li><li><strong>Interest</strong> \u2014 Make them curious about what you offer</li><li><strong>Desire</strong> \u2014 Show them how their life improves</li><li><strong>Action</strong> \u2014 Tell them exactly what to do next</li></ul><h3>Example: A Restaurant Post</h3><p><em>Attention:</em> ""Tired of the same jollof every day?""<br><em>Interest:</em> ""We serve authentic Waakye with shitor, fish, eggs, and gari \u2014 just like Mama used to make.""<br><em>Desire:</em> ""Fresh ingredients, generous portions, and free delivery within Madina.""<br><em>Action:</em> ""Order now on WhatsApp: wa.me/233XXXXXXXXX""</p><h3>Practice</h3><p>Write 3 social media posts using AIDA for the business you picked. Write them as if they were actual Instagram captions (with emojis, line breaks, and a call-to-action).</p><hr><h2>Module 4: Running Facebook &amp; Instagram Ads</h2><p>Paid ads let you reach people who don''t follow you yet. Facebook Ads Manager is the most popular platform for running ads in Ghana.</p><h3>Setting Up Your First Ad</h3><ol><li>Go to <a href=""https://business.facebook.com"" target=""_blank"">business.facebook.com</a> and create a Business Manager account</li><li>Go to Ads Manager and click ""Create""</li><li>Choose your objective: Awareness (reach), Consideration (traffic), or Conversion (sales)</li><li>Define your audience: location (e.g. Accra, Kumasi), age (e.g. 18-45), interests (e.g. fashion, food, music)</li><li>Set your budget: start with GH\xA220 per day for 7 days</li><li>Create your ad: use the copy from Module 3 + a photo or short video</li></ul><h3>Ad Budget Tips for Ghana</h3><ul><li>GH\xA220-50/day is enough to test an ad in Accra</li><li>Always run at least 3 ad variations to see what works best</li><li>Target specific areas (Madina, East Legon, Kumasi Central) instead of the whole country</li><li>Use mobile-optimized content (vertical videos, short captions)</li></ul><h3>Practice</h3><p>Create a mock ad campaign for the business you picked. Write the ad copy, choose an image idea, define the target audience (location, age, interests), and set a budget.</p><hr><h2>Module 5: Analytics &amp; Growing Your Audience</h2><p>Data tells you what''s working. Without analytics, you''re guessing. With analytics, you''re strategizing.</p><h3>Key Metrics to Track</h3><ul><li><strong>Reach</strong> \u2014 How many people saw your post</li><li><strong>Engagement</strong> \u2014 Likes, comments, shares, saves</li><li><strong>Click-through Rate (CTR)</strong> \u2014 Percentage of people who clicked your link</li><li><strong>Conversion Rate</strong> \u2014 Percentage who took the desired action (purchase, signup, etc.)</li><li><strong>Return on Ad Spend (ROAS)</strong> \u2014 Revenue earned divided by money spent on ads</li></ul><h3>Using Instagram Insights</h3><p>If you have a business or creator account on Instagram, you can see Insights for free. Check weekly: which posts got the most engagement, when your followers are most active, and what demographics they are.</p><h3>Growing Your Audience Organically</h3><ul><li>Post consistently (at least 4x/week)</li><li>Use relevant hashtags (#AccraFashion, #GhanaFood, #MadeInGhana)</li><li>Engage with followers (reply to comments, DM people)</li><li>Collaborate with other pages (shoutouts, joint lives)</li><li>Post content that people will share (memes, tips, relatable stories)</li></ul><h3>Practice</h3><p>Analyze the Instagram or Facebook page of a Ghanaian brand you follow. Write down: what type of content gets the most engagement, how often they post, what hashtags they use, and one thing they could improve.</p><hr><h2>Module 6: Freelancing as a Digital Marketer</h2><p>Businesses in Ghana desperately need digital marketers. Many are willing to pay GH\xA2500-2000/month for someone to manage their social media. This module shows you how to get those clients.</p><h3>Services You Can Offer</h3><ul><li><strong>Social Media Management</strong> \u2014 GH\xA2500-1500/month per client (posting, engaging, growing)</li><li><strong>Content Creation</strong> \u2014 GH\xA2100-500 per post (photos, videos, graphics)</li><li><strong>Ad Management</strong> \u2014 GH\xA2500-2000/month (setting up and optimizing ads)</li><li><strong>Strategy Consulting</strong> \u2014 GH\xA21000-3000 one-time (audit + plan)</li></ul><h3>Building Your Portfolio (Even with No Experience)</h3><ol><li>Pick a business you like and offer to manage their social media for free for 1 month</li><li>Document the growth (follower count, engagement, any sales)</li><li>Use that as a case study in your portfolio</li><li>Show the before/after to paying clients</li></ol><h3>Where to Find Clients</h3><ul><li><strong>LinkedIn</strong> \u2014 Post about your services, connect with business owners</li><li><strong>Facebook Groups</strong> \u2014 Join Ghana business groups and offer help</li><li><strong>Upwork / Fiverr</strong> \u2014 Create a profile offering ""Social Media Management""</li><li><strong>Cold outreach</strong> \u2014 DM businesses whose social media is weak and offer a free consultation</li></ul><h3>Final Challenge</h3><p>By the end of this course: create a portfolio of 3 sample social media campaigns (even speculative), post about your services on social media, and sign at least 1 client (paid or pro-bono).</p>',
        11
      )`,
