    if (url.hostname === "news.gabochie.com") allowedOrigins.push("https://news.gabochie.com");
    var originOk = false;
    if (originRaw) {
      try {
        originOk = allowedOrigins.indexOf(new URL(originRaw).origin) !== -1;
      } catch (_e) {
        originOk = false;
      }
    }
    if (!originOk) {
      return new Response(JSON.stringify({ error: "Forbidden" }), {
        status: 403,
        headers: { "Content-Type": "application/json" }
      });
    }
  }
  var pageResponse = await context.next();
  if (isGeoScope(path)) {
    var contentType = pageResponse.headers.get("Content-Type") || "";
    if (contentType.indexOf("text/html") >= 0) {
      var country = request.cf && request.cf.country || "";
