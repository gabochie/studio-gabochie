async function requireAdminAuth(request, env) {
  var cors3 = { "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "Content-Type, X-Admin-Key, X-CI-Secret" };
  var accessUser = await verifyAccessJwt(request, env);
  if (accessUser) return null;
  var key = request.headers.get("X-Admin-Key") || "";
  var adminKey = env.ADMIN_API_KEY || "";
  if (adminKey && key && safeEqual(key, adminKey)) return null;
  if (env.DB) {
    var consoleUser = await getConsoleUser(env.DB, request);
    if (consoleUser) return null;
  }
  if (!adminKey) {
    if (!env.CF_ACCESS_TEAM) {
      return new Response(JSON.stringify({ status: "error", message: "Admin API not configured" }), {
        status: 501,
        headers: Object.assign({ "Content-Type": "application/json" }, cors3)
      });
    }
    return new Response(JSON.stringify({ error: "Unauthorized" }), {
      status: 403,
      headers: Object.assign({ "Content-Type": "application/json" }, cors3)
    });
  }
  return new Response(JSON.stringify({ error: "Unauthorized" }), {
    status: 403,
    headers: Object.assign({ "Content-Type": "application/json" }, cors3)
  });
}
