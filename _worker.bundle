    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Freelancing as a Digital Marketer', 'dm-module-6', 'Find clients, set prices, and build a marketing career.', 5 FROM programs WHERE slug = 'digital-marketing'`,
    // ── Course: Freelancing with AI Tools ──
    `INSERT OR IGNORE INTO programs (title, slug, tagline, description, duration, price, price_label, status, sample_content, full_content, sort_order) VALUES (
        'Freelancing with AI Tools',
        'freelancing-ai',
        'Use AI to land clients and deliver faster',
        'Learn to use ChatGPT, Claude, Canva AI, and other free tools to create content, automate work, and start freelancing. No technical experience required.',
        'Self-paced',
        150,
        '',
        'active',
        '<h2>Module 1: Your AI Toolkit \u2014 Free Tools That Work</h2><p>Artificial Intelligence is no longer science fiction \u2014 it''s a free toolkit available to anyone with a smartphone or laptop. In Ghana, freelancers are already using AI to write content, design graphics, edit videos, and automate tasks \u2014 earning money while working smarter, not harder.</p><h3>The Tools You''ll Use</h3><ul><li><strong>ChatGPT</strong> (chat.openai.com) \u2014 Free AI assistant for writing, brainstorming, research, and problem-solving</li><li><strong>Claude</strong> (claude.ai) \u2014 Free alternative to ChatGPT, excellent for longer content and analysis</li><li><strong>Canva AI</strong> (canva.com) \u2014 Design graphics, presentations, and social media posts with AI-powered tools</li><li><strong>Perplexity</strong> (perplexity.ai) \u2014 AI search engine that finds and summarizes information from the web</li><li><strong>CapCut</strong> \u2014 Free video editing app with AI features (auto-captions, text-to-speech)</li></ul><h3>Getting Started with ChatGPT</h3><p>Go to chat.openai.com and create a free account. You can start asking questions immediately. The key to getting good results from AI is writing good prompts \u2014 specific instructions that tell the AI exactly what you need.</p><h3>Practice</h3><p>Create accounts on ChatGPT and Canva (both free). Ask ChatGPT: ""List 10 freelance services I can offer from Ghana using only my phone."" Write down the most interesting ideas.</p>',
        '<h2>Module 1: Your AI Toolkit \u2014 Free Tools That Work</h2><p>Artificial Intelligence is no longer science fiction \u2014 it''s a free toolkit available to anyone with a smartphone or laptop. In Ghana, freelancers are already using AI to write content, design graphics, edit videos, and automate tasks \u2014 earning money while working smarter, not harder.</p><h3>The Tools You''ll Use</h3><ul><li><strong>ChatGPT</strong> (chat.openai.com) \u2014 Free AI assistant for writing, brainstorming, research, and problem-solving</li><li><strong>Claude</strong> (claude.ai) \u2014 Free alternative to ChatGPT, excellent for longer content and analysis</li><li><strong>Canva AI</strong> (canva.com) \u2014 Design graphics, presentations, and social media posts with AI-powered tools</li><li><strong>Perplexity</strong> (perplexity.ai) \u2014 AI search engine that finds and summarizes information from the web</li><li><strong>CapCut</strong> \u2014 Free video editing app with AI features (auto-captions, text-to-speech)</li></ul><h3>Getting Started with ChatGPT</h3><p>Go to chat.openai.com and create a free account. You can start asking questions immediately. The key to getting good results from AI is writing good prompts \u2014 specific instructions that tell the AI exactly what you need.</p><h3>Practice</h3><p>Create accounts on ChatGPT and Canva (both free). Ask ChatGPT: ""List 10 freelance services I can offer from Ghana using only my phone."" Write down the most interesting ideas.</p><hr><h2>Module 2: Content Creation with AI</h2><p>Content creation is one of the easiest ways to start freelancing with AI. Businesses need content \u2014 social media posts, articles, product descriptions, emails \u2014 and AI can help you create it in minutes.</p><h3>Writing Social Media Posts with ChatGPT</h3><p>Use this prompt template:</p><pre style=""background:#0A1628;padding:12px;border-radius:6px;overflow-x:auto;font-size:13px;line-height:1.5"">Write 5 Instagram captions for a [type of business] in Ghana.
The audience is [target audience].
Each caption should be under 150 words, include 3-5 relevant hashtags, and end with a call-to-action.
Tone: [friendly / professional / funny]</pre><p>Example: ""Write 5 Instagram captions for a waist beads business in Accra. Target audience is women aged 18-35. Each caption should include fashion hashtags and a call-to-action to DM for orders. Tone: friendly and empowering.""</p><h3>Designing Graphics with Canva AI</h3><ol><li>Go to canva.com and search for a template (e.g. ""Instagram Post"")</li><li>Type what you want: ""A minimalist flyer for a catering business in Kumasi""</li><li>Canva AI generates design options \u2014 pick one and customize</li><li>Add your text (use the AI-written caption from ChatGPT)</li><li>Download and deliver to your client</li></ol><h3>Practice</h3><p>Use ChatGPT to write 3 social media posts for a fictional Ghanaian brand (choose any niche \u2014 fashion, food, or tech). Then use Canva AI to create matching graphics for each post.</p><hr><h2>Module 3: Automation &amp; Productivity with AI</h2><p>Automation means letting AI do repetitive work so you can focus on higher-value tasks. This is how freelancers scale \u2014 you can serve more clients without working more hours.</p><h3>Email &amp; Message Templates</h3><p>Use ChatGPT to write templates you''ll reuse:</p><ul><li>""Write a professional pitch email I can send to Ghanaian businesses offering social media management services""</li><li>""Write a follow-up email for a client who hasn''t responded in 3 days""</li><li>""Write a WhatsApp message template for reaching out to potential clients""</li></ul><h3>Research &amp; Analysis</h3><p>Use Perplexity or ChatGPT to research competitors, find content ideas, or analyze a market:</p><ul><li>""Research the top 5 fashion brands in Accra and summarize their social media strategies""</li><li>""What topics are trending in Ghana on Twitter right now?""</li></ul><h3>Content Repurposing</h3><p>Turn one piece of content into many: Ask ChatGPT to ""Turn this blog post into 5 Twitter threads, 3 Instagram captions, and 1 LinkedIn article."" One hour of work becomes a week''s worth of content.</p><h3>Practice</h3><p>Ask ChatGPT to write 3 email templates for your freelance business: a cold outreach email, a follow-up email, and a project completion email. Save them in a document you can reuse.</p><hr><h2>Module 4: Building Your Freelance Business</h2><p>With AI tools, you can offer services that normally require years of experience. The key is to package your services clearly and start getting clients.</p><h3>Services You Can Offer with AI</h3><ul><li><strong>Content Writing</strong> \u2014 Blog posts, articles, captions, product descriptions (GH\xA2100-500 per piece)</li><li><strong>Social Media Management</strong> \u2014 Content calendar, posts, engagement (GH\xA2500-1500/month)</li><li><strong>Graphic Design</strong> \u2014 Flyers, social media graphics, logos with Canva AI (GH\xA250-300 per design)</li><li><strong>Translation</strong> \u2014 English to Twi, Ga, Ewe, or Hausa with AI assistance (GH\xA2100-500 per project)</li><li><strong>Transcription &amp; Summaries</strong> \u2014 Convert audio/video to text with AI tools (GH\xA250-200 per hour)</li><li><strong>AI Consulting</strong> \u2014 Teach business owners how to use ChatGPT (GH\xA2200-500 per session)</li></ul><h3>Getting Your First Clients (Step by Step)</h3><ol><li><strong>Create a portfolio</strong> \u2014 Use Canva AI to create sample graphics, use ChatGPT to write sample posts, compile them into a PDF portfolio</li><li><strong>Set your prices</strong> \u2014 Start low (GH\xA250-200) to get first clients and reviews, increase as you gain confidence</li><li><strong>Post on social media</strong> \u2014 ""I help Ghanaian businesses with content creation, social media management, and AI-powered marketing. DM for samples.""</li><li><strong>Join freelance platforms</strong> \u2014 Create profiles on Upwork, Fiverr, and local platforms</li><li><strong>Over-deliver</strong> \u2014 Give every client more than they expect. This generates referrals.</li></ol><h3>Final Challenge</h3><p>By the end of this course: create a portfolio of 5 sample deliverables (posts, graphics, emails), post your services on social media, and get your first paid client or pro-bono project.</p>',
        12
      )`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Your AI Toolkit \u2014 Free Tools That Work', 'ai-module-1', 'Set up ChatGPT, Canva AI, and other free tools for freelancing.', 0 FROM programs WHERE slug = 'freelancing-ai'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Content Creation with AI', 'ai-module-2', 'Use AI to write posts, design graphics, and create content for clients.', 1 FROM programs WHERE slug = 'freelancing-ai'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Automation & Productivity with AI', 'ai-module-3', 'Automate repetitive tasks and serve more clients.', 2 FROM programs WHERE slug = 'freelancing-ai'`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) SELECT id, 'Building Your Freelance Business', 'ai-module-4', 'Package your services, find clients, and start earning with AI.', 3 FROM programs WHERE slug = 'freelancing-ai'`,
    // Service inquiries table
    `CREATE TABLE IF NOT EXISTS service_inquiries (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        service TEXT NOT NULL,
        name TEXT NOT NULL DEFAULT '',
        email TEXT NOT NULL DEFAULT '',
        phone TEXT DEFAULT '',
        company TEXT DEFAULT '',
        budget TEXT DEFAULT '',
        timeline TEXT DEFAULT '',
        description TEXT DEFAULT '',
        referral TEXT DEFAULT '',
        status TEXT NOT NULL DEFAULT 'new',
        notes TEXT DEFAULT '',
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_service_inquiries_service ON service_inquiries(service)`,
    `CREATE INDEX IF NOT EXISTS idx_service_inquiries_status ON service_inquiries(status)`,
    `CREATE INDEX IF NOT EXISTS idx_service_inquiries_created ON service_inquiries(created_at)`,
    // ── Daily LOTL devotional broadcast (opt-in) ──
    addColumn("subscribers", "lotl_daily", "INTEGER DEFAULT 0"),
    `INSERT OR IGNORE INTO settings (key, value) VALUES ('lotl_daily_enabled', '0')`,
    `CREATE TABLE IF NOT EXISTS lotl_daily_sends (
        send_date TEXT PRIMARY KEY,
        total INTEGER DEFAULT 0,
        created_at TEXT DEFAULT (datetime('now'))
      )`,
    // ── App-level admin roles (super admin system) ──
    addColumn("users", "role", "TEXT NOT NULL DEFAULT 'member'"),
    `INSERT INTO users (name, email, role) VALUES ('Gideon Abochie', 'gid@gabochie.com', 'super_admin')
        ON CONFLICT(email) DO UPDATE SET role = 'super_admin'`,
    // ── Manual direct rails (MoMo + bank transfer, admin-confirmed) ──
    `CREATE TABLE IF NOT EXISTS momo_manual_claims (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        tx_ref TEXT NOT NULL UNIQUE,
        momo_txn_id TEXT NOT NULL,
        payer_number TEXT DEFAULT '',
        rail TEXT NOT NULL DEFAULT 'momo',
        status TEXT NOT NULL DEFAULT 'submitted',
        submitted_at TEXT NOT NULL DEFAULT (datetime('now')),
        decided_at TEXT DEFAULT '',
        decided_by TEXT DEFAULT ''
      )`,
    `CREATE INDEX IF NOT EXISTS idx_momo_claims_status ON momo_manual_claims(status)`,
    addColumn("momo_manual_claims", "rail", "TEXT NOT NULL DEFAULT 'momo'")
  ];
}
__name(getStatements, "getStatements");
var SETUP_CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, X-CI-Secret, X-Admin-Key"
};
function setupResponse(body, status) {
  return new Response(JSON.stringify(body), {
    status: status || 200,
    headers: Object.assign({ "Content-Type": "application/json" }, SETUP_CORS)
  });
}
__name(setupResponse, "setupResponse");
async function onRequest102(context) {
  var { request, env } = context;
  if (request.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: SETUP_CORS });
  }
  if (request.method !== "POST") {
    return setupResponse({ status: "error", message: "Method not allowed" }, 405);
  }
  var ci = request.headers.get("X-CI-Secret") || "";
  if (!(ci && env.CI_WEBHOOK_SECRET && await safeEqual(ci, env.CI_WEBHOOK_SECRET))) {
    var denied = await requireAdminAuth(request, env);
    if (denied) return denied;
  }
  const db = env.DB;
  if (!db) {
    return setupResponse({ error: "D1 not bound" }, 501);
  }
  try {
    const statements = getStatements();
    const results = [];
    const failed = [];
    for (const statement of statements) {
      const sql = typeof statement === "string" ? statement : statement.sql;
      const label = sql.slice(0, 50) + "...";
      try {
        if (typeof statement === "string") {
          await db.prepare(sql).run();
        } else if (statement.kind === "column") {
          await addColumnIfMissing(db, statement.table, statement.column, statement.definition);
        } else if (statement.kind === "once") {
          await runOnceIfNeeded(db, statement.name, sql);
        } else {
          await db.prepare(sql).run();
        }
        results.push({ sql: label, ok: true });
      } catch (e) {
        const entry = { sql: label, ok: false, error: e.message };
        results.push(entry);
        failed.push(entry);
      }
    }
    if (failed.length) {
      return setupResponse({
        status: "error",
        message: failed.length + " setup statement(s) failed",
        tables: results.length,
        results,
        failed,
        failed_count: failed.length
      }, 500);
    }
    return setupResponse({ status: "ok", tables: results.length, results, failed: [], failed_count: 0 });
  } catch (err) {
    return setupResponse({ status: "error", message: err.message, failed: [], failed_count: 0 }, 500);
  }
}
__name(onRequest102, "onRequest");

// api/email/_unsubscribe.js
function unsubscribeSecret(env) {
  return env.UNSUBSCRIBE_SECRET || env.TRACKING_JWT_SECRET || "fallback-secret-change-me";
}
__name(unsubscribeSecret, "unsubscribeSecret");
async function buildUnsubscribeUrl(baseUrl, email, env) {
  const enc = new TextEncoder();
  const key = await crypto.subtle.importKey(
    "raw",
    enc.encode(unsubscribeSecret(env)),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );
  const sig = await crypto.subtle.sign("HMAC", key, enc.encode(email));
  const token = Array.from(new Uint8Array(sig)).map((b) => b.toString(16).padStart(2, "0")).join("");
  return baseUrl + "/api/outreach/unsubscribe?email=" + encodeURIComponent(email) + "&token=" + token;
}
__name(buildUnsubscribeUrl, "buildUnsubscribeUrl");
function unsubscribeFooter(url) {
  return '<div style="margin-top:28px;padding-top:16px;border-top:1px solid #E2E8F0;text-align:center;font-family:sans-serif;font-size:11px;color:#94A3B8">You are receiving this email from Studio Gabochie.<br><a href="' + url + '" style="color:#94A3B8;text-decoration:underline">Unsubscribe</a></div>';
}
__name(unsubscribeFooter, "unsubscribeFooter");
function injectUnsubscribeAndPixel(html, footer, pixel) {
  if (html.indexOf("</body>") >= 0) return html.replace("</body>", footer + pixel + "</body>");
  return html + footer + pixel;
}
__name(injectUnsubscribeAndPixel, "injectUnsubscribeAndPixel");

// api/email/_process-queue.js
var EMAIL_DAILY_LIMIT = 300;
var EMAIL_BATCH_SIZE = 50;
var MAX_RETRIES = 3;
async function processEmailQueue(env, db, opts) {
  opts = opts || {};
  const summary = { sent: 0, failed: 0, pending: 0, attempted: 0, skipped_limited: false, errors: [] };
  if (!db || !env.BREVO_API_KEY) return summary;
  const dailyLimit = opts.dailyLimit || EMAIL_DAILY_LIMIT;
  const batchSize = opts.batchSize || EMAIL_BATCH_SIZE;
  await db.prepare(
    "UPDATE email_queue SET status = 'pending', scheduled_at = datetime('now'), last_error = 'reclaimed: stuck in sending', updated_at = datetime('now') WHERE status = 'sending' AND retry_count < 3 AND COALESCE(updated_at, created_at) < datetime('now', '-15 minutes')"
  ).run();
  await db.prepare(
    "UPDATE email_queue SET status = 'failed', last_error = 'dead-lettered: stuck in sending', updated_at = datetime('now') WHERE status = 'sending' AND retry_count >= 3 AND COALESCE(updated_at, created_at) < datetime('now', '-15 minutes')"
  ).run();
  const sentToday = await countSentToday(db);
  if (sentToday >= dailyLimit) {
    summary.skipped_limited = true;
    return summary;
  }
  const limit = Math.min(batchSize, dailyLimit - sentToday);
  const now = (/* @__PURE__ */ new Date()).toISOString();
  const { results } = await db.prepare(
    `SELECT * FROM email_queue
      WHERE status = 'pending' AND scheduled_at <= ?
        AND to_email NOT IN (SELECT email FROM suppression_list)
      ORDER BY scheduled_at ASC LIMIT ?`
  ).bind(now, limit).all();
  const rows = results || [];
  summary.attempted = rows.length;
  summary.pending = rows.length;
  for (const email of rows) {
    if (sentToday + summary.sent >= dailyLimit) {
      summary.skipped_limited = true;
      break;
    }
    const res = await sendQueuedEmail(env, db, email, dailyLimit);
    if (res.status === "sent") {
      summary.sent++;
      summary.pending--;
    } else if (res.status === "failed") {
      summary.failed++;
      summary.pending--;
    } else if (res.status === "retry" || res.status === "skip") {
      summary.pending--;
    }
    if (res.error) summary.errors.push("send-" + email.id + ": " + res.error);
    await new Promise((r) => setTimeout(r, 100));
  }
  return summary;
}
__name(processEmailQueue, "processEmailQueue");
function todayStart() {
  return (/* @__PURE__ */ new Date()).toISOString().slice(0, 10) + " 00:00:00";
}
__name(todayStart, "todayStart");
async function countSentToday(db) {
  const row = await db.prepare(
    "SELECT COUNT(*) AS cnt FROM email_queue WHERE sent_at >= ?"
  ).bind(todayStart()).first();
  return row && row.cnt || 0;
}
__name(countSentToday, "countSentToday");
async function sendQueuedEmail(env, db, email, dailyLimit) {
  const id = email.id;
  try {
    const claim = await db.prepare(
      "UPDATE email_queue SET status = 'sending', updated_at = datetime('now') WHERE id = ? AND status = 'pending'"
    ).bind(id).run();
    if (!claim || !claim.meta || claim.meta.changes === 0) {
      return { status: "skip", error: "not claimed" };
    }
    if (await countSentToday(db) >= (dailyLimit || EMAIL_DAILY_LIMIT)) {
      await db.prepare("UPDATE email_queue SET status = 'pending' WHERE id = ? AND status = 'sending'").bind(id).run();
      return { status: "skip", error: "daily cap reached" };
    }
    const baseUrl = env.PUBLIC_BASE_URL || "https://studio.gabochie.com";
    const pixel = `<img src="${baseUrl}/api/track/open?mid=${id}&cid=${encodeURIComponent(email.to_email)}" width="1" height="1" alt="" style="display:none">`;
    const unsubUrl = await buildUnsubscribeUrl(baseUrl, email.to_email, env);
    const withFooter = injectUnsubscribeAndPixel(email.html_content, unsubscribeFooter(unsubUrl), pixel);
    const trackedHtml = rewriteLinksForTracking(withFooter, baseUrl, id, email.to_email);
    const result = await sendBrevoEmail(
      env,
      email.to_email,
      email.to_name,
      email.subject,
      trackedHtml,
      { tags: [email.email_type || "manual", "msg_" + id] }
    );
    const providerId = result && result.messageId || null;
    await db.prepare(
      `UPDATE email_queue SET status = 'sent', sent_at = datetime('now'),
         provider_id = ?, updated_at = datetime('now') WHERE id = ?`
    ).bind(providerId, id).run();
    return { status: "sent", provider_id: providerId };
  } catch (err) {
    const retryCount = (email.retry_count || 0) + 1;
    const message = String(err && err.message || err).slice(0, 500);
    if (retryCount >= MAX_RETRIES) {
      await db.prepare(
        `UPDATE email_queue SET status = 'failed', retry_count = ?,
           last_error = ?, updated_at = datetime('now') WHERE id = ?`
      ).bind(retryCount, message, id).run();
      return { status: "failed", error: message };
    }
    await db.prepare(
      `UPDATE email_queue SET status = 'pending', retry_count = ?, last_error = ?,
         scheduled_at = datetime('now', '+' || ? || ' minutes'), updated_at = datetime('now')
       WHERE id = ?`
    ).bind(retryCount, message, retryCount * 5, id).run();
    return { status: "retry", error: message };
  }
}
