// api/gateways/moolre/callback.js
async function onRequest29(context) {
  const { request, env } = context;
  if (request.method !== "POST") return json({ error: "Method not allowed" }, 405);
  let body;
  try {
    body = await readBody(request);
  } catch (_e) {
    body = {};
  }
  if (!env.DB) return json({ status: "ok" });
  const data = body.data || {};
  const ref = String(data.externalref || body.externalref || "").trim();
  const txid = data.transactionid || (body.reference || "");
  if (!ref) return json({ error: "Missing externalref" }, 400);
  const v = await verifyMoolre(env, { externalref: ref, transactionid: txid });
  if (!v.success) return json({ status: "ok", pending: true });
  if (ref.indexOf("moolre_") === 0 || ref.indexOf("ghipss_") === 0) {
    const row = await env.DB.prepare("SELECT * FROM donations WHERE tx_ref = ?").bind(ref).first();
    if (row) {
      await finalizeDonation(env, {
        tx_ref: row.tx_ref,
        amount: v.amount || row.amount,
        currency: row.currency,
        donor_name: row.donor_name,
        donor_email: row.donor_email,
        donor_phone: row.donor_phone,
        gateway: ref.indexOf("ghipss_") === 0 ? "ghipss" : "moolre",
        gateway_txid: v.transactionid || row.flw_id
      });
    }
    return json({ status: "ok" });
  }
  let found = null;
  try {
    found = await resolvePendingTx(env.DB, ref);
  } catch (_e) {
    return json({ status: "error", message: "Lookup failed" }, 500);
  }
  if (!found) return json({ status: "ok", note: "already settled or unknown" });
  const paidAmount = v.amount != null && v.amount !== "" ? parseFloat(v.amount) : found.amount;
  if (found.amount && Math.abs(paidAmount - found.amount) > 0.5) {
    return json({ status: "error", message: "Amount mismatch" }, 402);
  }
  await settlePaidTx(env, env.DB, {
    tx_ref: ref,
    amount: paidAmount || found.amount,
    currency: "GHS",
    status: "successful",
    event: "charge.completed",
    name: found.name || "",
    email: found.email || "",
    phone: found.phone || "",
    gateway: "moolre",
    gatewayTxId: v.transactionid || txid || ""
  });
  return json({ status: "ok", settled: true });
}
__name(onRequest29, "onRequest");

// api/gateways/moolre/create.js
async function onRequest30(context) {
  const { request, env } = context;
  if (request.method !== "POST") return json({ error: "Method not allowed" }, 405);
  const ip = request.headers.get("CF-Connecting-IP") || "";
  if (!await checkRateLimit(env.DB, ip, "moolre_create", 5, 60)) {
    return json({ status: "error", message: "Too many requests. Try again later." }, 429);
  }
  let body;
  try {
    body = await readBody(request);
  } catch (_e) {
    return json({ status: "error", message: "Invalid JSON body" }, 400);
  }
  const clientRef = String(body && body.tx_ref || "").trim();
  let tx_ref, amount, name, email, phone, currency, stageDonation;
  if (clientRef) {
    if (!env.DB) return json({ status: "error", message: "D1 not bound" }, 501);
    let found = null;
    try {
      found = await resolvePendingTx(env.DB, clientRef);
    } catch (_e) {
      return json({ status: "error", message: "Lookup failed" }, 500);
    }
    if (!found) return json({ status: "error", message: "Unknown or already-settled transaction" }, 404);
    tx_ref = clientRef;
    amount = found.amount;
    name = String(body && body.name || found.name || "").trim();
    email = String(body && body.email || found.email || "").trim();
    phone = String(body && body.phone || found.phone || "").trim();
    currency = String(body && body.currency || "GHS").toUpperCase();
    stageDonation = false;
  } else {
    amount = parseFloat(body && body.amount);
    if (!amount || amount <= 0) return json({ status: "error", message: "Invalid amount" }, 400);
    name = String(body && body.name || "").trim();
    email = String(body && body.email || "").trim();
    phone = String(body && body.phone || "").trim();
    currency = String(body && body.currency || "GHS").toUpperCase();
    tx_ref = newRef("moolre_");
    stageDonation = true;
  }
  if (!email || !email.includes("@")) return json({ status: "error", message: "A valid email is required" }, 400);
  const base = moolreBase(env);
  const headers2 = moolreHeaders(env);
  const site = publicBase2(env);
  const callbackUrl = site + "/api/gateways/moolre/callback";
  var redirectPath = body.redirect && body.redirect.charAt(0) === "/" && body.redirect.charAt(1) !== "/" ? body.redirect : "/donate.html";
  const redirectUrl = site + redirectPath + (redirectPath.indexOf("?") >= 0 ? "&" : "?") + "tx_ref=" + encodeURIComponent(tx_ref) + "&status=successful&amount=" + encodeURIComponent(String(amount));
  let linkData;
  try {
    const resp = await fetch(base + "/embed/link", {
      method: "POST",
      headers: headers2,
      body: JSON.stringify({
        type: 1,
        amount: String(amount),
        email: env.MOOLRE_BUSINESS_EMAIL || "studio@gabochie.com",
        externalref: tx_ref,
        callback: callbackUrl,
        redirect: redirectUrl,
        reusable: "0",
        expiration_time: 1440,
        currency,
        accountnumber: env.MOOLRE_ACCOUNT_NUMBER || ""
      })
    });
    const data = await resp.json();
    if (data.status !== 1 || !data.data || !data.data.authorization_url) {
      return json({ status: "error", message: data && data.message || "Mobile money is briefly unavailable \u2014 please pay with crypto or try again in a few minutes.", code: data && data.code });
    }
    linkData = data.data;
  } catch (_e) {
    return json({ status: "error", message: "Mobile money is briefly unavailable \u2014 please pay with crypto or try again in a few minutes.", code: "moolre_unreachable" });
  }
  if (stageDonation) {
    try {
      await env.DB.prepare(
        `INSERT INTO donations (tx_ref, amount, currency, donor_name, donor_email, donor_phone, status, provider, flw_id, created_at)
         VALUES (?, ?, ?, ?, ?, ?, 'pending', 'moolre', ?, datetime('now'))
         ON CONFLICT(tx_ref) DO UPDATE SET amount = excluded.amount, currency = excluded.currency, donor_name = excluded.donor_name, donor_email = excluded.donor_email, donor_phone = excluded.donor_phone, status = 'pending', provider = 'moolre', flw_id = excluded.flw_id`
      ).bind(tx_ref, amount, currency, name, email, phone, linkData.reference || "").run();
    } catch (_e) {
    }
  }
  return json({ status: "ok", tx_ref, authorization_url: linkData.authorization_url, reference: linkData.reference });
}
__name(onRequest30, "onRequest");

// api/guitar/_utils.js
async function getUser(ctx) {
  const auth = ctx.request.headers.get("Authorization");
  if (!auth?.startsWith("Bearer ")) return null;
  const token = auth.slice(7);
  const session = await ctx.env.DB.prepare(
    'SELECT user_id FROM sessions WHERE token = ? AND expires_at > datetime("now")'
  ).bind(token).first();
  if (!session) return null;
  return await ctx.env.DB.prepare("SELECT id, email, name FROM users WHERE id = ?").bind(session.user_id).first();
}
__name(getUser, "getUser");
function json5(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { "Content-Type": "application/json", "Access-Control-Allow-Origin": "*" }
  });
}
__name(json5, "json");

// api/guitar/enroll/status.js
var PLAN_RANK = { bronze: 1, silver: 2, gold: 3, apprentice: 4, full: 4 };
var TIER_NAMES = { 0: "none", 1: "bronze", 2: "silver", 3: "gold", 4: "apprentice" };
async function onRequest31(context) {
  const db = context.env.DB;
  const user = await getUser(context);
  if (!user) return json5({ unlocked: false, tier: "none", bronzeUnlocked: false, silverUnlocked: false, goldUnlocked: false });
  let rank = 0;
  try {
    const { results } = await db.prepare(
      "SELECT plan, status FROM guitar_payments WHERE user_id = ? AND status = 'completed'"
    ).bind(user.id).all();
    for (const p of results || []) {
      const r = p.plan ? PLAN_RANK[p.plan] || 0 : PLAN_RANK.full;
      if (r > rank) rank = r;
    }
  } catch (_) {
    rank = 0;
  }
  let freeModules = 3;
  try {
    const row = await db.prepare("SELECT value FROM settings WHERE key = 'guitar_free_modules'").first();
    if (row) freeModules = parseInt(row.value) || 3;
  } catch (_) {
  }
  return json5({
    unlocked: rank >= 4,
    // legacy semantics: all 16 modules + everything
    tier: TIER_NAMES[rank],
    bronzeUnlocked: rank >= 1,
    // modules 1-5 (after the free preview)
    silverUnlocked: rank >= 2,
    // modules 6-11 + the song library
    goldUnlocked: rank >= 3,
    // modules 12-16
    songLibraryUnlocked: rank >= 2,
    freeModules
  });
}
__name(onRequest31, "onRequest");

