  if (!submitted.ok) {
    return json({ status: "error", message: "Card & MoMo payments are briefly unavailable \u2014 please pay with crypto or try again in a few minutes.", code: submitted.error });
  }
  try {
    await env.DB.prepare("INSERT INTO expresspay_tokens (tx_ref, token) VALUES (?, ?) ON CONFLICT(tx_ref) DO UPDATE SET token = excluded.token").bind(tx_ref, submitted.token).run();
  } catch (_e) {
  }
