    if (!validRoles.includes(role)) role = "both";
    if (!Array.isArray(subjects)) subjects = [];
    var existing = await env.DB.prepare("SELECT id FROM tutoring_waitlist WHERE email = ?").bind(email).first();
    if (existing) {
      return new Response(JSON.stringify({ status: "ok", message: "You're already on the waitlist! We'll notify you when we launch." }), { status: 200, headers: { "Content-Type": "application/json", ...CORS12 } });
    }
