  m = /<media:thumbnail[^>]*\surl="([^"]*)"/i.exec(xml2);
  if (m) return m[1];
  m = /<enclosure[^>]*\surl="([^"]*)"[^>]*type="image\//i.exec(xml2);
  if (m) return m[1];
  m = /<img[^>]*\ssrc="([^"]*)"/i.exec(xml2);
  if (m) return m[1];
  return "";
}
