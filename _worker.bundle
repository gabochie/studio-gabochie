      "SELECT id, correct_answer FROM quiz_questions WHERE program_id = ? ORDER BY sort_order ASC, id ASC"
    ).bind(enrollment.program_id).all()).results || [];
    if (!questions.length) {
      return new Response(JSON.stringify({ status: "error", message: "No questions for this program" }), { status: 400, headers: Object.assign({ "Content-Type": "application/json" }, cors3) });
    }
