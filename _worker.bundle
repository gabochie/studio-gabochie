    const price = plan === "full" ? prices.full : prices[plan];
    const tx_ref = "GUITAR_" + Date.now() + "_" + Math.random().toString(36).slice(2, 8);
    await db.prepare("INSERT INTO guitar_payments (user_id, email, status, flw_tx_ref, amount, plan) VALUES (?, ?, ?, ?, ?, ?)").bind(user.id, user.email, "pending", tx_ref, price, plan).run();
