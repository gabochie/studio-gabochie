async function verifyBrevoSignature(payload2, signature, secret) {
  try {
    const encoder = new TextEncoder();
    const key = await crypto.subtle.importKey(
      "raw",
      encoder.encode(secret),
      { name: "HMAC", hash: "SHA-256" },
      false,
      ["sign"]
    );
    const digest = await crypto.subtle.sign("HMAC", key, encoder.encode(payload2));
    const expected = Array.from(new Uint8Array(digest)).map(function(b) {
      return b.toString(16).padStart(2, "0");
    }).join("");
    return safeEqual(expected, String(signature).toLowerCase());
  } catch (err) {
    console.error("Signature verification error:", err);
    return false;
  }
}
