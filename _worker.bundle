// api/certificates/generate.js
function genCode() {
  var c = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  var r = "";
  for (var i = 0; i < 4; i++) {
    for (var j = 0; j < 4; j++) r += c.charAt(Math.floor(Math.random() * c.length));
    if (i < 3) r += "-";
  }
  return r;
}
