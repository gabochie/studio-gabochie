async function onRequest197(context) {
  const { request, env } = context;
  const url = new URL(request.url);
  const path = url.pathname;
  const host = request.headers.get("Host") || "";
  var isNews = host === "news.gabochie.com" || host.startsWith("news.");
  var gatedPaths = ["/dashboard/", "/admin/"];
  var isGated = false;
  for (var i = 0; i < gatedPaths.length; i++) {
    if (path === gatedPaths[i] || path.startsWith(gatedPaths[i])) {
      isGated = true;
      break;
    }
  }
  var sessionValid = false;
  if (isGated) {
    if (path.startsWith("/admin/")) {
      var accessUser = await verifyAccessJwt(request, env);
      if (accessUser) sessionValid = true;
    }
    if (!sessionValid && env.DB) {
      var cookie = request.headers.get("Cookie") || "";
      var m = cookie.match(/(?:^|;\s*)ga_session=([^;]+)/);
      if (m) {
        try {
          var row = await env.DB.prepare(
            "SELECT user_id FROM sessions WHERE token = ? AND expires_at > datetime('now')"
          ).bind(m[1]).first();
          if (row) sessionValid = true;
        } catch (_e) {
        }
      }
    }
  }
  if (isGated && !sessionValid) {
    var loginUrl = "/login/?redirect=" + encodeURIComponent(path);
    return new Response(null, {
      status: 302,
      headers: { "Location": loginUrl }
    });
  }
  if (isNews) {
    if (path.startsWith("/api/")) return context.next();
    var assetPath = path === "/" ? "/news/index.html" : "/news" + path;
    var response = await env.ASSETS.fetch(new URL(assetPath, request.url));
    if (response.status === 404) {
      response = await env.ASSETS.fetch(request.url);
    }
    return response;
  }
  if (env.DB) {
    try {
      const row2 = await env.DB.prepare("SELECT value FROM settings WHERE key = 'coming_soon'").first();
      if (row2 && row2.value === "true") {
        return new Response(COMING_SOON, {
          status: 200,
          headers: { "Content-Type": "text/html;charset=utf-8" }
        });
      }
    } catch (_e) {
    }
  }
  var method = request.method;
  var isMutating = method === "POST" || method === "PUT" || method === "PATCH" || method === "DELETE";
  var providerVerified = request.headers.has("X-Mailin-Signature") || request.headers.has("x-nowpayments-sig") || request.headers.has("X-Flutterwave-Signature") || path.indexOf("/api/gateways/expresspay/callback") === 0;
  if (isMutating && !providerVerified) {
