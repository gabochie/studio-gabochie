    once("task-status-13", `UPDATE tasks SET status = 'done' WHERE phase = 7 AND title LIKE '%press kit%' AND status = 'pending'`),
    once("task-status-14", `UPDATE tasks SET status = 'done' WHERE phase = 7 AND title LIKE '%JSON-LD%' AND status = 'pending'`),
    once("task-status-15", `UPDATE tasks SET status = 'done' WHERE phase = 7 AND title LIKE '%referral API%' AND status = 'pending'`),
    once("task-status-16", `UPDATE tasks SET status = 'done' WHERE phase = 7 AND title LIKE '%Share-to-unlock%' AND status = 'pending'`),
    once("task-status-17", `UPDATE tasks SET status = 'done' WHERE phase = 7 AND title LIKE '%Partners page%' AND status = 'pending'`),
    once("task-status-18", `UPDATE tasks SET status = 'done' WHERE phase = 7 AND title LIKE '%Press kit page%' AND status = 'pending'`),
    once("task-status-19", `UPDATE tasks SET status = 'done' WHERE phase = 7 AND title LIKE '%Content library page%' AND status = 'pending'`),
    // Seed data removed to prevent re-insertion on deploy. Programs managed through admin CRUD.
    // Module seeds for new programs
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) VALUES
        ((SELECT id FROM programs WHERE slug = 'systems-thinking-genesis'), 'Module 1: The Spirit Hovering \u2014 Divine Creativity in Creation', 'spirit-hovering', 'The Spirit of God hovers over the waters (Genesis 1:2) as the agent of creation. Explore the six days as a creative process of separation, formation, and filling \u2014 and how human creativity reflects the divine image.', 1),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking-genesis'), 'Module 2: The God Who Restores \u2014 Wisdom in the Fall &amp; Flood', 'god-who-restores', 'God''s wisdom in judgment and redemption: the fall as system breakdown (Genesis 3), the flood as a systemic reset (Genesis 6), and the covenant with Noah as a designed system of preservation.', 2),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking-genesis'), 'Module 3: Noah to Babel \u2014 Divine Love Preserving and Scattering', 'noah-to-babel', 'God''s love preserves a remnant (Noah, Genesis 6:8) and scatters for blessing (Babel, Genesis 11). The Table of Nations reveals God''s heart for all peoples. Systems thinking and creative thinking lenses on divine love.', 3),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking-genesis'), 'Module 4: Abraham \u2014 The Covenant as a Divine Design System', 'abraham-covenant', 'The Abrahamic covenant as a masterclass in design thinking: empathize, define, ideate, prototype, test. God creates a people from nothing and designs a system with feedback loops for failure and restoration.', 4),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking-genesis'), 'Module 5: Isaac &amp; Jacob \u2014 Patterns of Grace, Struggle &amp; Transformation', 'isaac-jacob-patterns', 'Family systems reveal God''s redemptive patterns. Jacob''s cycle of blessing, loss, encounter, transformation, and return mirrors our own spiritual journey. Pattern recognition and creative thinking lenses.', 5),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking-genesis'), 'Module 6: Joseph \u2014 Divine Sovereignty as the Ultimate System', 'joseph-sovereignty', 'From the pit to the palace \u2014 Joseph''s journey weaves creativity, wisdom, and love together. His grain storage system (stock-and-flow), design thinking with his brothers, and the ultimate declaration of sovereignty in Genesis 50:20.', 6),
        ((SELECT id FROM programs WHERE slug = 'intro-design-thinking'), 'Module 1: What is Design Thinking?', 'dt-intro', 'The five phases of design thinking and the mindset behind them.', 1),
        ((SELECT id FROM programs WHERE slug = 'intro-design-thinking'), 'Module 2: Empathize & Define', 'dt-empathize', 'Understanding users and framing the right problem to solve.', 2),
        ((SELECT id FROM programs WHERE slug = 'intro-design-thinking'), 'Module 3: Ideate & Prototype', 'dt-ideate', 'Generating ideas and building quick prototypes to test assumptions.', 3),
        ((SELECT id FROM programs WHERE slug = 'intro-design-thinking'), 'Module 4: Test & Iterate', 'dt-test', 'Testing solutions, gathering feedback, and iterating toward better outcomes.', 4),
        ((SELECT id FROM programs WHERE slug = 'design-thinking-genesis'), 'Module 1: The Ultimate Designer', 'dtg-designer', 'God as the original design thinker - intentionality in creation.', 1),
        ((SELECT id FROM programs WHERE slug = 'design-thinking-genesis'), 'Module 2: Form and Function in Creation', 'dtg-form-function', 'How each created thing has both form and purpose.', 2),
        ((SELECT id FROM programs WHERE slug = 'design-thinking-genesis'), 'Module 3: Iteration and Rhythms', 'dtg-iteration', 'The daily rhythm of creation as a design iteration cycle.', 3),
        ((SELECT id FROM programs WHERE slug = 'design-thinking-genesis'), 'Module 4: Stewardship as Design', 'dtg-stewardship', 'Humanity as stewards - designed to design.', 4),
        ((SELECT id FROM programs WHERE slug = 'intro-biomimicry'), 'Module 1: Nature as Mentor', 'bio-mentor', 'Why nature is the world''s best engineer and designer.', 1),
        ((SELECT id FROM programs WHERE slug = 'intro-biomimicry'), 'Module 2: Patterns in Nature', 'bio-patterns', 'Recurring patterns - spirals, fractals, hexagons, and branching.', 2),
        ((SELECT id FROM programs WHERE slug = 'intro-biomimicry'), 'Module 3: Biomimetic Design', 'bio-design', 'How biomimicry is used in architecture, materials, and technology.', 3),
        ((SELECT id FROM programs WHERE slug = 'intro-biomimicry'), 'Module 4: Case Studies', 'bio-cases', 'Real-world examples of biomimicry solving human challenges.', 4),
        ((SELECT id FROM programs WHERE slug = 'intro-geometry'), 'Module 1: The Dot and Points', 'geo-dot', 'The simplest element - the dot, and how points define space.', 1),
        ((SELECT id FROM programs WHERE slug = 'intro-geometry'), 'Module 2: Dots, Lines and Angles', 'geo-lines', 'From dots to lines, rays, segments, and the angles they form.', 2),
        ((SELECT id FROM programs WHERE slug = 'intro-geometry'), 'Module 3: Shapes and Forms', 'geo-shapes', 'Two-dimensional shapes and three-dimensional forms.', 3),
        ((SELECT id FROM programs WHERE slug = 'intro-geometry'), 'Module 4: Planes and Space', 'geo-planes', 'Understanding planes, dimensions, and spatial relationships.', 4),
        ((SELECT id FROM programs WHERE slug = 'intro-computing'), 'Module 1: What is a Computer?', 'comp-what', 'Definition, history, and the core idea of a computing machine.', 1),
        ((SELECT id FROM programs WHERE slug = 'intro-computing'), 'Module 2: Hardware & Software', 'comp-hardware', 'The physical components and the programs that make them useful.', 2),
        ((SELECT id FROM programs WHERE slug = 'intro-computing'), 'Module 3: How Computers Think', 'comp-think', 'Binary, logic gates, and the fundamentals of computation.', 3),
        ((SELECT id FROM programs WHERE slug = 'intro-computing'), 'Module 4: The Digital World', 'comp-digital', 'Networks, the internet, and how computers communicate.', 4),
        ((SELECT id FROM programs WHERE slug = 'intro-storytelling'), 'Module 1: Why Story Matters', 'story-why', 'The neurological, spiritual, and cultural power of narrative.', 1),
        ((SELECT id FROM programs WHERE slug = 'intro-storytelling'), 'Module 2: Narrative Structure', 'story-structure', 'Arcs, beats, and the architecture of a compelling story.', 2),
        ((SELECT id FROM programs WHERE slug = 'intro-storytelling'), 'Module 3: Character, Voice & Metaphor', 'story-character', 'Creating memorable characters, finding your voice, and wielding metaphor.', 3),
        ((SELECT id FROM programs WHERE slug = 'intro-storytelling'), 'Module 4: Storytelling Across Media', 'story-media', 'Oral tradition, written word, visual storytelling, and digital narratives.', 4),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking'), 'Module 1: The Iceberg Model', 'iceberg-model', 'See below the surface \u2014 events, patterns, structure, and mental models.', 1),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking'), 'Module 2: Feedback Loops', 'feedback-loops', 'Reinforcing and balancing loops that drive growth, stability, and collapse.', 2),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking'), 'Module 3: Leverage Points', 'leverage-points', 'Where to intervene in a system for maximum impact with minimum effort.', 3),
        ((SELECT id FROM programs WHERE slug = 'systems-thinking'), 'Module 4: Mental Models', 'mental-models', 'The beliefs, values, and assumptions that shape system behavior.', 4),
        ((SELECT id FROM programs WHERE slug = 'architectural-thinking'), 'Module 1: Blueprint Thinking', 'blueprint-thinking', 'Structuring ideas and projects with clarity and purpose before building.', 1),
        ((SELECT id FROM programs WHERE slug = 'architectural-thinking'), 'Module 2: Design Principles', 'design-principles', 'Core principles for building anything that matters \u2014 form, function, and strength.', 2),
        ((SELECT id FROM programs WHERE slug = 'architectural-thinking'), 'Module 3: Strategic Frameworks', 'strategic-frameworks', 'Mental models and frameworks for strategic planning and decision-making.', 3),
        ((SELECT id FROM programs WHERE slug = 'architectural-thinking'), 'Module 4: Execution & Systems', 'execution-systems', 'From blueprint to reality \u2014 closing the gap between vision and execution.', 4),
        ((SELECT id FROM programs WHERE slug = 'revelation-study'), 'Module 1: The Unveiling', 'revelation-unveiling', 'Vision of the Risen Christ and the Letters to the Seven Churches (Revelation 1-3) \u2014 Divine Love speaks to His people.', 1),
        ((SELECT id FROM programs WHERE slug = 'revelation-study'), 'Module 2: The Throne of God', 'revelation-throne', 'Worship, Judgment, and Redemption (Revelation 4-7) \u2014 Divine Creativity in the heavenly courtroom.', 2),
        ((SELECT id FROM programs WHERE slug = 'revelation-study'), 'Module 3: The Seven Trumpets', 'revelation-trumpets', 'Wisdom in Warning and Mercy (Revelation 8-11) \u2014 Divine Wisdom calls the world to repentance.', 3),
        ((SELECT id FROM programs WHERE slug = 'revelation-study'), 'Module 4: The Dragon and the Lamb', 'revelation-dragon-lamb', 'Divine Love Overcoming Evil (Revelation 12-16) \u2014 The cosmic conflict and the Lamb''s victory.', 4),
        ((SELECT id FROM programs WHERE slug = 'revelation-study'), 'Module 5: The Fall of Babylon', 'revelation-babylon', 'Systems of the World vs. the Kingdom of God (Revelation 17-19) \u2014 Systems Thinking lens on worldly systems.', 5),
        ((SELECT id FROM programs WHERE slug = 'revelation-study'), 'Module 6: The New Creation', 'revelation-new-creation', 'Divine Sovereignty''s Final Triumph (Revelation 20-22) \u2014 The new heaven and new earth, the dwelling of God with man.', 6),
        ((SELECT id FROM programs WHERE slug = 'psalms-worship-word'), 'Module 1: Wisdom and the Word \u2014 The Torah Psalms', 'psalms-wisdom-word', 'Blessed is the one who delights in the law of the Lord (Psalm 1:1-2). Divine Wisdom structures the life of faith around God''s Word \u2014 from the opening beatitude of Psalm 1 through the acrostic masterpiece of Psalm 119. Pattern Recognition lens on the architecture of wisdom in the Psalter.', 1),
        ((SELECT id FROM programs WHERE slug = 'psalms-worship-word'), 'Module 2: The Shepherd King \u2014 Divine Love in Trust and Refuge', 'psalms-shepherd-king', '"The Lord is my Shepherd, I shall not want" (Psalm 23:1). Divine Love is the foundation of the believer''s security. The Shepherd-King imagery reveals God''s intimate care, provision, and protection. Design Thinking lens on how God designs provision and refuge for His flock.', 2),
        ((SELECT id FROM programs WHERE slug = 'psalms-worship-word'), 'Module 3: The Heavens Declare \u2014 Divine Creativity in Creation', 'psalms-heavens-declare', '"The heavens declare the glory of God" (Psalm 19:1). Divine Creativity is woven into the fabric of creation. The Psalmist sees the artistic fingerprint of God in the cosmos. Creative Thinking lens on how creation inspires human creativity and wonder.', 3),
        ((SELECT id FROM programs WHERE slug = 'psalms-worship-word'), 'Module 4: Cries from the Deep \u2014 Divine Wisdom in Lament and Hope', 'psalms-lament-hope', '"My God, my God, why have You forsaken me?" (Psalm 22:1). Lament is not a lack of faith but a pathway through suffering toward trust. Divine Wisdom teaches us to bring our pain to God. Systems Thinking lens on the lament-to-praise pattern as a faith feedback loop.', 4),
        ((SELECT id FROM programs WHERE slug = 'psalms-worship-word'), 'Module 5: Pilgrim Songs \u2014 Divine Love on the Journey of Faith', 'psalms-pilgrim-songs', 'The fifteen Songs of Ascents (Psalm 120-134) trace a journey from distress to blessing, from isolation to community. Divine Love calls a people together in worship. Pattern Recognition lens on pilgrimage as a spiritual template for growth.', 5),
        ((SELECT id FROM programs WHERE slug = 'psalms-worship-word'), 'Module 6: The Final Hallelujah \u2014 Divine Creativity in Praise', 'psalms-final-hallelujah', '"Let everything that has breath praise the Lord! Hallelujah!" (Psalm 150:6). The Psalter culminates in a symphony of praise \u2014 every instrument, every creature, every breath joining the song. Divine Creativity finds its ultimate expression in the new song of redemption. Design Thinking lens on praise as the purpose of all creation.', 6),
        ((SELECT id FROM programs WHERE slug = 'civic-intelligence'), 'Module 1: The Citizen &amp; the Constitution', 'civic-constitution', 'Ghana''s 1992 Constitution establishes the foundation for all civic life. This module covers the three branches of government, the 261 MMDAs, citizen rights and responsibilities, and how the Constitution shapes Ghana''s democracy.', 1),
        ((SELECT id FROM programs WHERE slug = 'civic-intelligence'), 'Module 2: Civic Technology &amp; Digital Accountability', 'civic-tech-accountability', 'How civic tech platforms work \u2014 manifesto meters for tracking election promises, geotagged service delivery dashboards, and anonymous whistleblower tools. Based on the Accra CivicHub blueprint and Ghana''s Digital Public Infrastructure.', 2),
        ((SELECT id FROM programs WHERE slug = 'civic-intelligence'), 'Module 3: Data Sovereignty &amp; AI for Public Good', 'civic-data-ai', 'The Data Protection Act (Act 843), ethical AI aligned with the Ghana AI Strategy, localized datasets in Ghanaian languages (Twi, Ewe, Dagbani), and how citizens can participate in data governance.', 3),
        ((SELECT id FROM programs WHERE slug = 'civic-intelligence'), 'Module 4: Participatory Governance &amp; Community Organizing', 'civic-participatory', 'How district assemblies work, participatory budgeting, running Civic Education Clubs, and partnering with CSOs like CDD-Ghana, IMANI Africa, and the Ghana Integrity Initiative.', 4),
        ((SELECT id FROM programs WHERE slug = 'civic-intelligence'), 'Module 5: National Development Planning Literacy', 'civic-development-planning', 'Understanding Vision 2057, the Ghana Infrastructure Plan, the National Youth Policy, and how citizens can read, contribute to, and influence medium-term development plans at the district and national levels.', 5),
        ((SELECT id FROM programs WHERE slug = 'civic-intelligence'), 'Module 6: Capstone \u2014 Civic Action Project', 'civic-capstone', 'Design and execute a real civic project in your community \u2014 a manifesto meter pilot, a community infrastructure audit, a Civic Education Club launch, or a participatory budgeting workshop. Output: a completed project plan with stakeholder map, timeline, and impact metrics.', 6),
        ((SELECT id FROM programs WHERE slug = 'ai-fundamentals'), 'Module 1: What Is AI and Why Does It Matter for Ghana?', 'ai-what', 'Definitions of AI, a brief history, and the Ghana AI Strategy vision of an AI-powered society by 2035. Overview of key AI technologies: machine learning, natural language processing, computer vision.', 1),
        ((SELECT id FROM programs WHERE slug = 'ai-fundamentals'), 'Module 2: AI for Ghanaian Agriculture &amp; Environment', 'ai-agriculture', 'AI applications for crop disease detection, weather prediction, soil monitoring, and supply chain optimization. Case studies from Ghanaian agritech startups and research institutions.', 2),
        ((SELECT id FROM programs WHERE slug = 'ai-fundamentals'), 'Module 3: AI for Health, Education &amp; Governance', 'ai-health-edu', 'AI diagnostics for healthcare, personalized learning tools for education, and predictive analytics for public service delivery. Real Ghanaian use cases and pilot projects.', 3),
        ((SELECT id FROM programs WHERE slug = 'ai-fundamentals'), 'Module 4: Ghanaian Language AI &amp; Localized Datasets', 'ai-language', 'Natural language processing for Twi, Ewe, Dagbani, and other Ghanaian languages. Tools like Khaya and Mozilla Common Voice. Why localized datasets matter for sovereignty and accuracy.', 4),
        ((SELECT id FROM programs WHERE slug = 'ai-fundamentals'), 'Module 5: AI Ethics, the Responsible AI Authority &amp; the Data Protection Act', 'ai-ethics', 'Algorithmic bias, data privacy, and the UNESCO AI Ethics recommendations. Ghana''s Responsible AI Authority and the Data Protection Act (Act 843). Building AI that serves all Ghanaians.', 5),
        ((SELECT id FROM programs WHERE slug = 'ai-fundamentals'), 'Module 6: Capstone \u2014 AI Opportunity Map', 'ai-capstone', 'Identify a problem in your community or sector and design an AI-powered solution concept. Output: problem statement, data requirements, ethical considerations, and stakeholder map.', 6),
        ((SELECT id FROM programs WHERE slug = 'essential-values'), 'Module 1: Responsible Citizenship', 'values-citizenship', 'What it means to be a citizen of Ghana \u2014 rights, responsibilities, and the common good. Adinkra symbol: the conjoined crocodiles (unity in diversity). Based on Session 1-2 of the Essential Values Handbook.', 1),
        ((SELECT id FROM programs WHERE slug = 'essential-values'), 'Module 2: Honesty &amp; Combating Misinformation', 'values-honesty', 'Truthfulness in public and private life. How misinformation spreads and how to verify information. Adinkra symbol: the measuring rod (abhorrence of imperfection). Based on Sessions 3-4 of the Essential Values Handbook.', 2),
        ((SELECT id FROM programs WHERE slug = 'essential-values'), 'Module 3: Integrity in Public &amp; Private Life', 'values-integrity', 'Integrity as consistency between word and action. Case studies from Ghanaian public life. Adinkra symbol: the ram''s horns (strength and confidence). Based on Sessions 5-6 of the Essential Values Handbook.', 3),
        ((SELECT id FROM programs WHERE slug = 'essential-values'), 'Module 4: Diversity &amp; Equity as National Strength', 'values-diversity', 'Ghana''s ethnic, linguistic, and religious diversity as a source of strength. Understanding equity vs. equality. Adinkra symbol: the palm tree (wealth and self-sufficiency). Based on Sessions 7-10 of the Essential Values Handbook.', 4),
        ((SELECT id FROM programs WHERE slug = 'essential-values'), 'Module 5: Discipline &amp; Self-Directed Learning', 'values-discipline', 'Discipline as the foundation of excellence. Self-directed learning for lifelong growth. Adinkra symbol: the good farmer (diligence and hard work). Based on Sessions 11-13 of the Essential Values Handbook.', 5),
        ((SELECT id FROM programs WHERE slug = 'essential-values'), 'Module 6: Capstone \u2014 Values in Action Project', 'values-capstone', 'Design a community values workshop, a school Civic Education Club session, or a public awareness campaign based on one of the essential values. Output: session plan with objectives, activities, and discussion guide.', 6),
        ((SELECT id FROM programs WHERE slug = 'digital-entrepreneurship'), 'Module 1: Ghana''s Digital Economy Landscape', 'de-landscape', 'The state of Ghana''s digital economy: mobile money, tech hubs, creative industries, and the growing startup ecosystem. Market opportunities and where to find them.', 1),
        ((SELECT id FROM programs WHERE slug = 'digital-entrepreneurship'), 'Module 2: Identifying Problems &amp; Validating Ideas', 'de-ideas', 'How to find problems worth solving, conduct customer interviews, and validate demand before building. Tools for market research in the Ghanaian context.', 2),
        ((SELECT id FROM programs WHERE slug = 'digital-entrepreneurship'), 'Module 3: Building a Minimum Viable Product', 'de-mvp', 'No-code and low-code tools for building a first product. Leveraging mobile money APIs, USSD, and WhatsApp for distribution. Case studies of Ghanaian startups that started small.', 3),
        ((SELECT id FROM programs WHERE slug = 'digital-entrepreneurship'), 'Module 4: Digital Marketing for Ghanaian Audiences', 'de-marketing', 'Social media marketing, influencer partnerships, SMS and WhatsApp campaigns, and community-driven growth. How to reach both urban and rural audiences cost-effectively.', 4),
        ((SELECT id FROM programs WHERE slug = 'digital-entrepreneurship'), 'Module 5: The Creative Economy \u2014 Music, Content &amp; Cultural Products', 'de-creative', 'Building a career in Ghana''s creative economy: digital music distribution, content creation, monetization strategies, and protecting intellectual property. Aligned with the National Youth Policy creative economy goals.', 5),
        ((SELECT id FROM programs WHERE slug = 'digital-entrepreneurship'), 'Module 6: Capstone \u2014 Business Model Canvas &amp; Pitch', 'de-capstone', 'Complete a business model canvas for your digital or creative venture. Output: a one-page business plan with customer segments, value proposition, revenue streams, and a 60-second pitch.', 6),
        ((SELECT id FROM programs WHERE slug = 'youth-leadership'), 'Module 1: The National Youth Policy &amp; Your Role', 'yl-policy', 'Ghana''s National Youth Policy vision: "An empowered youth contributing positively to national development." Understanding youth demographics, challenges, and opportunities in Ghana.', 1),
        ((SELECT id FROM programs WHERE slug = 'youth-leadership'), 'Module 2: Starting &amp; Running a Civic Education Club', 'yl-civic-club', 'How to start a Civic Education Club at your school, church, or community center. Recruiting members, planning activities, and sustaining engagement. Based on the NCCE Civic Education Club model.', 2),
        ((SELECT id FROM programs WHERE slug = 'youth-leadership'), 'Module 3: Community Project Design &amp; Execution', 'yl-community-project', 'How to design a community development project: needs assessment, stakeholder mapping, resource planning, timeline, and impact measurement. Case studies from Ghanaian youth-led projects.', 3),
        ((SELECT id FROM programs WHERE slug = 'youth-leadership'), 'Module 4: Engaging with District Assemblies &amp; Advocating for Change', 'yl-advocacy', 'How district assemblies (MMDAs) work, how to submit proposals, how to participate in budget hearings, and how to advocate for policy change. Aligned with the Local Governance Act.', 4),
        ((SELECT id FROM programs WHERE slug = 'youth-leadership'), 'Module 5: Coalition Building &amp; CSO Partnerships', 'yl-coalitions', 'How to partner with civil society organizations like CDD-Ghana, IMANI Africa, and the Ghana Integrity Initiative. Building coalitions for greater impact. Media engagement and public communication.', 5),
        ((SELECT id FROM programs WHERE slug = 'youth-leadership'), 'Module 6: Capstone \u2014 Community Organizing Project', 'yl-capstone', 'Plan and launch a real community organizing initiative. Output: project charter with stakeholder map, activity plan, budget, communication strategy, and success metrics.', 6),
        ((SELECT id FROM programs WHERE slug = 'sketching-vision-builders'), 'Module 1: The Visionary''s Sketchbook', 'svb-sketchbook', 'Drawing as a tool for thinking, seeing, and planning. Why every visionary needs a sketchbook. Materials, mindset, and the daily practice of visual thinking.', 1),
        ((SELECT id FROM programs WHERE slug = 'sketching-vision-builders'), 'Module 2: Seeing Like an Artist', 'svb-seeing', 'Learning to really see \u2014 observation, negative space, gesture drawing, and contour drawing. The discipline of looking before drawing.', 2),
        ((SELECT id FROM programs WHERE slug = 'sketching-vision-builders'), 'Module 3: Line, Shape &amp; Form', 'svb-line-shape', 'Building blocks of drawing: line quality, geometric shapes, basic perspective, and shading. Translating 3D vision onto 2D paper.', 3),
        ((SELECT id FROM programs WHERE slug = 'sketching-vision-builders'), 'Module 4: Composition &amp; Visual Storytelling', 'svb-composition', 'Arranging elements to communicate ideas clearly. Composition principles, thumbnail sketches, and storyboarding for projects and presentations.', 4),
        ((SELECT id FROM programs WHERE slug = 'sketching-vision-builders'), 'Module 5: Drawing from Imagination', 'svb-imagination', 'Visualizing what does not yet exist. Drawing from memory, constructing scenes from imagination, and using reference effectively.', 5),
         ((SELECT id FROM programs WHERE slug = 'sketching-vision-builders'), 'Module 6: Capstone \u2014 Vision Board Project', 'svb-capstone', 'Create a visual vision board for a real project, idea, or dream. Combine all skills learned into a polished presentation drawing that communicates your vision to others.', 6),
         ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 1: What Is Pattern Recognition?', 'pr-intro', 'What patterns are, how the brain detects them, and why they matter for decision-making. Introduction to pattern types: cycles, sequences, symmetries, fractals, and networks.', 1),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 2: Patterns in Nature', 'pr-nature', 'The Fibonacci sequence, golden ratio, spirals, branching, and hexagonal patterns in God''s creation. How nature reveals mathematical and geometric order.', 2),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 3: Patterns in Data &amp; Markets', 'pr-data-markets', 'Trends, cycles, seasonality, and anomalies in data. How to read market patterns, identify opportunities, and avoid common pattern-falling traps like confirmation bias.', 3),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 4: Patterns in Scripture', 'pr-scripture', 'Typology, prophecy-fulfillment patterns, covenant structures, and the chiastic literary structures of the Bible. Seeing how God weaves patterns through redemptive history.', 4),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 5: Pattern-Based Decision Making', 'pr-decisions', 'Using pattern recognition in leadership, strategy, and problem-solving. How to distinguish meaningful patterns from noise, and how to apply pattern intelligence to real-world challenges.', 5),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 6: Capstone \u2014 Pattern Mapping Project', 'pr-capstone', 'Identify a pattern in your community, industry, or personal life. Map it, analyze it, and present your findings. Output: a pattern map with observations, analysis, and recommended actions.', 6)
      `,
    // Update existing programs with Bible-centered content
    `UPDATE programs SET title = 'The Spirit of God in Genesis: Creativity, Wisdom & Love', price = 250, tagline = 'A Bible-Centered Journey Through Genesis 1\u201350', sample_content = '<h2>Welcome to The Spirit of God in Genesis: Creativity, Wisdom &amp; Love</h2><p>Genesis is not simply a book of beginnings \u2014 it is the revelation of God''s nature as Creator, Wisdom, and Love. The Spirit of God hovers over the waters (Genesis 1:2), and from that hovering comes all of creation, all of history, and all of redemption.</p><p>This program explores Genesis 1\u201350 through <strong>three primary lenses</strong> drawn directly from Scripture: <strong>Divine Creativity</strong> (the Spirit''s creative power), <strong>Divine Wisdom</strong> (God''s ordering of all things), and <strong>Divine Love</strong> (God''s covenant faithfulness). Each module pairs these primary lenses with secondary thinking frameworks \u2014 Creative Thinking, Systems Thinking, Design Thinking, and Pattern Recognition \u2014 to help you see Genesis with fresh eyes.</p><h3>The Six Modules</h3><ol><li><strong>The Spirit Hovering</strong> \u2014 Divine Creativity in Creation (Genesis 1\u20132)</li><li><strong>The God Who Restores</strong> \u2014 Wisdom in the Fall &amp; Flood (Genesis 3\u20139)</li><li><strong>Noah to Babel</strong> \u2014 Divine Love Preserving and Scattering (Genesis 6\u201311)</li><li><strong>Abraham</strong> \u2014 The Covenant as a Divine Design System (Genesis 12\u201325)</li><li><strong>Isaac &amp; Jacob</strong> \u2014 Patterns of Grace, Struggle &amp; Transformation (Genesis 25\u201336)</li><li><strong>Joseph</strong> \u2014 Divine Sovereignty as the Ultimate System (Genesis 37\u201350)</li></ol><p>Theological Foundation: As Paul writes, <em>&ldquo;The Spirit searches all things, even the deep things of God&rdquo;</em> (1 Corinthians 2:10). The same Spirit who hovered over creation (Genesis 1:2) now dwells in believers, revealing the depths of God''s wisdom and love. Every module in this program is anchored in Scripture first \u2014 the lens emerges from the text, not the other way around.</p>', full_content = '<h2>Full Curriculum: The Spirit of God in Genesis: Creativity, Wisdom &amp; Love</h2><p>Why does Genesis reveal creativity, wisdom, and love? Because God Himself is the source of all three. The Spirit of God who hovered over creation (Genesis 1:2) is the same Spirit who imparts wisdom (Isaiah 11:2) and pours out God''s love (Romans 5:5). This program explores the entire book of Genesis \u2014 all 50 chapters \u2014 through six modules, each anchored in a specific passage of Scripture.</p><p>Before you begin, understand the framework: <strong>Scripture comes first.</strong> Every module opens with the biblical text, draws its primary lens (Divine Creativity, Wisdom, or Love) from the passage, and then connects it to secondary thinking frameworks. The goal is not to force Genesis into modern categories but to let the text reveal the categories God built into His Word.</p><p>As the Apostle Paul writes: <em>&ldquo;All Scripture is God-breathed and is useful for teaching, rebuking, correcting and training in righteousness&rdquo;</em> (2 Timothy 3:16). Let the Spirit who inspired this book be your teacher.</p><hr><h2>Module 1: The Spirit Hovering \u2014 Divine Creativity in Creation</h2><h3>Read Genesis 1:1\u20132:3</h3><p><strong>Key Idea: The Spirit''s Creative Process as the Template for All Creativity</strong></p><p>The first mention of the Spirit in Scripture is profoundly significant. In Genesis 1:2, the Spirit of God is <em>hovering</em> over the waters. The Hebrew word <em>rachaph</em> suggests a bird brooding over its nest \u2014 a picture of incubation, care, and creative anticipation. Before God speaks, the Spirit hovers. Creativity begins with the Spirit.</p><p><strong>Primary Lens: Divine Creativity</strong></p><p>The six days of creation reveal a process: separation (light from darkness, waters from waters), formation (sky, land, vegetation), and filling (sun, moon, creatures, humanity). This is not random \u2014 it is the Spirit''s ordered creativity. Each day prepares the environment for what follows. God calls each stage <em>&ldquo;good&rdquo;</em> and the whole <em>&ldquo;very good&rdquo;</em> (Genesis 1:31).</p><p><strong>Secondary Lenses: Creative Thinking, Design Thinking, Pattern Recognition</strong></p><ul><li><strong>Creative Thinking</strong> \u2014 God creates something from nothing (<em>creatio ex nihilo</em>). Human creativity is a reflection of this divine act. As image-bearers (Genesis 1:26), we are created to create.</li><li><strong>Design Thinking</strong> \u2014 The creation week follows a design cycle: empathize (God knows what creation needs), define (separate and name), ideate (speak into being), prototype (six days of formation), test (<em>&ldquo;God saw that it was good&rdquo;</em>). God is the original designer.</li><li><strong>Pattern Recognition</strong> \u2014 The three-part pattern (separation, formation, filling) recurs throughout Scripture \u2014 in the Tabernacle, in Israel''s journey, in Christ''s work. Recognizing this pattern helps us understand God''s consistent methods.</li></ul><h3>What Scripture Teaches About Creativity</h3><p><em>&ldquo;In the beginning, God created the heavens and the earth&rdquo;</em> (Genesis 1:1). Creativity is not a human invention \u2014 it is the first attribute of God revealed in Scripture. Every creative act we undertake echoes the original creative act of the Spirit. As David writes, <em>&ldquo;You created my inmost being; You knit me together in my mother''s womb&rdquo;</em> (Psalm 139:13). The same Spirit who hovered over creation is at work in every creative process.</p><h3>Application Exercise</h3><p>Read Genesis 1:1 again. Identify the three-part pattern (separation, formation, filling) in one area of your life \u2014 a project, a relationship, or a creative work. How does understanding the Spirit''s creative process change how you approach your work?</p><hr><h2>Module 2: The God Who Restores \u2014 Wisdom in the Fall &amp; Flood</h2><h3>Read Genesis 3:1\u201324; 4:1\u201316; 6:5\u20139:17</h3><p><strong>Key Idea: Divine Wisdom in Judgment and Redemption</strong></p><p>The fall of humanity (Genesis 3) is not just a tragedy \u2014 it is a revelation of God''s wisdom. When Adam and Eve disobey, God does not abandon His creation. He responds with both judgment and a promise: the Seed who will crush the serpent''s head (Genesis 3:15). This is the first gospel \u2014 and it reveals the wisdom of God in redeeming what was broken.</p><p><strong>Primary Lens: Divine Wisdom</strong></p><p>God''s wisdom is displayed in how He addresses the systemic breakdown of creation. The fall introduces corruption, violence, and separation. The flood (Genesis 6) is not divine anger out of control \u2014 it is a systemic reset. Noah''s ark is a designed system of preservation: specific dimensions (Genesis 6:14\u201316), layered protection (pitch inside and out), and a timed release. God''s wisdom saves a remnant.</p><p><strong>Secondary Lenses: Systems Thinking, Pattern Recognition</strong></p><ul><li><strong>Systems Thinking</strong> \u2014 The fall reveals reinforcing feedback loops. Cain''s sin leads to murder (Genesis 4:8), which leads to exile (Genesis 4:12\u201314). Lamech escalates the violence (Genesis 4:23\u201324). The earth becomes filled with violence (Genesis 6:11). God intervenes with a balancing feedback loop \u2014 the flood resets the system.</li><li><strong>Pattern Recognition</strong> \u2014 The pattern of sin, judgment, mercy, covenant repeats throughout Scripture. After the flood, God makes a covenant with Noah (Genesis 9:8\u201317) and sets the rainbow as a sign. This is God''s pattern: He judges, but He always preserves a remnant.</li></ul><h3>What Scripture Teaches About Wisdom</h3><p><em>&ldquo;The fear of the Lord is the beginning of wisdom&rdquo;</em> (Proverbs 9:10). Wisdom is not merely knowledge \u2014 it is the ability to discern God''s order and act accordingly. In the fall and flood, we see divine wisdom at work: judgment is not destruction for its own sake but purification for the sake of redemption. As the writer of Hebrews says, <em>&ldquo;He who is coming will come and will not delay&rdquo;</em> (Hebrews 10:37). God''s timing in judgment and restoration is always wise.</p><h3>Application Exercise</h3><p>Read Genesis 6:5\u20138 and 8:20\u201322. God saw that the heart of man was <em>&ldquo;only evil all the time&rdquo;</em> (6:5), yet Noah found favor (6:8). After the flood, God promises never to curse the ground again (8:21). Identify a situation in your life that needs divine wisdom. Where is God calling you to trust His timing in judgment or restoration?</p><hr><h2>Module 3: Noah to Babel \u2014 Divine Love Preserving and Scattering</h2><h3>Read Genesis 6:8\u20139:17; 10:1\u201332; 11:1\u20139</h3><p><strong>Key Idea: God''s Love Preserves a Remnant and Scatters for Blessing</strong></p><p>While Module 2 examined the flood through the lens of wisdom, this module examines the same events through the lens of divine love. Noah did not earn God''s favor \u2014 <em>&ldquo;Noah found grace in the eyes of the Lord&rdquo;</em> (Genesis 6:8). The word <em>grace</em> (chen) means unmerited favor. Love is the foundation of salvation.</p><p><strong>Primary Lens: Divine Love</strong></p><p>God''s love is not passive \u2014 it acts to preserve. Noah''s ark is a vessel of love: God provides a way of escape. After the flood, God establishes a covenant with <em>&ldquo;every living creature&rdquo;</em> (Genesis 9:10) \u2014 not just humanity, but all of creation. This is love that embraces the whole cosmos. In the Table of Nations (Genesis 10), we see God''s love for all peoples \u2014 every family, language, and nation descends from Noah''s sons.</p><p>At Babel (Genesis 11:1), humanity gathers to make a name for themselves. God scatters them \u2014 not in anger alone, but in love. Left united in pride, humanity would have built a civilization apart from God. Scattering is mercy: it prevents total rebellion and drives humanity to fill the earth as God commanded (Genesis 9:1).</p><p><strong>Secondary Lenses: Systems Thinking, Creative Thinking</strong></p><ul><li><strong>Systems Thinking</strong> \u2014 Babel is a classic example of a system goal mismatch. Humanity''s goal (<em>&ldquo;make a name for ourselves&rdquo;</em> Genesis 11:4) conflicted with God''s goal (<em>&ldquo;fill the earth&rdquo;</em> Genesis 9:1). God intervened by introducing a balancing mechanism \u2014 language diversity \u2014 which redirected the system toward its intended purpose.</li><li><strong>Creative Thinking</strong> \u2014 Scattering creates diversity. Different languages, cultures, and perspectives emerge from Babel. At Pentecost (Acts 2), the Holy Spirit reverses Babel: language barriers become channels of communication for the gospel. God''s creativity turns division into blessing.</li></ul><h3>What Scripture Teaches About Love</h3><p><em>&ldquo;God is love&rdquo;</em> (1 John 4:8). Love is not merely an attribute of God \u2014 it is His essence. In the flood narrative, love preserves. In the Babel narrative, love redirects. Even judgment serves love''s ultimate purpose: restoration. As Paul writes, <em>&ldquo;Love bears all things, believes all things, hopes all things, endures all things&rdquo;</em> (1 Corinthians 13:7). God''s love endures even when humanity rebels.</p><h3>Application Exercise</h3><p>Read Genesis 11:1. The people wanted to build a tower to reach the heavens \u2014 human effort to reach God. God came down instead (Genesis 11:5). How does this pattern (human striving, God''s gracious intervention) appear in your own spiritual journey? Where is God calling you to stop building and trust His love?</p><hr><h2>Module 4: Abraham \u2014 The Covenant as a Divine Design System</h2><h3>Read Genesis 12:1\u20139; 15:1\u201321; 17:1\u201327; 22:1\u201319</h3><p><strong>Key Idea: God''s Covenant is a Designed System with Feedback Loops</strong></p><p>The call of Abraham marks a turning point in Genesis. God chooses one man to bless all nations (Genesis 12:3). This is not arbitrary \u2014 it is divine design. The covenant structure that God establishes with Abraham is a masterclass in design thinking: a clear purpose (<em>&ldquo;you will be a blessing&rdquo;</em>), defined boundaries (land, descendants, circumcision), and built-in feedback mechanisms (testing, renewal, intercession).</p><p><strong>Primary Lens: Divine Creativity &amp; Wisdom</strong></p><p>God''s covenant with Abraham is a creative act \u2014 He creates a people from nothing (Abraham and Sarah were childless). It is also a wise act \u2014 the covenant includes provisions for failure (Abraham''s lies, Hagar, Ishmael) and pathways for restoration. God''s wisdom designs a system that accommodates human frailty while advancing His purposes.</p><p><strong>Secondary Lenses: Design Thinking, Systems Thinking</strong></p><ul><li><strong>Design Thinking</strong> \u2014 The covenant follows a design cycle: <strong>Empathize</strong> (God knows Abraham''s situation \u2014 Genesis 12:1), <strong>Define</strong> (the promise \u2014 land, descendants, blessing), <strong>Ideate</strong> (the covenant ceremony in Genesis 15), <strong>Prototype</strong> (Abraham walks by faith, fails, and returns), <strong>Test</strong> (the binding of Isaac in Genesis 22). Each phase reveals God''s iterative design process.</li><li><strong>Systems Thinking</strong> \u2014 The covenant functions as a system: <strong>Inputs</strong> (faith, obedience), <strong>Process</strong> (covenant renewal, circumcision), <strong>Outputs</strong> (blessing, descendants), <strong>Feedback</strong> (testing, intercession). Abraham''s intercession for Sodom (Genesis 18:22\u201333) is a leverage point \u2014 one man''s prayer influences the fate of cities.</li></ul><h3>What Scripture Teaches About Covenant</h3><p><em>&ldquo;I will establish My covenant between Me and you&rdquo;</em> (Genesis 17:2). Covenant is God''s chosen relationship framework. It is not a contract (conditional) but a covenant (unconditional commitment). Paul explains: <em>&ldquo;The promises were spoken to Abraham and to his seed&rdquo;</em> (Galatians 3:16). Christ is the ultimate Seed through whom all nations are blessed.</p><h3>Application Exercise</h3><p>Read Genesis 15:1. Abraham believed the Lord, and it was credited to him as righteousness. What promise from God do you need to believe today? Map it as a design system: What is the purpose? What resources has God provided? What feedback loops (prayer, Scripture, community) help you stay on course?</p><hr><h2>Module 5: Isaac &amp; Jacob \u2014 Patterns of Grace, Struggle &amp; Transformation</h2><h3>Read Genesis 25:19\u201334; 27:1\u201345; 28:10\u201322; 32:22\u201332; 35:9\u201315</h3><p><strong>Key Idea: Family Systems Reveal God''s Redemptive Patterns</strong></p><p>The stories of Isaac and Jacob are messy. Deception, favoritism, rivalry, and fear fill these chapters. Yet God''s grace runs through every failure. Isaac and Jacob are not moral exemplars \u2014 they are recipients of grace. Their patterns of struggle and transformation mirror our own spiritual journeys.</p><p><strong>Primary Lens: Divine Love &amp; Wisdom</strong></p><p>God''s love is unconditional \u2014 He chooses Jacob over Esau before they are born (Genesis 25:23). Paul reflects on this: <em>&ldquo;Jacob I loved, but Esau I hated&rdquo;</em> (Romans 9:13). This is not arbitrary preference \u2014 it is divine sovereignty choosing to work through the younger to establish a pattern of grace. God''s wisdom is revealed in how He transforms Jacob from deceiver (Genesis 27) to Israel \u2014 one who strives with God and prevails (Genesis 32:28).</p><p><strong>Secondary Lenses: Pattern Recognition, Creative Thinking</strong></p><ul><li><strong>Pattern Recognition</strong> \u2014 Jacob''s life follows a cycle: blessing, loss, encounter, transformation, return. This pattern recurs throughout Scripture: Israel in Egypt, the prodigal son, Peter''s restoration. Recognizing this cycle helps us navigate our own seasons of struggle and renewal.</li><li><strong>Creative Thinking</strong> \u2014 Jacob uses creative strategies: bargaining with Esau (Genesis 25:29\u201334), breeding flocks in Laban''s service (Genesis 30:37\u201343). His creativity, while sometimes manipulative, is redeemed by God. At Peniel, Jacob''s creative striving transforms into surrendered dependence \u2014 he limps, but he is blessed.</li></ul><h3>What Scripture Teaches About Transformation</h3><p><em>&ldquo;Your name will no longer be Jacob, but Israel, because you have struggled with God and with humans and have overcome&rdquo;</em> (Genesis 32:28). Transformation comes through struggle. Jacob wrestled with God all night \u2014 and emerged changed. As Paul writes, <em>&ldquo;We all, with unveiled faces reflecting the glory of the Lord, are being transformed into the same image&rdquo;</em> (2 Corinthians 3:18). Transformation is God''s work, but we participate through the struggle.</p><h3>Application Exercise</h3><p>Read Genesis 32:22. Jacob wrestled with a Man until daybreak. What are you wrestling with God about right now? How might your struggle be the very place where God transforms you? Write down one area where you need to move from striving to surrender.</p><hr><h2>Module 6: Joseph \u2014 Divine Sovereignty as the Ultimate System</h2><h3>Read Genesis 37:1\u201336; 39:1\u201323; 41:1\u201357; 45:1\u201315; 50:15\u201321\u201321</h3><p><strong>Key Idea: God''s Sovereignty Orchestrates All Systems for Good</strong></p><p>The Joseph narrative is the climax of Genesis. From the pit to the palace, Joseph''s journey weaves together every theme of the book: creativity in dreams and interpretation, wisdom in governance, love in reconciliation. Joseph''s final declaration \u2014 <em>&ldquo;You intended to harm me, but God intended it for good&rdquo;</em> (Genesis 50:20) \u2014 is the ultimate statement of divine sovereignty over all systems.</p><p><strong>Primary Lens: All Three \u2014 Divine Creativity, Wisdom &amp; Love</strong></p><ul><li><strong>Divine Creativity</strong> \u2014 God gives Joseph dreams (Genesis 37:5\u201311) and the ability to interpret them (Genesis 41:16, 39). Dreams are a creative medium through which God reveals His plans. Joseph''s administrative system for storing grain (Genesis 41:46\u201349) is an act of creative governance.</li><li><strong>Divine Wisdom</strong> \u2014 Joseph''s rise from prisoner to prime minister displays extraordinary wisdom that even Pharaoh recognizes: <em>&ldquo;Can we find a man like this, in whom is the Spirit of God?&rdquo;</em> (Genesis 41:38). Joseph''s economic system \u2014 stocks, flows, buffer capacity \u2014 is a model of wise stewardship.</li><li><strong>Divine Love</strong> \u2014 Every step of Joseph''s journey is orchestrated for the preservation of his family. His tests of his brothers (Genesis 42\u201344 are not revenge \u2014 they are designed to produce genuine repentance and restoration. Joseph weeps repeatedly, revealing a heart transformed by love.</li></ul><p><strong>Secondary Lenses: Systems Thinking, Design Thinking, Pattern Recognition</strong></p><ul><li><strong>Systems Thinking</strong> \u2014 Joseph''s grain storage system is a classic stock-and-flow model. The seven years of abundance (inflow) build stock; the seven years of famine (outflow) draw it down. This is anticipatory governance \u2014 intervening at leverage points before the system tips into crisis.</li><li><strong>Design Thinking</strong> \u2014 Joseph''s approach to his brothers follows a design process: <strong>Empathize</strong> (he understands their guilt and fear), <strong>Define</strong> (the problem is unresolved sin in the family system), <strong>Ideate</strong> (he designs tests \u2014 the silver cup, Benjamin''s sack), <strong>Prototype</strong> (he tests Judah''s transformation), <strong>Test</strong> (Judah''s plea in Genesis 44:18\u201334 proves change has occurred).</li><li><strong>Pattern Recognition</strong> \u2014 Joseph''s dreams at age 17 (Genesis 37:5) are fulfilled 22 years later when his brothers bow before him (Genesis 42:6). God''s patterns operate on long timescales. Recognizing divine patterns requires patience and faith.</li></ul><h3>What Scripture Teaches About Sovereignty</h3><p><em>&ldquo;And we know that in all things God works for the good of those who love Him, who have been called according to His purpose&rdquo;</em> (Romans 8:28). Joseph''s life is the Old Testament embodiment of this truth. Every setback \u2014 the pit, slavery, prison \u2014 was a step in God''s design. As Joseph himself declares: <em>&ldquo;You intended to harm me, but God intended it for good&rdquo;</em> (Genesis 50:20). Sovereignty means that no system, no human intention, and no evil plan operates outside God''s control.</p><h3>Application Exercise</h3><p>Read Genesis 50:15. Joseph''s brothers feared retaliation, but Joseph saw God''s hand in their evil. Think of a painful situation in your life where you cannot yet see God''s purpose. How does Joseph''s example challenge you to trust that God is working all things for good? Map the system of your current challenge \u2014 what are the stocks, flows, and feedback loops? Where might God''s sovereignty be at work beneath the surface?</p><hr><p><strong>Congratulations on completing The Spirit of God in Genesis: Creativity, Wisdom &amp; Love.</strong> You have journeyed through all 50 chapters of Genesis through the lenses of the Spirit''s creativity, wisdom, and love. May the Spirit who hovered over the waters continue to guide your understanding as you grow in the knowledge of God. <em>&ldquo;For from Him and through Him and to Him are all things. To Him be glory forever. Amen&rdquo;</em> (Romans 11:36).</p>' WHERE slug = 'systems-thinking-genesis'`,
    `UPDATE programs SET title = 'Design Thinking for Vision Builders', tagline = 'Design the future \u2014 one human-centered solution at a time', description = 'Design thinking is a human-centered approach to innovation that draws wisdom from the ultimate Designer. This program teaches the five phases \u2014 Empathize, Define, Ideate, Prototype, and Test \u2014 grounded in biblical examples and applied to real-world challenges. You will learn to see problems as design opportunities and develop solutions that serve people and honor God.', status = 'active', sort_order = 2, sample_content = '<h2>Welcome to Design Thinking for Vision Builders</h2><p>Design thinking is a human-centered approach to innovation that draws its wisdom from the ultimate Designer \u2014 God Himself. From the intentional structure of creation to the iterative refinement of His covenant people, the pattern of design thinking is woven throughout Scripture.</p><p>This program teaches the five phases of design thinking \u2014 Empathize, Define, Ideate, Prototype, and Test \u2014 grounded in biblical examples and applied to real-world challenges. You will learn to see problems as design opportunities and develop solutions that serve people and honor God.</p><p>Start with Module 1 to understand the design mindset, then work through real exercises in empathy, ideation, prototyping, and iteration.</p>' WHERE slug = 'intro-design-thinking'`,
    `UPDATE programs SET tagline = 'The Original Design Blueprint \u2014 God as the First Designer', description = 'Discover how the Genesis creation account reveals the ultimate design thinking process. From the separation of light from darkness (Genesis 1:3-4) to the creation of humanity in God''s image (Genesis 1:26-28), every step follows divine design methodology. God empathized with His creation, defined purpose for each element, ideated through spoken word, prototyped through the six days, and saw that it was very good (Genesis 1:31). This program explores each design phase through Scripture, showing that human creativity is a reflection of our Creator.', sample_content = '<h2>Coming Soon: Design Thinking in Genesis</h2><p>This program is currently in development. We are exploring how the Genesis creation account reveals the original design thinking process \u2014 intentionality, iteration, form and function, and stewardship as design \u2014 all rooted in God''s character as the Creator.</p><p>In the meantime, explore <a href="/school/">The Spirit of God in Genesis</a> to start your learning journey.</p>' WHERE slug = 'design-thinking-genesis'`,
    `UPDATE programs SET tagline = 'Learning from the Creator Through Creation', description = 'Biomimicry is the practice of learning from nature''s patterns and strategies to solve human problems. But the Bible teaches that nature reveals the wisdom of God: <em>"Ask the beasts, and they will teach you"</em> (Job 12:7-10). Go to the ant, you sluggard; consider its ways and be wise (Proverbs 6:6). This program explores how God''s creation \u2014 from ants to eagles, from water cycles to honeycombs \u2014 contains design solutions that reflect the intelligence of the Creator. Every natural pattern is a lesson from God waiting to be discovered.', sample_content = '<h2>Coming Soon: Introduction to Biomimicry</h2><p>This program is currently in development. We are building a journey into biomimicry rooted in Scripture \u2014 learning from nature''s genius as a reflection of the Creator''s wisdom (Job 12:7-10, Proverbs 6:6).</p><p>In the meantime, explore <a href="/school/">The Spirit of God in Genesis</a> to start your learning journey.</p>' WHERE slug = 'intro-biomimicry'`,
    `UPDATE programs SET tagline = 'The Language of the Creator', description = 'God created the universe with measure, number, and weight (Wisdom of Solomon 11:20). Geometry is not a human invention \u2014 it is the language God used to order creation. From the circle of the earth (Isaiah 40:22) to the measurements of the tabernacle (Exodus 25-27) and the New Jerusalem (Revelation 21:15-17), Scripture is filled with geometric truth. This program takes you on a foundational journey through geometry \u2014 from the simplest dot to complex planes and forms \u2014 showing that every shape and pattern reflects the order of the Creator.', sample_content = '<h2>Coming Soon: Introduction to Geometry</h2><p>This program is currently in development. We are building a foundational journey through geometry \u2014 from the dot to planes and forms \u2014 rooted in the truth that God created all things with measure, number, and order (Isaiah 40:22, Revelation 21:15-17).</p><p>In the meantime, explore <a href="/school/">The Spirit of God in Genesis</a> to start your learning journey.</p>' WHERE slug = 'intro-geometry'`,
    `UPDATE programs SET tagline = 'The Logos and the Machine', description = 'In the beginning was the Word (Logos), and the Word was with God, and the Word was God (John 1:1). The Greek word Logos means not just word but reason, logic, and the rational principle that orders the universe. Computing \u2014 at its core \u2014 is the study of logic, information, and order. This program introduces the fundamentals of computing (hardware, software, binary logic, networks) while grounding every concept in the truth that all logic and information originate from God, who is the ultimate source of truth and order (Colossians 1:16-17).', sample_content = '<h2>Coming Soon: Introduction to Computing</h2><p>This program is currently in development. We are creating a clear, accessible introduction to how computers work \u2014 rooted in the truth that all logic and information originate from God, the Logos (John 1:1, Colossians 1:16-17).</p><p>In the meantime, explore <a href="/school/">The Spirit of God in Genesis</a> to start your learning journey.</p>' WHERE slug = 'intro-computing'`,
    `UPDATE programs SET tagline = 'The Art of Shaping Meaning \u2014 From Genesis to Revelation', description = 'God is the original storyteller. Scripture unfolds as a single grand narrative: Creation, Fall, Redemption, Restoration. Jesus Himself taught in parables (Matthew 13), using story to reveal deep truth. This program teaches narrative structure, character arcs, metaphor, and oral tradition \u2014 from the parables of Jesus to the epic arcs of Genesis and Revelation. You will learn to craft stories that inform, inspire, and transform, because storytelling is not just a skill \u2014 it is a reflection of the God who spoke the world into being and wrote history itself.', sample_content = '<h2>Coming Soon: Storytelling & Narrative Design</h2><p>This program is currently in development. We are crafting a deep exploration of narrative \u2014 from the parables of Jesus to the grand arc of Scripture \u2014 so you can learn to tell stories that inform, inspire, and transform.</p><p>In the meantime, explore <a href="/school/">The Spirit of God in Genesis</a> to start your learning journey.</p>' WHERE slug = 'intro-storytelling'`,
    // Update existing Architectural Thinking program with full content
    `UPDATE programs SET title = 'Architectural Thinking for Vision Builders', status = 'active', sort_order = 4, tagline = 'Build on the foundation of God&rsquo;s wisdom', sample_content = '<h2>Welcome to Architectural Thinking for Vision Builders</h2><p>Every great building starts with a blueprint. The same is true for your life, your projects, and your purpose. As the Apostle Paul writes, <em>&ldquo;According to the grace of God which was given to me, like a wise master builder I laid a foundation, and another is building on it. But each man must be careful how he builds on it. For no man can lay a foundation other than the one which is laid, which is Jesus Christ&rdquo;</em> (1&nbsp;Corinthians&nbsp;3:10-11).</p><p>This program takes you from blueprint thinking through design principles, strategic frameworks, and execution systems \u2014 so you can build anything that matters with clarity and confidence.</p><p>Start with Module 1 to learn blueprint thinking, then advance through design principles and strategic frameworks to execution systems.</p>', full_content = '<h2>Module 1: Blueprint Thinking</h2><p>Every great building starts with a blueprint. The same is true for your life, your projects, and your purpose. As the Apostle Paul writes, <em>&ldquo;According to the grace of God which was given to me, like a wise master builder I laid a foundation, and another is building on it. But each man must be careful how he builds on it. For no man can lay a foundation other than the one which is laid, which is Jesus Christ&rdquo;</em> (1&nbsp;Corinthians&nbsp;3:10-11).</p><p>Before you build anything &mdash; a business, a career, a family, a ministry &mdash; you must first see it clearly in your mind. This is blueprint thinking: the ability to envision the whole before you touch the parts.</p><h3>The Architectural Question</h3><p>God asked Job: <em>&ldquo;Where were you when I laid the foundation of the earth? Tell Me, if you have understanding&rdquo;</em> (Job&nbsp;38:4). Before every project, ask yourself: <em>What am I actually building?</em></p><ul><li>Define the purpose &mdash; Why does this exist?</li><li>Identify the foundation &mdash; What must be in place for this to stand?</li><li>Sketch the whole &mdash; What does the finished work look like?</li></ul><h3>Blueprint Exercise</h3><p><strong>Read Proverbs 24:3-4.</strong> Solomon tells us that by wisdom a house is built and by understanding it is established. Take one project or goal you are working on. Write a one-paragraph blueprint: What is its purpose? What is its foundation? What does success look like? Be specific. An architect would not build without a plan. Neither should you.</p>' WHERE slug = 'architectural-thinking'`,
    // Force all other programs to coming_soon (INSERT status appears to be ignored by D1)
    `UPDATE programs SET status = 'coming_soon' WHERE slug IN ('design-thinking-genesis','intro-biomimicry','intro-geometry','intro-computing','intro-storytelling') AND status = 'active'`,
    // Set Revelation to active with correct sort_order
    `UPDATE programs SET status = 'active', sort_order = 6 WHERE slug = 'revelation-study'`,
    // Set Psalms to active with correct sort_order
    `UPDATE programs SET status = 'active', sort_order = 7 WHERE slug = 'psalms-worship-word'`,
    // Fix sort_orders for displaced programs (Revelation/Psalms now at 4 & 5)
    `UPDATE programs SET sort_order = 2 WHERE slug = 'intro-design-thinking'`,
    `UPDATE programs SET sort_order = 8 WHERE slug = 'design-thinking-genesis'`,
    `UPDATE programs SET sort_order = 9 WHERE slug = 'intro-biomimicry'`,
    `UPDATE programs SET sort_order = 10 WHERE slug = 'intro-geometry'`,
    `UPDATE programs SET sort_order = 11 WHERE slug = 'intro-computing'`,
    `UPDATE programs SET sort_order = 12 WHERE slug = 'intro-storytelling'`,
    // Fix guitar-method title for existing installs (was seeded as 'Guitar in 30 Days')
    `UPDATE programs SET title = 'Guitar: First Things First \u2014 The Matthew 6:33 Method', tagline = 'Seek first the system \u2014 and the songs will be added.', description = 'The Matthew 6:33 Method by Gideon Abochie, architect and founder. 16 modules, 64 video lessons, real-time pitch detection, deliberate practice system. Start with Modules 1-3 free, register for the Bronze foundation (GH\xA2299), then Silver, Gold or Apprentice unlocks.', duration = 'Self-paced', price = 299, price_label = 'Free Modules 1-3 \xB7 Registration GH&cent; 299', sort_order = 0 WHERE slug = 'guitar-method'`,
    // Newsletter builder tables
    `CREATE TABLE IF NOT EXISTS newsletter_templates (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        subject TEXT NOT NULL DEFAULT '',
        blocks TEXT NOT NULL DEFAULT '[]',
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE TABLE IF NOT EXISTS newsletter_issues (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        issue_number INTEGER UNIQUE,
        subject TEXT NOT NULL DEFAULT '',
        theme TEXT NOT NULL DEFAULT '',
        html TEXT NOT NULL DEFAULT '',
        subscriber_count INTEGER DEFAULT 0,
        sent_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    addColumn("newsletter_issues", "status", "TEXT DEFAULT 'sent'"),
    addColumn("newsletter_issues", "sent_count", "INTEGER DEFAULT 0"),
    addColumn("newsletter_issues", "failed_count", "INTEGER DEFAULT 0"),
    // Legacy tables can have duplicate issue numbers; surface that as a
    // setup failure rather than silently creating a second live issue.
    `CREATE UNIQUE INDEX IF NOT EXISTS idx_newsletter_issues_number ON newsletter_issues(issue_number)`,
    // Batched broadcast outbox: enqueue fast, drain across cron ticks
    `CREATE TABLE IF NOT EXISTS newsletter_outbox (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        issue_id INTEGER NOT NULL,
        email TEXT NOT NULL,
        name TEXT DEFAULT '',
        edition TEXT DEFAULT 'GH',
        ref_code TEXT DEFAULT '',
        status TEXT NOT NULL DEFAULT 'pending',
        attempts INTEGER DEFAULT 0,
        last_error TEXT DEFAULT '',
        sent_at TEXT DEFAULT NULL,
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_newsletter_outbox_drain ON newsletter_outbox(status, id)`,
    `CREATE INDEX IF NOT EXISTS idx_newsletter_outbox_issue ON newsletter_outbox(issue_id)`,
    // Cached Brevo stats snapshots (avoid hammering the API per dashboard load)
    `CREATE TABLE IF NOT EXISTS brevo_stats_cache (
        cache_key TEXT PRIMARY KEY,
        payload TEXT NOT NULL DEFAULT '{}',
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    // Scheduled issues: AI-drafted Fridays, approved by human, sent Saturdays
    `CREATE TABLE IF NOT EXISTS newsletter_schedule (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        week_of TEXT NOT NULL,
        topic TEXT DEFAULT '',
        subject TEXT NOT NULL DEFAULT '',
        theme TEXT NOT NULL DEFAULT '',
        html TEXT NOT NULL DEFAULT '',
        status TEXT NOT NULL DEFAULT 'draft',
        created_by TEXT DEFAULT 'manual',
        approved_by TEXT DEFAULT '',
        approved_at TEXT DEFAULT NULL,
        issue_id INTEGER DEFAULT NULL,
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_newsletter_schedule_week ON newsletter_schedule(week_of, status)`,
    // Newsletter calendar table (replaces localStorage)
    `CREATE TABLE IF NOT EXISTS newsletter_calendar (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        year INTEGER NOT NULL,
        date_key TEXT NOT NULL,
        issue_number INTEGER DEFAULT 0,
        theme TEXT DEFAULT '',
        status TEXT DEFAULT 'planned',
        tags TEXT DEFAULT '[]',
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now')),
        UNIQUE(year, date_key)
      )`,
    // Survey responses table
    `CREATE TABLE IF NOT EXISTS survey_responses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        phone TEXT NOT NULL,
        topic TEXT DEFAULT '',
        learning_style TEXT DEFAULT '',
        time_commitment TEXT DEFAULT '',
        source TEXT DEFAULT 'web',
        source_url TEXT DEFAULT '',
        recommendation TEXT DEFAULT '',
        recommended_program TEXT DEFAULT '',
        opted_in INTEGER DEFAULT 1,
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_survey_created ON survey_responses(created_at)`,
    `CREATE INDEX IF NOT EXISTS idx_survey_topic ON survey_responses(topic)`,
    addColumn("survey_responses", "email", "TEXT DEFAULT ''"),
    addColumn("survey_responses", "interests", "TEXT DEFAULT '[]'"),
    addColumn("survey_responses", "other_text", "TEXT DEFAULT ''"),
    // Set Bible-based programs to coming_soon, focus on nation building
    `UPDATE programs SET status = 'coming_soon' WHERE slug IN ('systems-thinking-genesis','revelation-study','psalms-worship-word')`,
    // Activate Sketching &amp; Drawing for Vision Builders with full content
    `UPDATE programs SET status = 'active', full_content = '<h2>Module 1: The Visionary''s Sketchbook</h2><p>Every visionary needs a sketchbook. Leonardo da Vinci filled thousands of pages with sketches of flying machines, human anatomy, and architectural designs \u2014 ideas that would shape the future. Before the blueprint, before the budget, before the pitch \u2014 there is a sketch. This module establishes the foundational practice of visual thinking: keeping a sketchbook as a tool for seeing, thinking, and planning.</p><h3>Why Drawing Matters for Visionaries</h3><p>Drawing is not a talent you are born with \u2014 it is a skill you develop. And it is not about producing gallery-ready artwork. Drawing is a thinking tool. When you draw an idea, you are forced to make it concrete. Vague concepts become specific. Hidden assumptions become visible. Connections you did not see before emerge on the page.</p><p>The most effective leaders, engineers, designers, and entrepreneurs use drawing to:</p><ul><li>Clarify their own thinking before communicating to others</li><li>Communicate complex ideas quickly without relying on words alone</li><li>Capture observations and insights from the world around them</li><li>Generate new ideas by combining and recombining visual elements</li></ul><h3>Your Sketchbook Practice</h3><p>You need three things: a sketchbook (any size you can carry daily), a pen (ballpoint is fine \u2014 do not use pencil, it encourages erasing instead of committing), and 10 minutes a day. That is it. The single most important factor in learning to draw is consistency, not talent.</p><h3>Setting Up Your Practice</h3><ul><li>Keep your sketchbook and pen with you at all times. You never know when you will see something worth drawing.</li><li>Draw for at least 10 minutes every day. Miss a day and you lose momentum. Two days in a row and the habit breaks.</li><li>Date every page. This lets you track progress and see improvement over weeks and months.</li><li>Do not judge your drawings. The goal is not a beautiful page \u2014 the goal is a filled page. Quantity over quality at the beginning.</li><li>Draw what you see, not what you think you see. This is the most important lesson in all of drawing.</li></ul><h3>Exercise: Seven-Day Warm-Up</h3><p>For the next seven days, spend 10 minutes each day drawing from observation. Day 1: Your hand in any position. Day 2: A cup or mug from where you sit. Day 3: A plant or leaf. Day 4: A shoe. Day 5: A chair. Day 6: A view from your window (spend the full 10 minutes on one view). Day 7: A person sitting near you (they do not need to hold still \u2014 draw what you see, even if it is a blur). Do not erase. Do not start over. Fill the page.</p><hr><h2>Module 2: Seeing Like an Artist</h2><p>The single biggest mistake beginners make is drawing what they think they see rather than what they actually see. When you draw a face, you think "eyes are here, nose is here, mouth is here" \u2014 and you draw symbols, not observations. Learning to see like an artist means unlearning these mental shortcuts and training your eye to perceive the world as it actually is.</p><h3>Drawing on the Right Side of the Brain</h3><p>Research in neuroscience shows that drawing activates the right hemisphere of the brain \u2014 the mode that processes wholes, relationships, and spatial information rather than labels and symbols. When you switch from "drawing an eye" (a symbol) to "drawing the shape between the eye and the nose" (a relationship of spaces), you shift from left-brain labeling to right-brain seeing. This is the fundamental insight that transforms drawing ability.</p><h3>Five Seeing Exercises</h3><p><strong>1. Contour drawing.</strong> Choose an object with interesting edges \u2014 a leaf, a key, a crumpled piece of paper. Place your pen on the paper. Look at the object, not your paper. Slowly trace the edge of the object with your eyes while your pen moves simultaneously on the paper. Do not lift your pen. Do not look at your paper. The result will look strange \u2014 that is fine. What you are training is the connection between eye and hand.</p><p><strong>2. Blind contour.</strong> Same as above, but this time, never look at your paper at all. Cover it with another sheet if needed. Trust your hand to follow your eye. The drawings will look distorted, but the neural pathways you are building are worth more than a pretty picture.</p><p><strong>3. Negative space.</strong> Instead of drawing the object, draw the space around it. If you are drawing a chair, do not draw the chair \u2014 draw the shapes of empty space between the legs, between the rungs, between the seat and the back. This forces your brain to see shapes and relationships rather than symbols.</p><p><strong>4. Gesture drawing.</strong> Set a timer for 30 seconds. Draw a figure, animal, or object as quickly as possible capturing only the essential movement and energy. Do not worry about details. The goal is to capture the essence in as few lines as possible. Do 10 gesture drawings in a row.</p><p><strong>5. Upside-down drawing.</strong> Take a photograph or a simple line drawing and turn it upside down. Now draw it. Without recognizable symbols, your brain cannot label \u2014 it can only see lines, angles, and relationships. The result is almost always better than drawing the same image right-side up.</p><h3>Exercise: Daily Seeing Practice</h3><p>For one week, spend 10 minutes each day on one of the five seeing exercises above (rotate through them). At the end of the week, return to the same object you drew on Day 1 of Module 1. Compare the two drawings. You will see improvement \u2014 not because you got more talented, but because you learned to see.</p><hr><h2>Module 3: Line, Shape &amp; Form</h2><p>Every drawing, no matter how complex, is built from a small set of fundamental elements: lines, shapes, and forms. Master these building blocks, and you can draw anything. This module teaches you the visual vocabulary that underlies all drawing.</p><h3>Line Quality</h3><p>Not all lines are the same. The character of your line communicates as much as the shape it describes:</p><ul><li><strong>Thick lines</strong> suggest weight, shadow, and emphasis</li><li><strong>Thin lines</strong> suggest delicacy, distance, and detail</li><li><strong>Continuous lines</strong> suggest confidence and certainty</li><li><strong>Broken or sketchy lines</strong> suggest searching, tentative ideas</li><li><strong>Varying line weight</strong> (thick to thin within one line) suggests three-dimensional form and light</li></ul><p>Practice controlling your line quality. Draw a row of parallel lines, varying the pressure from light to heavy. Draw spirals that start thin and become thick. Draw a simple shape like a circle using a single continuous line with varying weight.</p><h3>Basic Shapes</h3><p>Everything you see can be broken down into combinations of basic shapes: circles, squares, triangles, and rectangles. A human body is a series of ovals and cylinders. A building is rectangles and triangles. A tree is a circle on a cylinder. When you approach a complex subject, first identify the basic shapes that make it up, sketch those lightly, and then refine.</p><h3>Perspective</h3><p>Perspective is the system that creates the illusion of depth on a flat surface. The fundamental rule: objects that are farther away appear smaller, and parallel lines appear to converge at a vanishing point on the horizon.</p><ul><li><strong>One-point perspective</strong> \u2014 All parallel lines converge to a single vanishing point. Used for drawing roads, hallways, and interiors looking straight ahead.</li><li><strong>Two-point perspective</strong> \u2014 Parallel lines converge to two vanishing points on the horizon. Used for drawing buildings, objects, and scenes viewed from an angle.</li><li><strong>Atmospheric perspective</strong> \u2014 Objects farther away appear lighter, less detailed, and bluer due to the atmosphere between them and the viewer. Used to create depth in landscapes and cityscapes.</li></ul><h3>Shading and Form</h3><p>Lines define edges; shading defines volume. To make a flat shape look like a three-dimensional form, you need to understand how light falls on surfaces:</p><ul><li><strong>Highlight</strong> \u2014 The brightest spot where light hits directly</li><li><strong>Mid-tone</strong> \u2014 The lit area between highlight and shadow</li><li><strong>Core shadow</strong> \u2014 The darkest area where light does not reach</li><li><strong>Reflected light</strong> \u2014 Light bouncing from surrounding surfaces into the shadow area</li><li><strong>Cast shadow</strong> \u2014 The shadow the object throws onto nearby surfaces</li></ul><p>Practice shading by drawing spheres, cylinders, and cubes with a single light source. Use hatching (parallel lines), cross-hatching (overlapping sets of parallel lines), or stippling (dots) to create tone.</p><h3>Exercise: Form Studies</h3><p>Find three simple household objects \u2014 an apple, a bottle, a book, a cup, a candle. Draw each one three times: first as a contour drawing (line only), then as a basic shape construction (circles, rectangles, cylinders), and finally as a fully shaded form drawing. Focus on the transition from flat line to three-dimensional form.</p><hr><h2>Module 4: Composition &amp; Visual Storytelling</h2><p>Drawing individual objects well is one skill; arranging them to communicate an idea is another. Composition \u2014 the deliberate arrangement of visual elements within a frame \u2014 is what transforms a collection of drawings into a communication tool. This module teaches you to compose drawings that tell stories, explain ideas, and persuade viewers.</p><h3>The Principles of Composition</h3><ul><li><strong>Focal point</strong> \u2014 Every composition needs a main subject or area of interest. Use contrast, placement, or detail to draw the viewer''s eye to the focal point. The center of the frame is the strongest position; the edges are the weakest.</li><li><strong>Rule of thirds</strong> \u2014 Divide your frame into nine equal parts with two horizontal and two vertical lines. Place key elements along these lines or at their intersections. This creates more dynamic and engaging compositions than centering everything.</li><li><strong>Leading lines</strong> \u2014 Use lines within your drawing (roads, edges, gaze direction, arms) to guide the viewer''s eye through the composition. Good compositions create a visual journey.</li><li><strong>Balance</strong> \u2014 Distribute visual weight across the frame. A large shape on one side can be balanced by several smaller shapes or a small area of high contrast on the other side. Symmetry creates stability; asymmetry creates tension and energy.</li><li><strong>Negative space</strong> \u2014 The empty space around and between subjects is as important as the subjects themselves. Use negative space deliberately to create breathing room and focus attention.</li></ul><h3>Thumbnail Sketching</h3><p>Before investing time in a detailed drawing, explore composition options with small, quick thumbnail sketches. A thumbnail is a small (2-5 cm) rough sketch that captures only the basic arrangement of shapes and values. Do 10-20 thumbnails before committing to a final composition. This is the same process architects use to explore building layouts and filmmakers use to storyboard scenes.</p><h3>Storyboarding for Visionaries</h3><p>A storyboard is a sequence of drawings that tells a story or explains a process over time. For a project pitch, a storyboard can show:</p><ul><li>Frame 1: The current problem or situation</li><li>Frame 2: The intervention or solution</li><li>Frame 3: The expected outcome or transformed situation</li><li>Frame 4: The long-term impact</li></ul><p>Each frame is a simple drawing with a short caption. Done well, a storyboard communicates in 30 seconds what a written document takes pages to explain.</p><h3>Exercise: Storyboard Your Project</h3><p>Think of a project, idea, or vision you want to communicate. Create a 4-frame storyboard:</p><ul><li>Draw four rectangles on one page (landscape orientation, equal size)</li><li>For each frame, draw a simple scene that advances the story</li><li>Below each frame, write a one-line caption</li><li>Show your storyboard to someone who does not know your project. Ask them to tell you what they think the story is. If they describe what you intended, your storyboard works. If not, revise.</li></ul><hr><h2>Module 5: Drawing from Imagination</h2><p>Drawing from observation teaches you to see and reproduce what exists. Drawing from imagination teaches you to visualize and construct what does not yet exist \u2014 and that is the essential skill of a visionary. This module bridges the gap between drawing what you see and drawing what you imagine.</p><h3>The Visual Library</h3><p>Drawing from imagination does not mean pulling images from nothing. It means drawing from your internal visual library \u2014 the collection of images, forms, and patterns you have stored in your memory through observation and practice. The richer your visual library, the more fluently you can draw from imagination. This is why the first four modules of this course focused on observation: every drawing you do from observation is a deposit into your visual library.</p><h3>Constructing from Memory</h3><p>To draw something from imagination, follow this process:</p><ol><li><strong>Recall</strong> \u2014 Close your eyes and try to visualize the subject. What are its basic shapes? What is its proportion? What are its distinctive features?</li><li><strong>Sketch</strong> \u2014 Draw the basic shapes and proportions lightly. Do not worry about details yet. Focus on getting the overall structure right.</li><li><strong>Check</strong> \u2014 Compare your sketch to your mental image. What is missing? What is distorted? Adjust before moving to details.</li><li><strong>Refine</strong> \u2014 Add details, shading, and texture. Build up the drawing from general to specific.</li><li><strong>Reference check</strong> \u2014 If possible, check your drawing against a reference image or real object. Note where your memory was accurate and where it was not. This feedback loop strengthens your visual library.</li></ol><h3>Drawing from Description</h3><p>A powerful exercise for visionaries: draw something you have never seen, based only on a verbal description. Ask a friend to describe a scene, object, or person you have never encountered. Draw it based on their words alone. This simulates the experience of bringing a vision into reality \u2014 starting from an idea in your mind (or someone else''s) and making it visible on paper.</p><h3>Combining and Transforming</h3><p>Creativity is recombination. To generate new visual ideas, combine elements from different sources in your visual library:</p><ul><li>Combine the form of one object with the texture of another</li><li>Place a familiar object in an unfamiliar context</li><li>Scale an object up or down dramatically</li><li>Merge two unrelated objects into one</li></ul><p>Architects use this process constantly: "What if this building had the roof form of a traditional Ashanti palace and the materiality of modern glass and steel?" The visionary draws what has never existed by recombining what has.</p><h3>Exercise: Design from Imagination</h3><p>Imagine a product, building, or space that does not exist but should. It could be a community center for your neighborhood, a mobile app interface, a piece of furniture, or a public monument. Draw it from imagination using the construction process above. Include at least three views: front view, side view, and an isometric or perspective view showing depth. Add labels to explain key features. This is the skill of the visionary: making the invisible visible.</p><hr><h2>Module 6: Capstone \u2014 Vision Board Project</h2><p>Your capstone is to create a visual Vision Board for a real project, idea, or dream that you want to bring into reality. This is not a collage of magazine clippings \u2014 it is an original hand-drawn presentation piece that communicates your vision to others with clarity, purpose, and visual impact. It brings together every skill you have developed in this course.</p><h3>What Makes a Great Vision Board</h3><p>A great vision board is not a collection of random images. It is a deliberately designed communication tool that:</p><ul><li><strong>Tells a story</strong> \u2014 Where are you now? Where do you want to be? How will you get there?</li><li><strong>Shows the whole and the parts</strong> \u2014 The big picture and the key details that make it real</li><li><strong>Involves the viewer</strong> \u2014 Draws them in, makes them curious, invites them to ask questions</li><li><strong>Is honest</strong> \u2014 Shows not only the ideal outcome but the steps, challenges, and resources needed</li></ul><h3>Choose Your Vision</h3><p>Select one of the following (or propose your own):</p><ul><li><strong>A community project</strong> \u2014 A community center, a school garden, a clean water initiative, a youth skills training space</li><li><strong>A business or product idea</strong> \u2014 A product you want to create, a service you want to launch, a venture you want to build</li><li><strong>A personal vision</strong> \u2014 A career path, a creative work, a life goal, a skill you want to master</li><li><strong>A space or place</strong> \u2014 A room, a building, a public space you want to design or transform</li></ul><h3>Deliverable Requirements</h3><p>Your Vision Board must include:</p><ol><li><strong>Central vision image</strong> \u2014 An original drawing (not traced, not copied) showing your vision in its completed form. Use perspective, shading, and composition skills from the course.</li><li><strong>Supporting sketches</strong> \u2014 At least three smaller drawings showing: the current situation or problem, a key detail or feature of your vision, and a step in the journey from current to future.</li><li><strong>Annotations</strong> \u2014 Hand-lettered labels, notes, and callouts that explain key elements. This is a presentation drawing \u2014 it should communicate without you needing to speak.</li><li><strong>Color (optional but encouraged)</strong> \u2014 Use any medium: colored pencils, markers, watercolor, or digital tools. Color adds emotional impact and helps differentiate elements.</li><li><strong>Layout</strong> \u2014 A single page (A3 or larger, or a digital canvas) with deliberate composition that guides the viewer through the information in a clear sequence.</li></ol><h3>Presentation</h3><p>Present your Vision Board to at least one other person. Ask them: What do you see? What questions do you have? Is my vision clear? Record their feedback and note what you would change based on it. Submit a photo or scan of your Vision Board along with a one-page reflection answering: What did you learn about your vision through the process of drawing it? What was the hardest element to draw? What became clearer for you as you drew? How will you use drawing as a tool going forward?</p><h3>Submission</h3><p>Submit your Vision Board (photo or scan) and reflection as a PDF or Google Doc. Upon review, you will receive a Certificate of Sketching &amp; Drawing for Vision Builders from Studio Gabochie.</p>' WHERE slug = 'sketching-vision-builders'`,
    // Activate Youth Leadership with full content
    `UPDATE programs SET status = 'active', full_content = '<h2>Module 1: The National Youth Policy &amp; Your Role</h2><p>Ghana has one of the youngest populations in the world. According to the National Youth Policy (NYP), approximately 57% of Ghana''s population is under 25 years old. This demographic dividend \u2014 the economic growth potential that arises when a country has a large working-age population \u2014 can only be realized if young people are equipped with leadership skills, civic knowledge, and opportunities to contribute. This module helps you understand where you fit in Ghana''s youth development agenda.</p><h3>The National Youth Policy</h3><p>Ghana''s National Youth Policy (NYP) defines youth as persons aged 15-35. Its vision is "an empowered youth contributing positively to national development." The policy has five strategic pillars:</p><ul><li><strong>Education and skills development</strong> \u2014 Ensuring all young people have access to quality education and market-relevant skills</li><li><strong>Employment and entrepreneurship</strong> \u2014 Creating decent work and self-employment opportunities for youth</li><li><strong>Health and well-being</strong> \u2014 Promoting physical, mental, and social health among young people</li><li><strong>Participation and leadership</strong> \u2014 Ensuring youth voices are heard in decision-making at all levels</li><li><strong>Social protection and inclusion</strong> \u2014 Protecting vulnerable youth and ensuring no one is left behind</li></ul><h3>Youth Demographics in Ghana</h3><p>Understanding the landscape is essential for effective organizing:</p><ul><li>Over 80% of Ghanaian youth have a mobile phone, making digital organizing viable</li><li>Youth unemployment rates are significantly higher than the national average, driving interest in entrepreneurship and skills training</li><li>Youth are underrepresented in political office \u2014 the average age of MPs in Ghana''s Parliament is over 50</li><li>Youth voter turnout has been declining, indicating a need for civic engagement interventions</li><li>Youth are the most active demographic on social media, creating opportunities for digital advocacy</li></ul><h3>Your Role as a Youth Leader</h3><p>You do not need a title to be a leader. Leadership is a choice \u2014 the choice to take responsibility for something you care about. As a youth leader in Ghana, your role is to:</p><ul><li><strong>Organize</strong> \u2014 Bring young people together around shared interests and concerns</li><li><strong>Educate</strong> \u2014 Help your peers understand their rights, responsibilities, and the systems that affect their lives</li><li><strong>Advocate</strong> \u2014 Speak up for issues that matter to young people in your community</li><li><strong>Build</strong> \u2014 Create structures (clubs, networks, projects) that outlast your individual effort</li></ul><h3>Exercise: Your Leadership Profile</h3><p>Write a one-page leadership profile answering these questions:</p><ul><li>What community or group do you belong to? (School, church, mosque, neighborhood, online community)</li><li>What are the three biggest challenges facing young people in that community?</li><li>What skills or resources do you already have to address these challenges?</li><li>What skills do you need to develop?</li><li>Who are three other young people in your community who share your concerns?</li></ul><hr><h2>Module 2: Starting &amp; Running a Civic Education Club</h2><p>Civic Education Clubs (CECs) are one of the most effective structures for building civic awareness and leadership skills among young people. Supported by the National Commission for Civic Education (NCCE) and CSOs like CDD-Ghana, CECs provide a regular space for young people to learn about governance, discuss current affairs, and plan community action. This module teaches you how to start and sustain one.</p><h3>What Is a Civic Education Club?</h3><p>A CEC is a voluntary group of young people who meet regularly to learn about civic rights and responsibilities, discuss national and local issues, and undertake community projects. CECs can be based in schools, universities, churches, mosques, or community centers. They are non-partisan \u2014 they focus on issues, not political parties.</p><h3>Step 1: Find Your Core Team</h3><p>Do not try to start a CEC alone. Find 3-5 young people who share your interest in civic engagement. Look for diversity \u2014 different backgrounds, genders, and perspectives strengthen the club. Meet with your core team to agree on the club''s purpose, values, and initial activities.</p><h3>Step 2: Define Your Structure</h3><p>Keep it simple. A basic CEC structure includes:</p><ul><li><strong>President/Coordinator</strong> \u2014 Leads meetings, represents the club externally, ensures activities align with the club''s mission</li><li><strong>Secretary</strong> \u2014 Takes minutes, manages communication, keeps records of membership and activities</li><li><strong>Activities Coordinator</strong> \u2014 Plans meetings, invites speakers, organizes community projects</li><li><strong>Communications Officer</strong> \u2014 Manages social media, creates posters, recruits new members</li></ul><h3>Step 3: Plan Your Activities</h3><p>A successful CEC meets regularly (weekly or bi-weekly) and alternates between three types of activities:</p><ul><li><strong>Learning sessions</strong> \u2014 A member or guest speaker presents on a civic topic (the Constitution, how the district assembly works, how to read a budget, fact-checking misinformation). Follow with discussion.</li><li><strong>Discussion forums</strong> \u2014 Pick a current event or national issue. Have structured debate or discussion. Encourage multiple perspectives. Practice respectful disagreement.</li><li><strong>Community action</strong> \u2014 Plan and execute a project: a clean-up campaign, a voter registration drive, a school infrastructure audit, a tree planting exercise.</li></ul><h3>Step 4: Recruit Members</h3><p>Use multiple channels to recruit:</p><ul><li><strong>Word of mouth</strong> \u2014 Ask each core team member to invite two friends</li><li><strong>Social media</strong> \u2014 Create a WhatsApp group and a simple flyer to share on social platforms</li><li><strong>Institutional support</strong> \u2014 If starting a school-based CEC, seek a teacher or administrator as a patron. If church-based, ask the pastor to announce the club during service.</li><li><strong>Public events</strong> \u2014 Host an open meeting with an interesting topic and invite the public</li></ul><h3>Step 5: Sustain Engagement</h3><p>The biggest challenge for CECs is sustaining engagement after the initial excitement. Tips:</p><ul><li>End each meeting with a clear "next step" that members can take before the next meeting</li><li>Rotate leadership roles every term so more members get experience</li><li>Celebrate small wins \u2014 a successful event, a new member, a media mention</li><li>Connect with other CECs nationally through the NCCE network for exchange visits and joint events</li></ul><h3>Exercise: Your CEC Launch Plan</h3><p>Write a one-page plan to start a Civic Education Club in your community:</p><ul><li>Where will the club be based?</li><li>Who are your 3-5 core team members?</li><li>What is your first meeting topic?</li><li>How will you recruit your first 10 members?</li><li>What is your meeting schedule for the first month?</li></ul><hr><h2>Module 3: Community Project Design &amp; Execution</h2><p>Community projects turn civic knowledge into visible impact. A well-designed project addresses a real need, involves the community in its design, and creates lasting change. This module teaches you the project design cycle and equips you to plan and execute your own community project.</p><h3>The Project Design Cycle</h3><ol><li><strong>Needs assessment</strong> \u2014 What does the community actually need? Do not assume. Conduct interviews, surveys, or community meetings to understand priorities.</li><li><strong>Stakeholder mapping</strong> \u2014 Who has power or interest in this issue? Who should be involved? Who might resist? Map all stakeholders and plan your engagement strategy.</li><li><strong>Project design</strong> \u2014 What will you do? Define your goal, activities, timeline, and resources needed. Be specific about what success looks like.</li><li><strong>Implementation</strong> \u2014 Execute your plan. Communicate regularly with stakeholders. Be flexible \u2014 adapt when things do not go as expected.</li><li><strong>Monitoring and evaluation</strong> \u2014 Track progress against your plan. Collect evidence of impact. Learn what works and what does not.</li><li><strong>Sustainability and exit</strong> \u2014 How will the project continue after your involvement ends? Plan for handover, documentation, and institutionalization from the beginning.</li></ol><h3>Needs Assessment Methods</h3><ul><li><strong>Community meeting</strong> \u2014 Invite community members to a meeting. Use a simple facilitation method: "What is working well? What is not working? What should we do about it?"</li><li><strong>Key informant interviews</strong> \u2014 Interview 5-10 people who know the community well: teachers, health workers, assembly members, religious leaders, traditional authorities.</li><li><strong>Transect walk</strong> \u2014 Walk through the community and observe. Note the condition of roads, water points, schools, health facilities, markets, and sanitation. Take photos.</li><li><strong>Survey</strong> \u2014 Design a simple survey (paper or Google Forms) and collect responses from at least 50 community members.</li></ul><h3>Case Study: Youth-Led Projects in Ghana</h3><ul><li><strong>Bisa Initiative</strong> \u2014 A group of university students in Accra who created a mobile app that connects youth to mental health resources. They started with a needs assessment that revealed stigma and lack of access were the main barriers, then designed a solution that prioritized anonymity and affordability.</li><li><strong>Tamale Youth Clean-Up</strong> \u2014 A group of young people in Tamale organized a monthly community clean-up campaign that grew from 15 participants to over 200 within six months. They partnered with the Tamale Metropolitan Assembly for waste collection support and secured sponsorship from a local business for gloves and bags.</li><li><strong>Kumasi Coding Club</strong> \u2014 A youth-led initiative that taught basic coding to 50 junior high school students in Kumasi. They partnered with a local tech hub for space and computers, recruited university student volunteers as teachers, and secured funding through a crowd-funding campaign.</li></ul><h3>Exercise: Project Concept Note</h3><p>Choose one problem in your community that you are passionate about addressing. Write a one-page concept note:</p><ul><li>What is the problem? Who is affected? (Back with evidence from observation or interviews)</li><li>What is your proposed solution? (One sentence)</li><li>What activities will you undertake? (List 3-5 specific actions)</li><li>Who will benefit? (Be specific about numbers and demographics)</li><li>What resources do you need? (People, materials, money, partnerships)</li><li>How will you know if you succeed? (Define 3 measurable outcomes)</li></ul><hr><h2>Module 4: Engaging with District Assemblies &amp; Advocating for Change</h2><p>District Assemblies (MMDAs) are the closest level of government to ordinary citizens. They make decisions about local development, budgets, and services that directly affect your community. Yet many citizens \u2014 especially young people \u2014 do not know how to engage with them. This module teaches you how to navigate your district assembly and advocate for change effectively.</p><h3>How Your District Assembly Works</h3><p>Each MMDA has a General Assembly that meets at least three times a year, composed of elected members, appointed members, and the MP as an ex-officio member. Sub-committees handle specific areas: Finance, Development Planning, Social Services, Works, and others. The District Chief Executive (DCE) is the political head, appointed by the President and confirmed by two-thirds of assembly members.</p><p>Key entry points for citizen engagement:</p><ul><li><strong>Assembly meetings</strong> \u2014 Most are open to the public. Attend and observe. Learn how decisions are made.</li><li><strong>Public hearings</strong> \u2014 Assemblies hold public hearings on the budget, development plans, and bylaws. These are opportunities to make your voice heard.</li><li><strong>Sub-committee meetings</strong> \u2014 Sub-committees often welcome input from citizens with relevant expertise. If your project relates to education, attend the Education sub-committee meeting.</li><li><strong>Your elected assembly member</strong> \u2014 Each electoral area has an elected representative. Meet them. Share your concerns. They are accountable to you.</li><li><strong>District planning officer</strong> \u2014 The planning officer coordinates development planning. They are a key ally for community projects.</li></ul><h3>How to Submit a Proposal to Your Assembly</h3><ol><li><strong>Identify the right entry point</strong> \u2014 Based on your issue, identify which sub-committee or department is responsible. A school infrastructure issue goes to the Education sub-committee. A drainage problem goes to Works.</li><li><strong>Build evidence</strong> \u2014 A proposal backed by data, photos, and community testimony is more likely to be taken seriously. Include the number of people affected, the current situation, and the proposed solution with cost estimates.</li><li><strong>Find an ally</strong> \u2014 Identify an assembly member who might support your proposal. Meet with them before the formal submission to explain your case and ask for their sponsorship.</li><li><strong>Submit formally</strong> \u2014 Prepare a written proposal with a cover letter addressed to the District Coordinating Director (the head of the civil service in the district). Keep it concise \u2014 no more than 2-3 pages.</li><li><strong>Follow up</strong> \u2014 After submission, follow up after two weeks. Ask for a written response. If rejected, ask for reasons and address them in a revised proposal.</li></ol><h3>Advocacy Strategies</h3><p>Advocacy is the process of influencing decision-makers to take a specific action. Effective advocacy combines multiple strategies:</p><ul><li><strong>Direct engagement</strong> \u2014 Meetings, letters, formal submissions to decision-makers</li><li><strong>Public campaigns</strong> \u2014 Petitions, social media campaigns, community meetings, and media engagement to build public pressure</li><li><strong>Coalition advocacy</strong> \u2014 Partner with other organizations to amplify your voice. A single youth group may be ignored; a coalition of 20 youth groups cannot be.</li><li><strong>Legal advocacy</strong> \u2014 In some cases, legal action or the threat of legal action can compel change. Article 33 of the Constitution allows any person to seek enforcement of fundamental rights.</li></ul><h3>Exercise: Advocacy Brief</h3><p>Choose one issue in your community that requires a decision from your district assembly. Write a one-page advocacy brief:</p><ul><li>What is the issue? Why does it matter?</li><li>What specific decision or action are you asking the assembly to take?</li><li>Who has the power to make this decision? (Name the specific person or committee)</li><li>What evidence supports your request? (Data, photos, case studies, community statements)</li><li>Who are your allies? (Other groups, influential individuals, sympathetic assembly members)</li><li>What is your timeline? (When will you meet, submit, follow up)</li></ul><hr><h2>Module 5: Coalition Building &amp; CSO Partnerships</h2><p>No one organization or individual can solve complex social problems alone. Coalitions \u2014 groups of organizations and individuals working together toward a shared goal \u2014 multiply impact, share resources, and build political power that no single group could achieve alone. Ghana has a vibrant civil society ecosystem, and this module teaches you how to navigate it and build effective partnerships.</p><h3>Ghana''s Civil Society Landscape</h3><p>Key CSOs in Ghana''s governance space include:</p><ul><li><strong>CDD-Ghana</strong> \u2014 Ghana Center for Democratic Development. Researches and advocates for democratic governance. Runs civic education programs, election observation, and accountability initiatives. Good partner for CECs and youth governance programs.</li><li><strong>IMANI Africa</strong> \u2014 Policy research and advocacy think tank. Focuses on public finance, education, health, and economic policy. Good partner for budget advocacy and policy analysis training.</li><li><strong>Ghana Integrity Initiative (GII)</strong> \u2014 Ghana''s chapter of Transparency International. Anti-corruption advocacy, citizen monitoring, and integrity education. Good partner for anti-corruption projects.</li><li><strong>SEND Ghana</strong> \u2014 Participatory monitoring of public services. Helps communities track budget execution and service delivery. Good partner for community monitoring projects.</li><li><strong>Odekro</strong> \u2014 Parliamentary monitoring platform. Tracks MP performance, votes, and parliamentary activities. Good partner for civic tech and transparency projects.</li><li><strong>Youth Empowerment Synergy (YES-Ghana)</strong> \u2014 Youth-focused organization working on governance, employment, and civic engagement. Good partner for youth leadership programs.</li></ul><h3>How to Build a Coalition</h3><ol><li><strong>Identify potential partners</strong> \u2014 Map organizations and individuals who share your goal. Look beyond the obvious \u2014 consider religious groups, traditional authorities, professional associations, student groups, and private sector actors.</li><li><strong>Define a shared goal</strong> \u2014 A coalition needs a clear, specific, achievable goal that all members can agree on. Not "improve education" but "increase the district education budget allocation by 10% in the next fiscal year."</li><li><strong>Agree on roles</strong> \u2014 Different partners contribute different resources and capacities. One organization may provide research, another media connections, another community mobilisation, another funding. Define roles clearly.</li><li><strong>Establish governance</strong> \u2014 A simple governance structure: a steering committee (3-5 organizations), a coordinator (rotating or permanent), and regular meetings. Keep bureaucracy to a minimum.</li><li><strong>Communicate consistently</strong> \u2014 Use a WhatsApp group for daily coordination. Hold monthly meetings. Share credit for successes publicly.</li><li><strong>Manage conflicts</strong> \u2014 Differences will arise. Have a conflict resolution mechanism agreed in advance. Focus on the shared goal, not organizational egos.</li></ul><h3>Media Engagement</h3><p>Coalitions need a communications strategy to amplify their message:</p><ul><li><strong>Press releases</strong> \u2014 Write brief statements for radio, TV, and online media. Include a quote from the coalition coordinator and contact details for follow-up.</li><li><strong>Media partnerships</strong> \u2014 Identify journalists who cover your issue. Build relationships with them. Offer them stories, data, and access.</li><li><strong>Social media campaigns</strong> \u2014 Use a common hashtag. Coordinate posting times. Amplify each other''s content. Create shareable graphics and videos.</li><li><strong>Community radio</strong> \u2014 Ghana has over 200 community radio stations. They are often the most trusted media source in rural areas. Reach out to your local station with a pre-recorded segment or offer to appear as a guest.</li></ul><h3>Exercise: Coalition Map</h3><p>For the issue you identified in Module 4, map potential coalition partners:</p><ul><li>List 5 organizations or groups that share your goal</li><li>For each, note what they bring (expertise, resources, networks, credibility)</li><li>Identify which organization would be the best lead coordinator</li><li>Draft a one-paragraph invitation message to send to potential partners</li></ul><hr><h2>Module 6: Capstone \u2014 Community Organizing Project</h2><p>Your capstone is to plan and launch a real community organizing initiative. Unlike the previous capstones which are design exercises, this one requires action. You will create a project charter and take at least one concrete step toward implementation.</p><h3>Project Options</h3><p>Choose one \u2014 or design your own with approval:</p><ul><li><strong>Launch a Civic Education Club</strong> \u2014 Complete all the steps from Module 2. Recruit your core team, hold your first meeting with at least 5 participants, and submit a one-month activity plan.</li><li><strong>Execute a community project</strong> \u2014 Implement the concept note from Module 3. Complete the needs assessment (talk to at least 10 community members), produce a one-page findings report, and take the first concrete action (clean-up, repair, awareness event, or similar).</li><li><strong>Submit an advocacy proposal</strong> \u2014 Following Module 4, prepare and submit a written proposal to your district assembly. Document the process: who you met, what you submitted, and what response you received (even if no response \u2014 that is a finding).</li><li><strong>Build a coalition</strong> \u2014 Following Module 5, reach out to at least 3 organizations to invite them to form or join a coalition around your issue. Hold at least one coalition planning meeting and produce a joint statement or action plan.</li></ul><h3>Project Charter Requirements</h3><p>Your project charter (submitted before starting) must include:</p><ol><li><strong>Project name and goal</strong> \u2014 What are you doing and why? (One sentence)</li><li><strong>Team</strong> \u2014 Who is on your core team? List names and roles.</li><li><strong>Stakeholder map</strong> \u2014 At least 5 stakeholders with their interest, influence, and your engagement strategy</li><li><strong>Activity plan</strong> \u2014 5-10 specific actions with dates and responsible persons</li><li><strong>Resources needed</strong> \u2014 What do you need? (People, materials, permissions, funds)</li><li><strong>Success metrics</strong> \u2014 How will you measure impact? (At least 3 measurable outcomes)</li><li><strong>Risk assessment</strong> \u2014 What could go wrong? What is your backup plan?</li></ol><h3>Final Report Requirements</h3><p>After executing your first action step, submit a final report including:</p><ol><li><strong>What happened</strong> \u2014 A narrative of what you did, who you engaged, and what results you achieved</li><li><strong>Evidence</strong> \u2014 Photos, sign-in sheets, meeting notes, correspondence, screenshots (with consent)</li><li><strong>Challenges</strong> \u2014 What was harder than expected? How did you adapt?</li><li><strong>Feedback</strong> \u2014 What did participants or stakeholders say? Collect at least 3 quotes.</li><li><strong>Next steps</strong> \u2014 What will you do next to sustain or scale the initiative?</li><li><strong>Personal reflection</strong> \u2014 What did you learn about yourself as a leader? What skills do you want to develop next? (2 paragraphs)</li></ol><h3>Submission</h3><p>Submit your project charter and final report as a single PDF or Google Doc. Upon review, you will receive a Certificate of Youth Leadership &amp; Community Organizing from Studio Gabochie. Outstanding projects may be featured on the Studio website, shared with the National Youth Authority, and connected to partner organizations for further support and funding opportunities.</p>' WHERE slug = 'youth-leadership'`,
    `UPDATE programs SET status = 'active', full_content = '<h2>Module 1: Ghana''s Digital Economy Landscape</h2><p>Ghana''s digital economy is one of the fastest-growing in Africa. With over 40 million mobile connections, a thriving tech startup ecosystem, and a vibrant creative industry, the opportunities for digital entrepreneurs have never been greater. This module maps the landscape so you can identify where you fit.</p><h3>The Numbers</h3><ul><li>Over 26 million mobile money users \u2014 one of the highest penetration rates in Africa</li><li>50+ active tech hubs and innovation centers across Accra, Kumasi, Takoradi, and Tamale</li><li>A startup ecosystem valued at over $1 billion, with companies like Flutterwave, Paystack, and mPharma leading the way</li><li>Ghana''s creative industry contributes approximately 5% to GDP and employs over 500,000 people</li><li>Government initiatives like the Ghana Digital Economy Policy, the National Entrepreneurship and Innovation Programme (NEIP), and the Youth Employment Agency (YEA) provide funding and support</li></ul><h3>Key Sectors</h3><ul><li><strong>Fintech</strong> \u2014 Mobile money, digital banking, lending, insurance, and investment platforms. Mobile money transactions in Ghana exceeded GHS 1 trillion in 2023. Opportunities exist in merchant payments, savings products, and rural financial inclusion.</li><li><strong>Agritech</strong> \u2014 Platforms connecting farmers to markets, crop insurance, supply chain optimization, and precision agriculture tools.</li><li><strong>Edtech</strong> \u2014 Online learning platforms, exam preparation tools, skills training apps, and language learning for Ghanaian languages.</li><li><strong>Healthtech</strong> \u2014 Telemedicine, pharmacy delivery, health record management, and AI diagnostic tools.</li><li><strong>Creative Economy</strong> \u2014 Music production and distribution, film and video content, digital design, fashion e-commerce, and cultural tourism platforms.</li><li><strong>Cleantech</strong> \u2014 Solar energy, waste management, water purification, and climate adaptation technologies.</li></ul><h3>Where Opportunities Come From</h3><p>The best business ideas come from observing problems in everyday life. The Ghanaian entrepreneur who built a mobile platform for trotro seat booking saw a problem they experienced personally. The developer who created a USSD-based market price information service for farmers listened to farmers'' frustrations. The musician who built a direct-to-fan distribution platform understood the pain points of fellow artists. Start with problems, not solutions.</p><h3>Exercise: Sector Scan</h3><p>Choose one sector from the list above. Spend one week observing problems in that sector in your community. Talk to at least three people who work in or use services in that sector. Ask them: What frustrates you? What takes too long? What is too expensive? What would make your life easier? Write down every problem you hear. At the end of the week, circle the three problems that seem most urgent and worth solving.</p><hr><h2>Module 2: Identifying Problems &amp; Validating Ideas</h2><p>Most startup failures happen because entrepreneurs build something nobody wants. The solution is validation \u2014 systematically testing whether people actually need and will pay for your idea before you invest time and money building it. This module teaches you how to validate ideas in the Ghanaian market.</p><h3>The Validation Mindset</h3><p>Validation is not about proving your idea is right. It is about discovering the truth as quickly and cheaply as possible. If your idea is wrong, you want to find out before you build. If it is right, you want to understand exactly what your customers need so you can build the right thing.</p><h3>Customer Interviews</h3><p>The most powerful validation tool is talking to potential customers. Not surveys \u2014 real conversations. Guidelines for effective customer interviews:</p><ol><li><strong>Talk to the right people</strong> \u2014 Interview people who have the problem you are trying to solve, not your friends and family who will tell you your idea is great.</li><li><strong>Ask about the past, not the future</strong> \u2014 Instead of "Would you use this app?" ask "Tell me about the last time you had this problem. What did you do?" Past behavior predicts future behavior.</li><li><strong>Listen more than you talk</strong> \u2014 Your goal is to understand, not to sell. The customer should talk 80% of the time.</li><li><strong>Look for pain and emotion</strong> \u2014 People who have a real problem will express frustration, anxiety, or resignation. If they are indifferent, the problem is not urgent enough.</li></ol><h3>Low-Cost Validation Methods</h3><ul><li><strong>Landing page test</strong> \u2014 Create a simple one-page website describing your product with a "Sign up for early access" button. Run a small Facebook ad campaign targeting your audience. If people sign up, you have validation.</li><li><strong>Pre-sell before building</strong> \u2014 Offer your product or service for pre-order at a discounted price. If people actually pay, you have strong validation.</li><li><strong>Concierge MVP</strong> \u2014 Deliver your service manually before building the automated version. This tests whether the value proposition works with the least possible investment.</li><li><strong>WhatsApp pilot</strong> \u2014 Use a WhatsApp group to test your idea with a small group of potential customers. Share updates, ask for feedback, and observe engagement.</li></ul><h3>Case Study: Validating in the Ghanaian Market</h3><p>A Ghanaian entrepreneur wanted to build an app for booking mechanics. Instead of building the app, she created a WhatsApp group called "Fix My Car - Tema" and posted a message offering to find a mechanic for anyone who needed one. When people DMed her, she manually connected them to mechanics she knew. After two weeks, she had facilitated 15 repairs and learned exactly what customers needed: trust (verified mechanics), speed (response within 30 minutes), and transparency (fixed prices). Only then did she invest in building the app.</p><h3>Exercise: Conduct 5 Customer Interviews</h3><p>Take the top problem you identified in Module 1. Conduct 5 customer interviews with people who experience this problem. Use the guidelines above. After each interview, write down: What did you learn about the problem? What surprised you? Would the person pay for a solution? After all 5 interviews, make a go/no-go decision: should you pursue this idea, or pivot to a different problem?</p><hr><h2>Module 3: Building a Minimum Viable Product</h2><p>A Minimum Viable Product (MVP) is the smallest version of your product that delivers value to customers and allows you to start learning from real usage. You do not need to be a programmer to build an MVP. Modern no-code tools allow anyone to create functional products quickly and cheaply.</p><h3>No-Code Tools for Ghanaian Entrepreneurs</h3><ul><li><strong>Landing pages</strong> \u2014 Carrd, Linktree, or Google Sites. Create a professional one-page site in under an hour for free or very low cost.</li><li><strong>Forms and data collection</strong> \u2014 Google Forms, JotForm, or Typeform. Collect customer inquiries, orders, or feedback without any coding.</li><li><strong>Booking and scheduling</strong> \u2014 Calendly or Setmore. Let customers book appointments or service slots automatically.</li><li><strong>E-commerce</strong> \u2014 Shopify, Sell or Payhip. Set up an online store to sell physical or digital products. Integrate with Mobile Money via Hubtel or ExpressPay.</li><li><strong>Mobile apps without code</strong> \u2014 Glide or Adalo. Build a mobile app by connecting a spreadsheet to a visual interface. Perfect for MVP testing.</li><li><strong>Chatbots and automation</strong> \u2014 ManyChat or Chatfuel. Build a WhatsApp or Facebook Messenger bot to handle customer inquiries, take orders, or share information.</li></ul><h3>Leveraging Mobile Money</h3><p>Mobile money is the backbone of Ghana''s digital economy. Every digital entrepreneur needs to understand how to integrate payments:</p><ul><li><strong>Hubtel Payment API</strong> \u2014 Accept Mobile Money, Visa, and Mastercard payments on your website or app. Simple API with Ghana-specific features.</li><li><strong>ExpressPay</strong> \u2014 Payment gateway that supports Mobile Money, bank transfers, and cards. Popular with Ghanaian e-commerce businesses.</li><li><strong>Paystack</strong> \u2014 Now available in Ghana. Supports Mobile Money, cards, and bank transfers. Developer-friendly APIs.</li><li><strong>USSD</strong> \u2014 For reaching customers without smartphones. Build a USSD application that allows customers to order, pay, and check status using any phone.</li></ul><h3>Case Study: MVP Success Stories</h3><ul><li><strong>Zeepay</strong> \u2014 Started as a simple mobile money remittance service connecting Ghanaian diaspora to local mobile wallets. Tested the concept with a basic web form and manual processing before building the full platform.</li><li><strong>TroTro Mover</strong> \u2014 Began as a shared Google Sheet tracking trotro routes and fares. When the creator shared it on WhatsApp and it went viral, they knew there was demand. Only then did they build the app.</li><li><strong>Wahu Mobile</strong> \u2014 Erica Tandoh built a clothing rental platform using Instagram to post inventory, WhatsApp for orders, and manual delivery. After proving demand, she built the website and automated booking system.</li></ul><h3>Exercise: Design Your MVP</h3><p>Based on the idea you validated in Module 2, design your MVP. Answer these questions:</p><ul><li>What is the single most important feature your product must have to deliver value?</li><li>What no-code or low-code tool will you use to build it?</li><li>How will customers access it? (web, mobile app, USSD, WhatsApp, or in-person)</li><li>How will you accept payments? (Mobile Money, card, or both)</li><li>What is the minimum timeline to launch? (Aim for 2-4 weeks)</li></ul><hr><h2>Module 4: Digital Marketing for Ghanaian Audiences</h2><p>Building a great product is only half the battle. You also need to reach your customers. Digital marketing in Ghana requires understanding the platforms Ghanaians actually use, the content they engage with, and how to build trust in a market where word-of-mouth is still the most powerful channel.</p><h3>The Ghanaian Digital Landscape</h3><ul><li><strong>WhatsApp</strong> \u2014 The most-used app in Ghana. Over 20 million active users. Essential for customer communication, broadcast marketing, and community building.</li><li><strong>Facebook</strong> \u2014 Still the dominant social platform for older demographics and for running targeted ads. Facebook Marketplace is a major e-commerce channel.</li><li><strong>TikTok</strong> \u2014 Explosive growth among 18-35 year olds. Ideal for creative content, brand storytelling, and viral marketing.</li><li><strong>Instagram</strong> \u2014 Popular with urban youth, creatives, and fashion/lifestyle brands. High engagement for visual content.</li><li><strong>Twitter/X</strong> \u2014 Used by professionals, journalists, and the tech community. Good for B2B, thought leadership, and news.</li><li><strong>YouTube</strong> \u2014 Major platform for long-form content, tutorials, music, and entertainment. Second-largest search engine after Google.</li></ul><h3>Marketing on a Budget</h3><p>You do not need a large budget to start marketing your product:</p><ul><li><strong>Content marketing</strong> \u2014 Create valuable content related to your product and share it on the platforms where your customers are. A farmer-focused agritech product could share weekly farming tips on WhatsApp. A music platform could publish interviews with Ghanaian artists on YouTube.</li><li><strong>Community building</strong> \u2014 Start a WhatsApp or Telegram group for your early users. Engage with them daily. Ask for feedback. Share exclusive content. Your first 100 true fans are more valuable than 10,000 passive followers.</li><li><strong>Influencer partnerships</strong> \u2014 Partner with micro-influencers (1,000-10,000 followers) in your niche. They often charge less and have higher engagement rates than macro-influencers. Offer free product access rather than cash payment.</li><li><strong>Referral programs</strong> \u2014 Encourage existing customers to refer friends. Offer a discount, free month, or small reward for each referral. Mobile money makes it easy to send rewards instantly.</li><li><strong>Localized content</strong> \u2014 Create content in Twi, Ewe, Dagbani, or Pidgin English. Customers engage more deeply with content in their mother tongue. Use local references, humor, and cultural touchpoints.</li></ul><h3>Measuring What Matters</h3><p>Track these metrics to know if your marketing is working:</p><ul><li><strong>Cost per acquisition (CPA)</strong> \u2014 How much do you spend to acquire one customer? Divide total marketing spend by number of new customers.</li><li><strong>Customer lifetime value (LTV)</strong> \u2014 How much revenue does an average customer generate over their relationship with you? Compare to CPA \u2014 LTV should be at least 3x CPA.</li><li><strong>Engagement rate</strong> \u2014 For content marketing, track comments, shares, and saves (not just likes). High engagement indicates content resonates.</li><li><strong>Conversion rate</strong> \u2014 What percentage of people who see your marketing message take the desired action (sign up, purchase, download)?</li></ul><h3>Exercise: Build a Marketing Plan</h3><p>For your MVP product, create a one-page marketing plan:</p><ul><li>Who is your target customer? (Be specific: age, location, occupation, platform they use most)</li><li>What is your core message? (One sentence that explains what you offer and why it matters)</li><li>Which 2 platforms will you focus on? (Choose based on where your customers are)</li><li>What content will you create? (List 5 content ideas)</li><li>How will you acquire your first 10 customers? (Specific actions, not vague goals)</li></ul><hr><h2>Module 5: The Creative Economy \u2014 Music, Content &amp; Cultural Products</h2><p>Ghana''s creative economy is a powerhouse of talent and economic potential. From Azonto and highlife to Kumawood films and fashion, Ghanaian creatives are building global audiences. This module teaches you how to build a sustainable career in the creative economy by combining artistic talent with business skills and digital tools.</p><h3>The Size of the Opportunity</h3><p>Africa''s creative economy is projected to reach $100 billion by 2030. Ghana''s creative industries \u2014 music, film, fashion, visual arts, and design \u2014 already employ hundreds of thousands of people. Streaming platforms like Boomplay, Audiomack, and YouTube have made it possible for Ghanaian artists to reach global audiences directly.</p><h3>Digital Music Distribution</h3><p>Gone are the days when you needed a record label to distribute your music. Today, any artist can upload their music to global platforms:</p><ul><li><strong>DistroKid</strong> \u2014 Distribute your music to Spotify, Apple Music, Boomplay, Audiomack, and 50+ other platforms for a flat annual fee</li><li><strong>TuneCore</strong> \u2014 Similar distribution, with more analytics and promotional tools</li><li><strong>UnitedMasters</strong> \u2014 Distribution with the option to keep 100% of royalties or partner for additional services</li><li><strong>Boomplay</strong> \u2014 Africa''s largest music streaming platform, with a strong user base in Ghana and Nigeria</li></ul><h3>Monetization Strategies for Creatives</h3><ul><li><strong>Streaming revenue</strong> \u2014 Royalties from streams on Spotify, Apple Music, Boomplay, etc. While per-stream payouts are small (0.003-0.005 per stream), they add up with volume and provide baseline income.</li><li><strong>Digital downloads and merchandise</strong> \u2014 Sell beats, instrumentals, samples, and merchandise directly to fans through platforms like Sell or Shopify.</li><li><strong>Brand partnerships</strong> \u2014 Collaborate with brands for sponsored content, product placement, and endorsements. Build a media kit that shows your audience size, demographics, and engagement rates.</li><li><strong>Live performance and events</strong> \u2014 Use digital platforms to promote and sell tickets for live shows. Even small venues can generate significant revenue with effective digital marketing.</li><li><strong>Fan funding</strong> \u2014 Platforms like Patreon, Ko-fi, and Buy Me a Coffee allow fans to support your work with monthly subscriptions or one-time tips. Offer exclusive content to subscribers.</li><li><strong>Sync licensing</strong> \u2014 License your music for use in films, TV shows, advertisements, and video games. Register with a performing rights organization (PRO) like COSAM in Ghana.</li></ul><h3>Protecting Intellectual Property</h3><p>Your creative work is your intellectual property (IP). Protecting it is essential:</p><ul><li><strong>Copyright</strong> \u2014 In Ghana, copyright is automatic upon creation of an original work. However, registering your work with the Copyright Office of Ghana provides stronger legal protection. Register songs, books, films, and designs.</li><li><strong>Trademarks</strong> \u2014 Register your brand name, logo, and slogan with the Ghana Registrar General''s Department to prevent others from using them.</li><li><strong>Contracts</strong> \u2014 Always have a written agreement when collaborating with others. Specify who owns what, how revenue is split, and how disputes are resolved. A simple one-page agreement is better than no agreement.</li></ul><h3>Case Study: Ghanaian Creative Entrepreneurs</h3><ul><li><strong>M.anifest</strong> \u2014 Ghanaian rapper who built a global career through independent releases, strategic collaborations, and authentic storytelling. His album "Madina to the Universe" was distributed independently and reached global audiences.</li><li><strong>Sister Derby</strong> \u2014 Musician and visual artist who built a multi-platform creative career combining music, fashion, and visual art. Uses Instagram and YouTube to connect directly with fans.</li><li><strong>Ghanaian fashion designers</strong> \u2014 Brands like Christie Brown, Osei Duro, and Kente Gentlemen have built global followings by combining traditional Ghanaian textiles with contemporary design, using Instagram and e-commerce to reach international customers.</li></ul><h3>Exercise: Your Creative Business Plan</h3><p>If you are a creative professional (musician, designer, filmmaker, writer, visual artist), write a one-page creative business plan:</p><ul><li>What is your artistic niche? (Genre, style, medium)</li><li>Who is your target audience? (Be specific about demographics and geography)</li><li>What products or services do you offer? (Music, merchandise, commissions, performances, workshops)</li><li>How will you distribute and monetize? (Platforms, pricing, revenue streams)</li><li>How will you protect your IP? (Copyright registration, contracts, trademarks)</li><li>What is your first action step this week?</li></ul><hr><h2>Module 6: Capstone \u2014 Business Model Canvas &amp; Pitch</h2><p>Your capstone project is to complete a Business Model Canvas (BMC) for your digital or creative venture and prepare a 60-second pitch. The BMC is a one-page strategic tool that captures the key elements of your business on a single page. It is the standard tool used by entrepreneurs, investors, and accelerators worldwide \u2014 including Ghanaian programs like the Meltwater Entrepreneurial School of Technology (MEST) and the Kosmos Innovation Center.</p><h3>The Business Model Canvas</h3><p>The BMC has nine building blocks:</p><ol><li><strong>Customer Segments</strong> \u2014 Who are your customers? Be specific. Not "everyone in Ghana" but "small-scale cassava farmers in the Eastern Region" or "young professionals in Accra who want to learn guitar."</li><li><strong>Value Proposition</strong> \u2014 What problem do you solve? What value do you deliver? Why should customers choose you over alternatives? This should be a clear, compelling statement.</li><li><strong>Channels</strong> \u2014 How will you reach your customers? Through WhatsApp? A mobile app? A physical shop? Partnerships with churches or schools?</li><li><strong>Customer Relationships</strong> \u2014 How will you interact with customers? Automated (chatbot, self-service), personal (one-on-one support), or community (WhatsApp group, forum)?</li><li><strong>Revenue Streams</strong> \u2014 How will you make money? One-time sales, subscriptions, commissions, advertising, licensing, or a mix?</li><li><strong>Key Resources</strong> \u2014 What do you need to operate? People (founders, employees, contractors), technology (software, hardware), physical (office, equipment), or financial (capital).</li><li><strong>Key Activities</strong> \u2014 What are the most important things you must do to deliver your value proposition? Building software, creating content, managing supply chains, marketing?</li><li><strong>Key Partnerships</strong> \u2014 Who can help you? Suppliers, distributors, technology partners, mentors, investors, or government agencies?</li><li><strong>Cost Structure</strong> \u2014 What are your major costs? Development, marketing, salaries, hosting, inventory, payments?</li></ol><h3>The 60-Second Pitch</h3><p>A great pitch is concise, clear, and compelling. Structure your 60-second pitch as follows:</p><ul><li><strong>Hook (5 seconds)</strong> \u2014 Grab attention. "Did you know that 40% of cassava in Ghana is lost to post-harvest spoilage?"</li><li><strong>Problem (10 seconds)</strong> \u2014 Describe the problem you solve. "Small-scale farmers in Ghana lack access to cold storage and market price information."</li><li><strong>Solution (15 seconds)</strong> \u2014 Explain your product. "FarmCool is a solar-powered cold storage unit with an integrated SMS price alert system."</li><li><strong>Market (10 seconds)</strong> \u2014 Who will buy it? "Our target customers are 10,000 small-scale cassava farmers in the Ashanti and Eastern Regions."</li><li><strong>Business model (10 seconds)</strong> \u2014 How will you make money? "We sell the units on a pay-as-you-go model, collecting via Mobile Money."</li><li><strong>Ask (10 seconds)</strong> \u2014 What do you need? "We are seeking GHS 50,000 to build 5 pilot units and launch in 2 districts."</li></ul><h3>Deliverable Requirements</h3><p>Your completed capstone must include:</p><ol><li><strong>Business Model Canvas</strong> \u2014 Complete all nine blocks. Format as a single page (use a template like Canva or a simple table in Google Docs).</li><li><strong>60-Second Pitch Script</strong> \u2014 Write out your pitch word-for-word. Practice until you can deliver it naturally in 60 seconds.</li><li><strong>Pitch Video or Audio</strong> \u2014 Record yourself delivering the pitch. Use your phone. This can be the raw recording \u2014 you do not need editing.</li><li><strong>Reflection</strong> \u2014 What was the hardest block of the BMC to complete? Why? What is the biggest risk facing your venture? How will you address it? (1-2 paragraphs)</li></ol><h3>Submission</h3><p>Submit your BMC, pitch script, and pitch video as a Google Drive folder or single document. Upon review, you will receive a Certificate of Digital Entrepreneurship &amp; the Creative Economy from Studio Gabochie. Top pitches may be shared with the National Entrepreneurship and Innovation Programme (NEIP) and partner accelerators for potential incubation support.</p>' WHERE slug = 'digital-entrepreneurship'`,
    // Activate Essential Values with full content
    `UPDATE programs SET status = 'active', full_content = '<h2>Module 1: Responsible Citizenship</h2><p>As the Ghanaian proverb says, <em>"The clan is stronger than the individual."</em> Citizenship is not merely a legal status \u2014 it is a relationship of mutual responsibility between the individual and the nation. Ghana''s 1992 Constitution defines both the rights and the duties of citizens. This module explores what it truly means to be a responsible citizen of Ghana.</p><h3>The Adinkra Symbol: The Conjoined Crocodiles</h3><p>The Adinkra symbol <em>Funtumfunafu Denkyemfunafu</em> depicts two crocodiles joined at the stomach who share one stomach but fight over food. It reminds us that although citizens may have different interests and backgrounds, we share a common destiny. What harms one ultimately harms all. Responsible citizenship means recognizing that our fates are connected.</p><h3>The Rights of a Citizen</h3><p>Chapter 5 of Ghana''s Constitution guarantees fundamental rights including the right to life, liberty, free speech, assembly, information, education, and to vote. But rights are not unconditional \u2014 they exist in relationship to the rights of others and the common good. Article 41 of the Constitution reminds us that the exercise of rights comes with corresponding duties.</p><h3>The Responsibilities of a Citizen</h3><p>Article 41 of the Constitution imposes duties on every citizen:</p><ul><li><strong>To uphold the Constitution</strong> \u2014 To respect its principles, institutions, and processes. This includes obeying the law and respecting the authority of legitimate institutions.</li><li><strong>To protect public property</strong> \u2014 To prevent the misappropriation of public funds and to report waste and corruption. Public property belongs to all Ghanaians, and each citizen has a duty to protect it.</li><li><strong>To defend Ghana</strong> \u2014 To render national service when required. This can mean military service, but also community service, civic participation, and contributing to national development.</li><li><strong>To pay taxes honestly</strong> \u2014 Taxes fund public goods: roads, schools, hospitals, security. Tax evasion is a form of stealing from fellow citizens.</li><li><strong>To cooperate with lawful authorities</strong> \u2014 To assist in maintaining law and order, to serve on juries, and to participate in lawful processes.</li></ul><h3>The Common Good</h3><p>Responsible citizenship means making decisions not only based on self-interest but also on what benefits the community. The common good is the sum total of conditions that allow all citizens to flourish. When you vote, do you consider only your personal benefit, or also what serves the nation? When you see someone littering, do you walk past or respectfully remind them? When you hear a rumor, do you repeat it or verify it? These small choices define responsible citizenship.</p><h3>Exercise: Your Citizenship Audit</h3><p>Take 15 minutes to honestly assess your own citizenship. On a piece of paper, create two columns: "Rights I Value" and "Responsibilities I Practice." Under rights, list the five constitutional rights that matter most to you. Under responsibilities, list the duties from Article 41 and rate yourself on each (1 = rarely, 5 = always). Choose one responsibility where you rated yourself lowest and commit to improving it this month.</p><hr><h2>Module 2: Honesty &amp; Combating Misinformation</h2><p>The Adinkra symbol <em>Odo Nnyew Fie Kwan</em> \u2014 "Love never loses its way home" \u2014 reminds us that truthfulness is the path to trust and harmony. In the age of social media, misinformation spreads faster than ever, eroding trust in institutions, polarizing communities, and undermining democracy. Honesty \u2014 both personal and public \u2014 is a foundational value for national development.</p><h3>The Cost of Dishonesty</h3><p>Dishonesty erodes trust, and trust is the currency of social and economic life. When citizens do not trust government, they withhold taxes, ignore regulations, and disengage from civic life. When citizens do not trust each other, cooperation breaks down. The cost of dishonesty is measured not only in money lost to corruption but in the breakdown of the social fabric.</p><h3>The Adinkra Symbol: The Measuring Rod</h3><p>The symbol <em>Nkoso</em> \u2014 the measuring rod \u2014 represents quality, thoroughness, and a commitment to truth. Just as a measuring rod ensures accuracy in construction, honesty ensures accuracy in communication. Without it, we build on crooked foundations.</p><h3>Understanding Misinformation</h3><p>Misinformation is false or inaccurate information spread without malicious intent. Disinformation is false information deliberately spread to deceive. Both are harmful. Common types in the Ghanaian context:</p><ul><li><strong>Health misinformation</strong> \u2014 False claims about vaccines, cures, or medical practices that endanger lives. During COVID-19, rumors about treatments led to preventable deaths.</li><li><strong>Political disinformation</strong> \u2014 Fabricated stories about candidates, manipulated images, or false claims about election processes designed to influence voters or delegitimize results.</li><li><strong>Economic rumors</strong> \u2014 False information about currency devaluation, bank failures, or commodity prices that can cause panic and economic harm.</li><li><strong>Ethnic and religious hate speech</strong> \u2014 False or exaggerated claims about ethnic or religious groups that incite division and violence.</li></ul><h3>How to Verify Information</h3><p>Before sharing any information, ask these five questions:</p><ol><li><strong>Who published this?</strong> \u2014 Check the source. Is it a reputable news organization, a government agency, or an unknown blog? Look for an "about" page and contact information.</li><li><strong>What evidence supports it?</strong> \u2014 Does the article cite specific sources, studies, or official documents? Are quotes attributed to named individuals? Can you find the same claim reported elsewhere?</li><li><strong>Is it current?</strong> \u2014 Old information can be recirculated to mislead. Check the publication date.</li><li><strong>Does it appeal to emotion?</strong> \u2014 Content designed to provoke anger, fear, or outrage is more likely to be false. Emotional manipulation is a hallmark of disinformation.</li><li><strong>What do fact-checkers say?</strong> \u2014 Ghana has fact-checking organizations like GhanaFact and Dubawa. Search their databases before sharing claims.</li></ol><h3>Exercise: Trace a Viral Claim</h3><p>Find a viral claim circulating on WhatsApp, Facebook, or Twitter related to Ghana (politics, health, or a social issue). Use the five verification questions above to investigate it. Write down: What is the claim? Who originally published it? What evidence did you find for or against it? Would you share it after your investigation? Discuss with one other person and compare your findings.</p><hr><h2>Module 3: Integrity in Public &amp; Private Life</h2><p>The Adinkra symbol <em>Dwennimmen</em> \u2014 the ram''s horns \u2014 represents strength and confidence derived from the integrity of one''s character. A ram fights from the strength of its horns; a person of integrity acts from the strength of their principles. Integrity means being the same person in public as in private, and aligning your actions with your stated values.</p><h3>What Is Integrity?</h3><p>Integrity comes from the Latin word <em>integer</em>, meaning whole or complete. A person of integrity is undivided \u2014 they do not have one set of principles for public life and another for private life. Their word is their bond. Integrity is tested not in easy situations but in difficult ones: when no one is watching, when there is a shortcut available, when doing the right thing is costly.</p><h3>Integrity in Public Life</h3><p>Public integrity means that government officials, civil servants, and elected representatives act in the public interest, not for personal gain. In Ghana, the Commission on Human Rights and Administrative Justice (CHRAJ) and the Office of the Special Prosecutor investigate breaches of public integrity. But integrity cannot be enforced by institutions alone \u2014 it must be cultivated as a personal value.</p><p>Examples of public integrity in action:</p><ul><li>A procurement officer who rejects a bribe and awards a contract to the most qualified bidder</li><li>A police officer who refuses to accept a "tip" to drop a legitimate traffic violation</li><li>A teacher who shows up to class every day and prepares thoroughly for lessons</li><li>A journalist who verifies facts before publishing and corrects errors promptly</li></ul><h3>Integrity in Private Life</h3><p>Private integrity is equally important. It is the foundation of trust in families, friendships, and communities. Examples include:</p><ul><li>Returning extra change a vendor gave you by mistake</li><li>Keeping a promise you made to a child or an elderly relative</li><li>Admitting when you are wrong and apologizing sincerely</li><li>Not cheating on an exam or plagiarizing an assignment</li></ul><h3>Case Study: Integrity Under Pressure</h3><p>Consider this scenario: You work as a junior officer in a district assembly. Your supervisor asks you to approve a payment to a contractor who has not completed the work. The supervisor implies that if you cooperate, you will receive a promotion. If you refuse, you risk losing your job. What do you do? Write down three possible courses of action and the consequences of each. Which one aligns with your values? Which one is hardest? Why?</p><h3>Exercise: Integrity Journal</h3><p>For one week, keep a journal. At the end of each day, write down one moment when you acted with integrity and one moment when you fell short. Do not judge yourself \u2014 simply observe. Note what made it easy or difficult. At the end of the week, look for patterns. What situations test your integrity most? What support systems could help you act with integrity in those situations?</p><hr><h2>Module 4: Diversity &amp; Equity as National Strength</h2><p>Ghana is home to over 80 ethnic groups and languages, multiple religious traditions, and a rich diversity of cultural practices. The Adinkra symbol <em>Nkoso</em> \u2014 the palm tree \u2014 reminds us that diversity is a source of strength: the palm tree provides food, shelter, and medicine in every part, just as every ethnic group and community contributes to the nation''s wealth. This module explores how to move beyond tolerating diversity to actively embracing equity.</p><h3>The Adinkra Symbol: The Palm Tree</h3><p>The palm tree (<em>Nkoso</em>) is a powerful symbol of self-sufficiency and abundance. Every part of the palm tree is useful \u2014 the fruit for food and oil, the fronds for roofing and weaving, the trunk for building. In the same way, every ethnic group and community in Ghana contributes something essential to the nation''s life. Diversity is not a problem to be managed but a resource to be celebrated.</p><h3>Ghana''s Ethnic Diversity</h3><p>Ghana''s major ethnic groups include the Akan (47.5%), Mole-Dagbon (16.6%), Ewe (13.9%), Ga-Adangbe (7.4%), Gurma (5.7%), Guan (3.7%), Grusi (2.5%), and Mande (1.1%). Each group has its own language, traditions, and history. This diversity is a constitutional value: Article 35(5) requires the state to promote integration and prohibit discrimination on grounds of ethnic origin.</p><h3>Diversity vs. Equity</h3><p>Diversity is about representation \u2014 having different groups present in a space. Equity is about fairness \u2014 ensuring that different groups have access to the same opportunities and that historical disadvantages are addressed. A school can be diverse (students from many ethnic groups) without being equitable (if one group consistently has better resources, teachers, or outcomes).</p><p>Equity recognizes that different groups may need different levels of support to achieve equal outcomes. For example:</p><ul><li>A student from a remote rural area may need additional tutoring or boarding support to compete with students from well-resourced urban schools</li><li>A person with a disability may need accessible infrastructure and assistive technology to participate fully in public life</li><li>A woman may need targeted mentorship and sponsorship to advance in fields where women are historically underrepresented</li></ul><h3>Religious Diversity</h3><p>Ghana is a secular state (Article 1) that guarantees freedom of religion (Article 21). Christians (71%), Muslims (20%), and followers of traditional African religions (3%) coexist largely peacefully \u2014 a model for other nations. This religious harmony is not accidental; it requires active cultivation through interfaith dialogue, mutual respect, and constitutional protection for all faiths.</p><h3>Exercise: Your Identity Map</h3><p>Create a personal identity map. On a piece of paper, write your name in the center. Draw branches for: ethnic group, language(s) spoken, religion (if any), gender, region of origin, and any other identities that matter to you. For each branch, write one way that identity gives you privilege or advantage in Ghanaian society and one way it may present challenges. Share with a partner from a different background and discuss what you learned about each other.</p><hr><h2>Module 5: Discipline &amp; Self-Directed Learning</h2><p>The Adinkra symbol <em>Nkoa</em> \u2014 the good farmer \u2014 represents diligence, hard work, and the discipline required to cultivate a harvest. Just as a farmer prepares the soil, plants seeds, waters, weeds, and waits patiently for the harvest, a disciplined person puts in consistent effort over time to achieve meaningful results. This module explores discipline not as punishment but as the foundation of excellence and self-directed learning as the engine of lifelong growth.</p><h3>The Adinkra Symbol: The Good Farmer</h3><p>The good farmer (<em>Nkoa</em>) does not wait for a bountiful harvest to appear by chance. They prepare the ground, plant at the right time, protect the crops from weeds and pests, and water consistently. They understand that the quality of the harvest depends on the quality of their daily habits. In the same way, a disciplined person builds habits that yield results over time.</p><h3>Discipline as Freedom</h3><p>Discipline is often misunderstood as restriction or punishment. In reality, discipline is freedom. The discipline to study every day gives you the freedom to pass exams and choose your path. The discipline to save money gives you the freedom to invest in your future. The discipline to tell the truth gives you the freedom of a clear conscience. Discipline is not the opposite of freedom \u2014 it is the path to it.</p><h3>Building Daily Habits</h3><p>Research in habit formation (James Clear, <em>Atomic Habits</em>) shows that small daily actions compound into extraordinary results. The four laws of habit formation:</p><ol><li><strong>Make it obvious</strong> \u2014 Place your books where you see them. Set a recurring alarm for study time. Tell a friend you will report your progress.</li><li><strong>Make it attractive</strong> \u2014 Connect the habit to something you enjoy. Listen to music while studying. Study with a friend. Create a reward system.</li><li><strong>Make it easy</strong> \u2014 Start with five minutes. Reduce friction. Prepare your materials in advance. The two-minute rule: any habit can be started in two minutes.</li><li><strong>Make it satisfying</strong> \u2014 Track your progress. Celebrate small wins. Use a habit tracker and check off each day you complete your habit.</li></ol><h3>Self-Directed Learning</h3><p>Self-directed learning (SDL) is the ability to take initiative for your own learning: identifying what you need to learn, finding resources, setting goals, and evaluating your progress. SDL is essential because formal education cannot teach you everything you will need in life. The most successful people in any field are continuous, self-directed learners.</p><p>The SDL cycle:</p><ol><li><strong>Diagnose</strong> \u2014 What do I need to learn? What gap in my knowledge or skills is holding me back?</li><li><strong>Plan</strong> \u2014 What resources will I use? What is my timeline? How will I measure progress?</li><li><strong>Learn</strong> \u2014 Engage with the material. Read, watch, listen, practice. Take notes and ask questions.</li><li><strong>Apply</strong> \u2014 Use what you learned in a real context. Teach someone else. Complete a project.</li><li><strong>Reflect</strong> \u2014 What worked? What didn''t? What should I learn next?</li></ol><h3>Exercise: Your Learning Plan</h3><p>Choose one skill you want to develop in the next three months (it could be a professional skill like public speaking, a civic skill like understanding the budget, or a personal skill like learning a Ghanaian language). Using the SDL cycle above, write a one-page learning plan:</p><ul><li>What is your specific goal? (e.g., "I want to be able to hold a five-minute conversation in Twi.")</li><li>What resources will you use? (e.g., apps, books, tutors, conversation partners)</li><li>What is your daily or weekly habit? (e.g., "15 minutes of Twi study every morning.")</li><li>How will you measure progress? (e.g., "End of week 4: I can introduce myself. End of week 8: I can order food in a market.")</li><li>Who will hold you accountable? (e.g., a friend who also wants to learn)</li></ul><hr><h2>Module 6: Capstone \u2014 Values in Action Project</h2><p>The Values in Action Project is your opportunity to take one of the essential values from this course and put it into practice in your community. You will design and facilitate a session that teaches or promotes a value to others. This is not a written exercise \u2014 your project should be designed for actual delivery to a real audience.</p><h3>Project Options</h3><p>Choose one of the following formats:</p><ul><li><strong>Community Values Workshop</strong> \u2014 Design and facilitate a 60-90 minute workshop on one essential value (responsible citizenship, honesty, integrity, diversity/equity, or discipline). Your workshop must include: an opening activity, a teaching segment, a discussion or group exercise, and a closing commitment. Deliver it to at least 5 participants from your community (church group, youth association, workplace team, or family gathering).</li><li><strong>Civic Education Club Session</strong> \u2014 Design a 45-minute session for a school or community Civic Education Club based on one module from this course. Include learning objectives, a discussion guide, an interactive activity, and a take-home challenge. If possible, deliver the session to an existing club or recruit participants to form a new one.</li><li><strong>Public Awareness Campaign</strong> \u2014 Design a campaign to promote one essential value in your community. Choose your medium: a social media campaign (5 posts over one week), a poster campaign (3 posters placed in community gathering spots), a radio/show segment, or a community event. Define your target audience, key message, and success metrics.</li><li><strong>Personal Values Challenge</strong> \u2014 Choose one value you want to strengthen in your own life. Design a 21-day personal challenge with daily actions. For example, if you choose honesty: Day 1 \u2014 Tell one truthful compliment. Day 5 \u2014 Correct a mistake you made. Day 10 \u2014 Return something you borrowed. Day 15 \u2014 Refuse to spread an unverified rumor. Day 21 \u2014 Have an honest conversation about something you have been avoiding. Document your journey.</li></ul><h3>Deliverable Requirements</h3><p>Your completed project submission must include:</p><ol><li><strong>Project plan</strong> \u2014 What did you do? Why did you choose this format? Who was your audience? (1 page)</li><li><strong>Session materials</strong> \u2014 Your workshop outline, discussion guide, slides, posters, or social media posts (as applicable)</li><li><strong>Evidence of delivery</strong> \u2014 Photos, participant lists, sign-in sheets, screenshots, or recordings (with consent)</li><li><strong>Participant feedback</strong> \u2014 At least 3 participants'' reflections on what they learned or committed to change (quotes or short surveys)</li><li><strong>Personal reflection</strong> \u2014 What was the most challenging part of facilitating this value? What did you learn about yourself? How will you continue to practice this value? (2 paragraphs)</li></ol><h3>Submission</h3><p>Submit your project as a single PDF or Google Doc with embedded photos and links. Upon review, you will receive a Certificate of Essential Values for National Development from Studio Gabochie. Exceptional projects may be featured on the Studio website and shared with the National Commission for Civic Education (NCCE) for potential adoption in their programs.</p>' WHERE slug = 'essential-values'`,
    // Activate AI Fundamentals with full content
    `UPDATE programs SET status = 'active', full_content = '<h2>Module 1: What Is AI and Why Does It Matter for Ghana?</h2><p>Artificial Intelligence (AI) is the ability of machines to perform tasks that normally require human intelligence \u2014 recognizing speech, making decisions, identifying patterns, and even creating art. For Ghana, AI represents an opportunity to leapfrog development challenges in agriculture, health, education, and governance. Ghana''s National AI Strategy envisions an AI-powered society by 2035, and this module gives you the foundational knowledge to participate in that transformation.</p><h3>What AI Is (and Isn''t)</h3><p>AI is not magic. At its core, AI is mathematics and data. A computer learns patterns from examples and uses those patterns to make predictions or decisions. The three main branches of AI you will encounter in this course are:</p><ul><li><strong>Machine Learning (ML)</strong> \u2014 Algorithms that improve at a task as they are exposed to more data. For example, an ML model trained on thousands of images of healthy and diseased cassava leaves can learn to identify disease with high accuracy.</li><li><strong>Natural Language Processing (NLP)</strong> \u2014 The ability of computers to understand, interpret, and generate human language. NLP powers the translation of English to Twi, voice assistants that understand Ghanaian accents, and tools that analyze public feedback.</li><li><strong>Computer Vision (CV)</strong> \u2014 The ability of computers to interpret visual information from the world. CV is used for satellite image analysis of land use, crop health monitoring from drone footage, and automated inspection of infrastructure.</li></ul><h3>The Ghana AI Strategy 2035</h3><p>Ghana launched its National AI Strategy in 2025 with six priority sectors: agriculture, health, education, governance, digital economy, and data infrastructure. The strategy calls for the establishment of a Responsible AI Authority to ensure AI is developed and deployed ethically. It also commits to building Ghanaian AI talent through university programs, bootcamps, and public-private partnerships.</p><h3>Why AI Matters for the Average Ghanaian</h3><p>AI is not a distant technology for tech companies. It affects everyday life:</p><ul><li>A farmer uses a mobile app that diagnoses crop disease from a photo \u2014 that is AI.</li><li>A student learns personalized math lessons adapted to their pace \u2014 that is AI.</li><li>A citizen reports a pothole and the system automatically routes it to the right district assembly \u2014 that is AI.</li><li>A nurse receives an alert about a patient at risk based on health records \u2014 that is AI.</li></ul><h3>Exercise: AI in Your Daily Life</h3><p>Over the next week, notice every time you interact with an AI system \u2014 a recommendation on YouTube, autocomplete in a Google search, face unlock on your phone, spam filter in your email. List 5 AI systems you use regularly. For each one, write down what data it uses and what decision it makes. This awareness is the first step toward becoming an informed AI citizen.</p><hr><h2>Module 2: AI for Ghanaian Agriculture &amp; Environment</h2><p>Agriculture employs over 40% of Ghana''s workforce and contributes significantly to GDP. Yet the sector faces challenges: crop disease, unpredictable weather, post-harvest losses, and limited access to extension services. AI offers practical tools to address each of these challenges.</p><h3>Crop Disease Detection</h3><p>AI-powered image recognition can identify diseases in crops like cassava, maize, cocoa, and yam from a simple smartphone photo. Apps like PlantVillage and Nuru (developed in partnership with the International Institute of Tropical Agriculture) allow farmers to diagnose diseases instantly and receive treatment recommendations.</p><p>How it works:</p><ol><li>Farmer takes a photo of the affected plant using a mobile app</li><li>The app sends the image to an AI model trained on thousands of labeled images of healthy and diseased plants</li><li>The model identifies the disease (or confirms the plant is healthy) and returns a confidence score</li><li>The farmer receives treatment recommendations and can share the diagnosis with an extension officer</li></ol><h3>Weather Prediction &amp; Climate Resilience</h3><p>Machine learning models trained on historical weather data, satellite imagery, and ocean temperature patterns can predict rainfall, drought, and temperature trends at the district level. Platforms like Ghana''s National Framework for Climate Services use AI to deliver localized forecasts to farmers via SMS, helping them decide when to plant, irrigate, and harvest.</p><h3>Supply Chain Optimization</h3><p>AI can reduce post-harvest losses \u2014 which can reach 30% for certain crops \u2014 by optimizing the supply chain:</p><ul><li>Predictive analytics forecast demand at urban markets, helping farmers decide what to grow and when to sell</li><li>Route optimization software ensures produce reaches markets quickly and at lower cost</li><li>Quality inspection AI at aggregation centers grades produce automatically (size, ripeness, defects)</li></ul><h3>Case Study: Ghanaian Agritech Startups</h3><p>Several Ghanaian startups are applying AI to agriculture:</p><ul><li><strong>Geo-Tech</strong> \u2014 Uses satellite imagery and AI to map cocoa farms and detect illegal mining encroachment</li><li><strong>CocoaLink</strong> \u2014 SMS-based AI assistant that provides cocoa farmers with personalized agronomic advice based on weather data and farm location</li><li><strong>AgriPredict</strong> \u2014 AI-powered risk assessment for crop insurance, helping smallholder farmers access insurance products</li></ul><h3>Exercise: AI for Your Local Crop</h3><p>Choose one crop grown in your district (e.g., cassava, cocoa, maize, tomato, plantain). Research what diseases or pests affect that crop. Design a simple AI concept: what data would you need to train a model? How would farmers submit photos? What information would the app return? Write a one-page concept brief.</p><hr><h2>Module 3: AI for Health, Education &amp; Governance</h2><p>Beyond agriculture, AI is transforming how Ghanaians access healthcare, learn, and interact with government. This module explores concrete applications in three critical public service sectors.</p><h3>AI in Healthcare</h3><p>Ghana faces a doctor-to-patient ratio of approximately 1:10,000 in rural areas. AI can extend the reach of healthcare professionals:</p><ul><li><strong>Diagnostic assistance</strong> \u2014 AI models trained on medical images (X-rays, CT scans, retinal photos) can detect conditions like tuberculosis, diabetic retinopathy, and malaria with accuracy comparable to specialists. Ghana''s Korle Bu Teaching Hospital has piloted AI-assisted radiology.</li><li><strong>Disease surveillance</strong> \u2014 AI analyzes patterns in health records, pharmacy sales, and search queries to detect disease outbreaks before they spread. During COVID-19, AI models predicted case surges and helped allocate resources.</li><li><strong>Telemedicine triage</strong> \u2014 Chatbots powered by NLP collect patient symptoms and recommend whether they need urgent care, a clinic visit, or home treatment. This reduces the burden on overstretched health facilities.</li><li><strong>Maternal health</strong> \u2014 AI models predict pregnancy complications by analyzing patient history, vital signs, and social determinants, enabling early intervention.</li></ul><h3>AI in Education</h3><p>Ghana''s education system faces challenges of large class sizes, teacher shortages, and varying quality of instruction. AI can personalize learning at scale:</p><ul><li><strong>Adaptive learning platforms</strong> \u2014 AI tutors assess each student''s knowledge level and adapt lessons accordingly. A student struggling with fractions receives additional practice and explanations; an advanced student is challenged with harder problems.</li><li><strong>Language support</strong> \u2014 AI tools help students learn in their mother tongue while building proficiency in English. Text-to-speech and speech-to-text in Twi, Ewe, and Dagbani make digital learning accessible to more students.</li><li><strong>Teacher assistants</strong> \u2014 AI grading tools reduce the time teachers spend on marking multiple-choice and short-answer assessments, freeing them for lesson planning and one-on-one interaction.</li></ul><h3>AI in Governance</h3><p>AI can make government more efficient, transparent, and responsive:</p><ul><li><strong>Public service chatbots</strong> \u2014 AI chatbots on government portals answer citizen questions, help with form completion, and route complex issues to human agents. Ghana''s E-Services Portal is being enhanced with AI capabilities.</li><li><strong>Fraud detection</strong> \u2014 AI models analyze procurement data, tax returns, and benefit claims to identify anomalies that may indicate corruption or waste. Several countries have saved millions by deploying AI audit systems.</li><li><strong>Predictive policing</strong> \u2014 AI analyzes crime patterns to predict where crimes are likely to occur, allowing police to deploy resources proactively. (Note: This must be implemented carefully to avoid bias and civil liberties violations.)</li><li><strong>Budget analysis</strong> \u2014 AI tools can read and summarize budget documents, track expenditure against allocations, and highlight discrepancies \u2014 empowering citizens and journalists to hold government accountable.</li></ul><h3>Exercise: Pick a Sector</h3><p>Choose health, education, or governance. Identify one specific problem in that sector that you have personally experienced or witnessed. Write a one-paragraph description of the problem and a one-paragraph description of how an AI system could help solve it. What data would the system need? Who would use it? What could go wrong?</p><hr><h2>Module 4: Ghanaian Language AI &amp; Localized Datasets</h2><p>One of the most exciting frontiers of AI in Ghana is the development of language technology for Ghanaian languages. For AI to serve all Ghanaians, it must understand the languages they speak. This module explores the technical, cultural, and sovereignty dimensions of language AI.</p><h3>Why Language AI Matters</h3><p>Ghana has over 80 languages, with Twi, Ewe, Dagbani, Ga, Hausa, and Fante being the most widely spoken. Yet most AI systems are trained on English-language data from the Global North. This creates a digital divide: a farmer who speaks only Twi cannot use voice assistants, navigation tools, or government chatbots. Language AI bridges this gap.</p><h3>Key Technologies</h3><ul><li><strong>Speech-to-text (ASR)</strong> \u2014 Converts spoken language into written text. Essential for voice assistants, transcription services, and accessibility tools. Projects like Mozilla Common Voice have collected thousands of hours of Twi and Ewe speech data.</li><li><strong>Text-to-speech (TTS)</strong> \u2014 Converts written text into spoken language. Enables literacy apps, audio news services, and voice navigation in Ghanaian languages.</li><li><strong>Machine translation</strong> \u2014 Translates between English and Ghanaian languages. Khaya, developed by Ghanaian researchers, provides translation for Twi, Ewe, Fante, and Ga.</li><li><strong>Sentiment analysis</strong> \u2014 Determines whether a piece of text (e.g., a social media post or customer feedback) expresses positive, negative, or neutral sentiment. Useful for understanding public opinion on policies and services.</li></ul><h3>Localized Datasets: Why They Matter</h3><p>AI models are only as good as the data they are trained on. A model trained on American English cannot understand a Ghanaian farmer describing cassava disease in Twi. Building localized datasets means:</p><ul><li>Recording and transcribing speech in Ghanaian languages with Ghanaian accents</li><li>Labeling images of Ghanaian crops, traditional architecture, and local infrastructure</li><li>Collecting text from Ghanaian news articles, social media, and government documents</li><li>Annotating data with culturally relevant categories and contexts</li></ul><h3>Citizen Science: You Can Help</h3><p>You do not need to be a data scientist to contribute to language AI. Ordinary citizens can help by:</p><ul><li>Recording voice clips in their mother tongue through the Mozilla Common Voice app</li><li>Verifying translations on the Khaya platform</li><li>Submitting text in Ghanaian languages for datasets</li><li>Testing AI applications and reporting errors</li></ul><h3>Data Sovereignty</h3><p>Data sovereignty means that Ghanaians \u2014 not foreign tech companies \u2014 should control how their language data is collected, stored, and used. Ghana''s Data Protection Act (Act 843) requires that personal data be processed lawfully and that data subjects have rights over their data. When building or using language AI, ask:</p><ul><li>Who owns this data?</li><li>Where is it stored?</li><li>Who can access it?</li><li>What happens if I want it deleted?</li></ul><h3>Exercise: Record Your Voice</h3><p>Download the Mozilla Common Voice app on your phone. Record at least 10 sentences in your mother tongue (Twi, Ewe, Dagbani, Ga, or another Ghanaian language). Listen back to ensure the recording is clear. Then listen to and verify 10 recordings made by other contributors. This is a real contribution to Ghanaian language AI.</p><hr><h2>Module 5: AI Ethics, the Responsible AI Authority &amp; the Data Protection Act</h2><p>As AI becomes more powerful, the ethical questions become more urgent. Who is responsible when an AI makes a mistake? How do we ensure AI does not discriminate against vulnerable groups? How do we protect privacy in an AI-powered world? Ghana is building an institutional framework to answer these questions.</p><h3>Key Ethical Challenges in AI</h3><ul><li><strong>Algorithmic bias</strong> \u2014 AI models learn from historical data. If that data contains biases (e.g., hiring practices that favored men, loan approvals that discriminated by ethnicity), the AI will reproduce and even amplify those biases. In Ghana, this could mean an AI hiring tool that disadvantages applicants from certain regions, or a credit-scoring system that excludes informal sector workers.</li><li><strong>Privacy and surveillance</strong> \u2014 AI systems that collect and analyze personal data can be used for legitimate purposes (crime prevention, service delivery) but also for mass surveillance or political control. Ghana''s constitutional right to privacy (Article 18) must guide AI deployment.</li><li><strong>Accountability</strong> \u2014 When an AI system makes a wrong diagnosis, denies a loan, or flags someone as a security risk, who is accountable? The developer? The government agency? The AI itself? Clear lines of accountability must be established.</li><li><strong>Transparency</strong> \u2014 Citizens have a right to know when they are interacting with an AI system and how decisions about them are made. Article 21(1)(f) of Ghana''s Constitution guarantees the right to information.</li><li><strong>Job displacement</strong> \u2014 AI will automate some jobs while creating others. Ghana needs policies for reskilling, social protection, and supporting workers through the transition.</li></ul><h3>The Responsible AI Authority</h3><p>Ghana''s National AI Strategy calls for a Responsible AI Authority (RAA) with the following functions:</p><ul><li>Developing and enforcing ethical guidelines for AI development and deployment in Ghana</li><li>Reviewing AI systems for compliance before they are deployed in public services</li><li>Investigating complaints about AI harms and ordering remedies</li><li>Promoting AI literacy and public awareness</li><li>Advising government on AI policy and legislation</li></ul><h3>The Data Protection Act (Act 843)</h3><p>The Data Protection Act, 2012 (Act 843) establishes the legal framework for data protection in Ghana. Key provisions relevant to AI:</p><ul><li>Data must be processed fairly, lawfully, and for specified purposes (Section 17)</li><li>Data subjects have the right to access, correct, and delete personal data (Sections 35-39)</li><li>Sensitive personal data (health, ethnicity, political opinions, biometrics) requires explicit consent (Section 47)</li><li>Data controllers must register with the Data Protection Commission and implement security measures (Section 43-48)</li><li>Transfer of personal data outside Ghana is restricted (Section 41-42)</li></ul><h3>The UNESCO AI Ethics Recommendations</h3><p>Ghana is a signatory to the UNESCO Recommendation on the Ethics of AI, which articulates four core values:</p><ol><li><strong>Human dignity</strong> \u2014 AI should protect and promote human rights and fundamental freedoms</li><li><strong>Human oversight</strong> \u2014 AI systems should be subject to meaningful human control</li><li><strong>Transparency and explainability</strong> \u2014 AI decisions should be understandable to those affected</li><li><strong>Responsibility and accountability</strong> \u2014 Those who develop and deploy AI should be accountable for its impacts</li></ol><h3>Ethical Framework for Your AI Projects</h3><p>Before building or deploying any AI system, ask these six questions:</p><ol><li>Who benefits from this AI? Who might be harmed?</li><li>What data are we using? Was it collected with consent? Is it representative?</li><li>Can this decision be explained to someone affected by it?</li><li>What happens if the AI makes a mistake? Who fixes it?</li><li>Is there human oversight? Can a person override the AI?</li><li>Does this align with Ghana''s values and legal frameworks?</li></ol><h3>Reflection</h3><p>Think of an AI application you use or would like to build. Write down answers to the six ethical questions above. Identify one ethical risk that you had not considered before this module.</p><hr><h2>Module 6: Capstone \u2014 AI Opportunity Map</h2><p>The AI Opportunity Map is your capstone project. You will identify a real problem in your community, sector, or organization and design a concept for an AI-powered solution. This is not a coding exercise \u2014 you are designing the concept, not building the system. The goal is to demonstrate that you can think systematically about AI opportunities with a Ghanaian civic lens.</p><h3>Project Options</h3><p>You may choose any problem from the following sectors, or propose your own with approval:</p><ul><li><strong>Agriculture</strong> \u2014 Crop disease detection, weather advisory, supply chain optimization, market price prediction, or soil health monitoring</li><li><strong>Health</strong> \u2014 Diagnostic assistance, disease surveillance, maternal health prediction, telemedicine triage, or health record analysis</li><li><strong>Education</strong> \u2014 Adaptive learning, language support for Ghanaian language speakers, teacher assistant tools, or dropout prediction</li><li><strong>Governance</strong> \u2014 Public service chatbot, budget analysis tool, fraud detection, service delivery monitoring, or citizen feedback analysis</li><li><strong>Environment</strong> \u2014 Illegal mining detection, deforestation monitoring, waste management optimization, or flood prediction</li><li><strong>Digital Economy</strong> \u2014 Market platform for informal sector workers, credit scoring for the unbanked, or AI-powered creative tools for Ghanaian artists</li></ul><h3>Deliverable Requirements</h3><p>Your completed AI Opportunity Map must include:</p><ol><li><strong>Problem statement</strong> \u2014 What is the problem? Who experiences it? How widespread is it? (1 paragraph, with data if available)</li><li><strong>AI concept</strong> \u2014 What does the AI system do? What type of AI is it (ML, NLP, CV)? How would a user interact with it? (1-2 paragraphs)</li><li><strong>Data requirements</strong> \u2014 What data does the system need? Where would the data come from? How would you ensure it is representative and collected ethically? (1 paragraph)</li><li><strong>Ethical analysis</strong> \u2014 Using the six questions from Module 5, identify at least two ethical considerations and how you would address them. (1 paragraph)</li><li><strong>Stakeholder map</strong> \u2014 Who needs to be involved? List at least 5 stakeholders: end users, data providers, technical partners, funders, regulators. (List with brief descriptions)</li><li><strong>Impact metrics</strong> \u2014 How would you measure success? Define at least 3 measurable outcomes. (e.g., number of users, accuracy rate, time saved, cost reduced, cases detected)</li><li><strong>Reflection</strong> \u2014 What was the most surprising thing you learned in this course? What is the one action you will take to participate in Ghana''s AI future? (2 paragraphs)</li></ol><h3>Submission</h3><p>Submit your AI Opportunity Map as a PDF or Google Doc. Upon review, you will receive a Certificate of AI Fundamentals for Ghanaians from Studio Gabochie. Outstanding projects may be featured on the Studio website and shared with the Ministry of Communications and Digitalisation or partner organizations.</p>' WHERE slug = 'ai-fundamentals'`,
    // Activate Civic Intelligence Certificate with full content
    `UPDATE programs SET status = 'active', full_content = '<h2>Module 1: The Citizen &amp; the Constitution</h2><p>The 1992 Constitution of the Republic of Ghana is the supreme law of the land. It establishes the framework for governance, defines the rights and responsibilities of citizens, and sets the rules by which the country is governed. Understanding the Constitution is the first step toward becoming an informed and engaged citizen.</p><h3>The Three Branches of Government</h3><p>Ghana''s Constitution establishes three independent branches of government, each with its own powers and responsibilities:</p><ul><li><strong>Executive</strong> \u2014 The President, Vice President, and Cabinet ministers. Responsible for implementing laws, formulating policy, and managing the day-to-day affairs of the state. The President is elected for a maximum of two four-year terms (Article 60-67).</li><li><strong>Legislature</strong> \u2014 The Parliament of Ghana, consisting of 275 elected members of Parliament (MPs). Responsible for making laws, approving the national budget, and oversight of the Executive (Article 93-123).</li><li><strong>Judiciary</strong> \u2014 The Supreme Court, Court of Appeal, High Court, and lower courts. Responsible for interpreting the Constitution, settling disputes, and ensuring that laws are applied fairly (Article 125-163).</li></ul><h3>The 261 MMDAs</h3><p>Ghana is divided into 261 Metropolitan, Municipal, and District Assemblies (MMDAs). These are the units of local governance where citizens interact most directly with the state. Each MMDA is led by a Chief Executive appointed by the President and confirmed by a two-thirds majority of assembly members (Article 242). District assemblies are responsible for:</p><ul><li>Infrastructure development (roads, schools, clinics, sanitation)</li><li>Revenue collection (rates, fees, licenses)</li><li>Budget preparation and implementation</li><li>Community development planning</li></ul><h3>Citizen Rights Under the Constitution</h3><p>Chapter 5 of the Constitution guarantees fundamental human rights and freedoms, including:</p><ul><li>Right to life, liberty, and security (Article 13-14)</li><li>Freedom of speech, assembly, and association (Article 21)</li><li>Right to information (Article 21(1)(f))</li><li>Right to education (Article 25)</li><li>Right to participate in governance, including voting and standing for office (Article 42-43)</li><li>Right to access the courts for redress (Article 33)</li></ul><h3>Citizen Responsibilities</h3><p>The Constitution also imposes duties on citizens (Article 41), including:</p><ul><li>To uphold the Constitution and obey the laws of Ghana</li><li>To protect public property and prevent the misappropriation of public funds</li><li>To defend Ghana and render national service when required</li><li>To pay taxes honestly and promptly</li><li>To cooperate with lawful authorities and assist in the maintenance of law and order</li></ul><h3>Reflection Exercise</h3><p>Read Articles 1-5, 12-21, 41-43 of the 1992 Constitution (available online at the Ghana Judicial Service website or via the Constitution PDF). Write down three rights you were unaware of and one responsibility you can practice more intentionally this week.</p><hr><h2>Module 2: Civic Technology &amp; Digital Accountability</h2><p>Civic technology (civic tech) refers to the tools, platforms, and systems that use technology to strengthen the relationship between citizens and their government. In Ghana, civic tech has emerged as a powerful force for accountability, transparency, and citizen engagement.</p><h3>Manifesto Meters</h3><p>A manifesto meter is a digital platform that tracks the promises made by political parties during election campaigns and checks whether those promises are being kept. During Ghana''s 2020 and 2024 elections, platforms like <em>Odekro</em> and <em>GhanaDecides</em> monitored campaign promises and published real-time scorecards.</p><p>Key features:</p><ul><li>Promise categorization by sector (education, health, infrastructure, agriculture)</li><li>Geotagged evidence collection (citizens upload photos of completed or abandoned projects)</li><li>Progress scoring (percentage of promises fulfilled, partially fulfilled, or broken)</li><li>Public dashboard viewable by all citizens</li></ul><h3>Geotagged Service Delivery Dashboards</h3><p>Citizens can report on the state of public services using mobile apps linked to geotagged dashboards. For example, a citizen can photograph a collapsed culvert, report it through a mobile app, and the report is automatically geotagged and routed to the relevant MMDA or ministry.</p><p>Technologies used:</p><ul><li>GPS coordinates embedded in reports</li><li>Real-time dashboards showing open, in-progress, and resolved cases</li><li>Integration with Ghana''s Digital Public Infrastructure (DPI)</li><li>Public-facing leaderboards showing MMDA responsiveness</li></ul><h3>Anonymous Whistleblower Tools</h3><p>Citizens need safe ways to report corruption, waste, or abuse of power. Anonymous whistleblower platforms allow citizens to submit evidence \u2014 documents, photos, videos \u2014 without revealing their identity. In Ghana, platforms like <em>Ghana Integrity Initiative</em> and <em>CitizenWatch</em> operate such tools.</p><h3>Case Study: The Accra CivicHub Blueprint</h3><p>The Accra CivicHub is a proposed physical and digital space where citizens can access government services, attend civic education workshops, and use digital tools to report issues and track government performance. It combines a physical drop-in center with a mobile-first digital platform.</p><p>Key components:</p><ul><li>Service kiosk with terminals for accessing government digital services</li><li>Workshop space for civic education and training</li><li>Digital dashboard wall showing real-time city data (budget execution, project status, complaint resolution)</li><li>WiFi hotspot with access to civic tech platforms</li></ul><h3>Exercise: Design Your Own Manifesto Meter</h3><p>Pick a local issue in your district (e.g., road quality, school infrastructure, health clinic staffing). Design a simple manifesto meter that citizens could use to track promises made by your District Chief Executive or MP. Sketch the dashboard: what data would you track, how would citizens submit evidence, and how would you verify the data?</p><hr><h2>Module 3: Data Sovereignty &amp; AI for Public Good</h2><p>Data sovereignty \u2014 the right of a nation and its people to govern how their data is collected, stored, and used \u2014 is one of the most important civic issues of the 21st century. For Ghana, this means ensuring that the data generated by Ghanaians benefits Ghanaians, and that artificial intelligence systems are developed and deployed in ways that reflect Ghanaian values and priorities.</p><h3>The Data Protection Act (Act 843)</h3><p>Ghana''s Data Protection Act (Act 843) was passed in 2012 to protect the privacy of individuals and regulate the processing of personal data. The Act established the Data Protection Commission (DPC) as the independent regulatory authority.</p><p>Key provisions:</p><ul><li>Personal data must be processed fairly, lawfully, and only for specified purposes (Section 17)</li><li>Data subjects have the right to access, correct, and delete their personal data (Section 35-39)</li><li>Data controllers must register with the DPC and implement security measures (Section 43-48)</li><li>Transfer of personal data outside Ghana is restricted unless the recipient country offers adequate protection (Section 41-42)</li></ul><h3>Ghana''s AI Strategy (2025)</h3><p>The Ghana AI Strategy articulates a vision for artificial intelligence that is "human-centered, ethical, and inclusive." It identifies six priority areas:</p><ol><li><strong>Agriculture</strong> \u2014 AI-powered crop monitoring, yield prediction, and precision farming</li><li><strong>Health</strong> \u2014 AI for disease surveillance, diagnosis, and health system optimization</li><li><strong>Education</strong> \u2014 Personalized learning platforms and AI tutors for Ghanaian languages</li><li><strong>Governance</strong> \u2014 AI for public service delivery, fraud detection, and policy analysis</li><li><strong>Digital Economy</strong> \u2014 AI-driven entrepreneurship, fintech, and creative industries</li><li><strong>Data Infrastructure</strong> \u2014 Localized datasets, data governance frameworks, and AI research capacity</li></ul><h3>Localized Datasets &amp; Ghanaian Languages</h3><p>One of the barriers to AI development in Ghana is the lack of localized datasets. Most AI models are trained on English-language data from the Global North. For AI to serve Ghanaian communities effectively, we need:</p><ul><li>Speech datasets in Twi, Ewe, Dagbani, Ga, and other Ghanaian languages</li><li>Culturally relevant image datasets (e.g., local crops, traditional architecture, market scenes)</li><li>Legal and policy documents in machine-readable formats</li><li>Citizen-generated data on service delivery, infrastructure, and community priorities</li></ul><h3>Citizen Participation in Data Governance</h3><p>Ordinary citizens have a role to play in shaping how data and AI are used in Ghana:</p><ul><li>Participating in public consultations on data protection regulations</li><li>Contributing to open data initiatives by sharing anonymized community data</li><li>Demanding transparency from government and private sector on how personal data is used</li><li>Joining data cooperatives that give communities collective bargaining power over their data</li></ul><h3>Reflection</h3><p>Read the Ghana AI Strategy executive summary (available on the Ministry of Communications website). What are three opportunities for AI to solve a problem in your community? What safeguards would you want in place before AI is deployed?</p><hr><h2>Module 4: Participatory Governance &amp; Community Organizing</h2><p>Participatory governance means giving citizens a direct role in decision-making \u2014 not just through elections every four years, but through ongoing engagement in how public resources are allocated and how policies are designed. In Ghana, the district assembly system is the primary vehicle for participatory governance at the local level.</p><h3>How District Assemblies Work</h3><p>Each of Ghana''s 261 MMDAs is governed by a District Assembly composed of:</p><ul><li><strong>Elected members</strong> \u2014 One representative per electoral area, elected by universal adult suffrage every four years</li><li><strong>Appointed members</strong> \u2014 Up to 30% of assembly members appointed by the President in consultation with traditional authorities and interest groups</li><li><strong>Member of Parliament</strong> \u2014 The MP for the constituency serves as an ex-officio member (non-voting)</li><li><strong>District Chief Executive (DCE)</strong> \u2014 Appointed by the President, confirmed by a two-thirds majority of assembly members present and voting</li></ul><p>The District Assembly meets at least three times a year to approve budgets, bylaws, and development plans. Sub-committees (e.g., Finance, Development Planning, Social Services) do the detailed work between full assembly meetings.</p><h3>Participatory Budgeting</h3><p>Participatory budgeting (PB) is a process in which community members directly decide how to spend a portion of the district''s budget. Originating in Porto Alegre, Brazil, PB has been piloted in several Ghanaian districts with support from organizations like the World Bank and CDD-Ghana.</p><p>How PB works in practice:</p><ol><li><strong>Preparation</strong> \u2014 The district identifies a portion of its budget (typically 5-15%) to be allocated by citizens</li><li><strong>Ideation</strong> \u2014 Community members propose projects (e.g., a borehole, a school toilet block, streetlights)</li><li><strong>Deliberation</strong> \u2014 Proposals are reviewed by a committee of citizens and technical experts for feasibility</li><li><strong>Voting</strong> \u2014 Community members vote on which projects to fund</li><li><strong>Implementation</strong> \u2014 The district implements the winning projects, with citizens monitoring progress</li></ul><h3>Civic Education Clubs</h3><p>Civic Education Clubs (CECs) are school- and community-based groups that promote civic knowledge, democratic values, and active citizenship. They are supported by the National Commission for Civic Education (NCCE) and CSOs like CDD-Ghana.</p><p>A CEC typically:</p><ul><li>Meets weekly to discuss current affairs, constitutional rights, and governance</li><li>Organizes community outreach events (clean-up campaigns, voter registration drives)</li><li>Invites local officials (DCE, MP, judges) to speak and answer questions</li><li>Monitors development projects in the community and reports findings</li></ul><h3>CSOs in Ghana''s Civic Space</h3><p>Several civil society organizations play a key role in Ghana''s governance ecosystem:</p><ul><li><strong>CDD-Ghana</strong> (Ghana Center for Democratic Development) \u2014 Research, advocacy, and civic education on democratic governance</li><li><strong>IMANI Africa</strong> \u2014 Policy research and advocacy on public finance, education, and health</li><li><strong>Ghana Integrity Initiative</strong> \u2014 Anti-corruption advocacy and citizen engagement</li><li><strong>Odekro</strong> \u2014 Parliamentary monitoring and transparency platform</li><li><strong>SEND Ghana</strong> \u2014 Participatory monitoring of public services and budget advocacy</li></ul><h3>Exercise: Map Your Local Governance</h3><p>Find out who your DCE is, your MP, and your elected assembly member. Attend one District Assembly meeting (most are open to the public). Write down: What issues were discussed? How many citizens attended? What decisions were made? Could you see ways to make the process more inclusive?</p><hr><h2>Module 5: National Development Planning Literacy</h2><p>Ghana has produced a series of ambitious national development plans and frameworks that outline the country''s long-term vision and medium-term priorities. For citizens to hold leaders accountable and contribute meaningfully to development, they need the ability to read, understand, and critique these plans.</p><h3>Vision 2057</h3><p>Vision 2057 is Ghana''s long-term development blueprint, timed to coincide with the centenary of Ghana''s independence. It articulates a vision of "a just, free, and prosperous Ghana" and identifies strategic pillars:</p><ul><li><strong>Economic transformation</strong> \u2014 Moving from raw material exports to value-added manufacturing and services</li><li><strong>Social inclusion</strong> \u2014 Universal access to quality education, healthcare, and social protection</li><li><strong>Infrastructure modernization</strong> \u2014 World-class transport, energy, water, and digital infrastructure</li><li><strong>Democratic consolidation</strong> \u2014 Strengthening institutions, rule of law, and citizen participation</li><li><strong>Environmental sustainability</strong> \u2014 Climate-resilient development and natural resource stewardship</li></ul><p>Vision 2057 is implemented through a series of medium-term plans (typically 4-5 year cycles) that cascade from the national level to sector-level and district-level plans.</p><h3>The Ghana Infrastructure Plan (GIP)</h3><p>The GIP is a comprehensive inventory and prioritization of Ghana''s infrastructure needs across all sectors \u2014 roads, railways, ports, energy, water, ICT, schools, and health facilities. It includes cost estimates, funding sources, and implementation timelines.</p><p>Citizens can use the GIP to:</p><ul><li>Check whether planned projects in their district have been funded and executed</li><li>Compare government spending across districts for fairness</li><li>Identify projects that have stalled or been abandoned</li><li>Propose infrastructure priorities for the next planning cycle</li></ul><h3>The National Youth Policy</h3><p>Ghana''s National Youth Policy (NYP) defines the vision, principles, and strategic priorities for youth development (ages 15-35). Key pillars include:</p><ul><li>Quality education and skills training for employability</li><li>Decent work and entrepreneurship opportunities</li><li>Health, well-being, and sports development</li><li>Civic participation and leadership</li><li>Social protection and inclusion of marginalized youth</li></ul><p>The NYP commits government to establishing Youth Advisory Boards at the district level, creating a Youth Development Fund, and integrating youth perspectives into all national planning processes.</p><h3>Reading a Medium-Term Development Plan</h3><p>Each MMDA produces a Medium-Term Development Plan (MTDP) that translates national priorities into local action. A typical MTDP includes:</p><ol><li><strong>Situational analysis</strong> \u2014 Demographic data, economic profile, infrastructure status, social indicators</li><li><strong>Strategic direction</strong> \u2014 Vision, mission, goals, and objectives for the plan period</li><li><strong>Development programs</strong> \u2014 Specific projects and programs with budgets, timelines, and responsible agencies</li><li><strong>Implementation plan</strong> \u2014 Annual action plans, milestones, and performance indicators</li><li><strong>M&E framework</strong> \u2014 How progress will be monitored, evaluated, and reported</li></ol><h3>Exercise: Read Your District MTDP</h3><p>Find your district''s current Medium-Term Development Plan (search: "[Your District] MTDP 2022-2025 Ghana"). Read the situational analysis section. Write down: What are the three biggest development challenges in your district according to the plan? What is the budget allocated to address each? Are the planned projects visible in your community today?</p><hr><h2>Module 6: Capstone \u2014 Civic Action Project</h2><p>The Civic Action Project is your opportunity to move from knowledge to action. You will design and plan a real civic project in your community, drawing on everything you''ve learned in modules 1-5. This is not a theoretical exercise \u2014 your project should be designed for actual implementation.</p><h3>Project Options</h3><p>Choose one of the following project types:</p><ul><li><strong>Manifesto Meter Pilot</strong> \u2014 Design a simple manifesto meter for your constituency. Identify 10 promises made by your MP or DCE during the last election. Create a tracking dashboard (paper or digital). Begin collecting evidence on each promise''s status.</li><li><strong>Community Infrastructure Audit</strong> \u2014 Choose one public facility in your community (a school, clinic, water point, market, or road). Using the GIP framework, assess its current condition against the planned standard. Document with photos, interviews, and measurements. Produce a one-page report with findings and recommendations.</li><li><strong>Civic Education Club Launch</strong> \u2014 Develop a plan to start a Civic Education Club in your school, church, mosque, or community center. Define the club''s mission, meeting structure, initial curriculum (4 sessions), and recruitment strategy. Identify at least two resource persons (e.g., a local official, a teacher, a CSO representative) willing to speak.</li><li><strong>Participatory Budgeting Workshop</strong> \u2014 Organize a small-scale PB exercise in your community. Identify a small public budget (e.g., a school PTA fund, a church building fund, a community levy). Facilitate a meeting where community members propose, deliberate, and vote on how to spend the funds. Document the process and outcomes.</li></ul><h3>Project Deliverable Requirements</h3><p>Your completed project plan must include:</p><ol><li><strong>Problem statement</strong> \u2014 What civic problem are you addressing? Why does it matter? (1 paragraph)</li><li><strong>Stakeholder map</strong> \u2014 Who has power or interest in this issue? Map at least 5 stakeholders (e.g., DCE, MP, assembly member, traditional leader, CSO, community members, media).</li><li><strong>Action plan</strong> \u2014 What will you do? List 5-10 specific actions with a timeline (e.g., Week 1: Identify stakeholders; Week 2: Conduct first meeting; Week 3: Gather evidence; Week 4: Publish findings).</li><li><strong>Impact metrics</strong> \u2014 How will you measure success? Define at least 3 metrics (e.g., number of citizens engaged, number of promises tracked, budget amount influenced, report downloads, meeting attendees).</li><li><strong>Sustainability plan</strong> \u2014 How will this continue after your initial project ends? (1 paragraph)</li><li><strong>Reflection</strong> \u2014 What did you learn from modules 1-5 that most shaped your project? What was the hardest part of designing this project? (2 paragraphs)</li></ol><h3>Project Submission</h3><p>Submit your completed project plan as a PDF or Google Doc. Upon review, you will receive a Certificate of Civic Intelligence from Studio Gabochie. Outstanding projects may be featured on the Studio website and shared with partner organizations (CDD-Ghana, IMANI Africa, etc.) for potential collaboration.</p>' WHERE slug = 'civic-intelligence'`,
    `CREATE TABLE IF NOT EXISTS program_waitlist (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        program_slug TEXT NOT NULL,
        name TEXT NOT NULL DEFAULT '',
        email TEXT NOT NULL,
        phone TEXT DEFAULT '',
        registered_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_pw_program ON program_waitlist(program_slug)`,
    `CREATE INDEX IF NOT EXISTS idx_pw_email ON program_waitlist(email)`,
    // Vision Builders program updates for existing databases
    `INSERT OR IGNORE INTO programs (title, slug, tagline, description, duration, price, price_label, status, sample_content, full_content, sort_order) VALUES ('Pattern Recognition for Vision Builders', 'pattern-recognition-vision-builders', 'See the patterns that shape your world', 'Pattern recognition is how we make sense of a complex world. From the cycles of nature to the rhythms of Scripture, from market trends to human behavior \u2014 patterns reveal the hidden order God has woven into creation. This program teaches you to identify, analyze, and apply patterns across domains: nature, data, human behavior, Scripture, and strategic planning. You will learn to see what others miss and make decisions based on the patterns that shape your world.', '6 weeks', 0, 'Pay What You Can', 'active', '<h2>Welcome to Pattern Recognition for Vision Builders</h2><p>Pattern recognition is one of the most powerful thinking tools God has given us. From the seasons that govern the farmer''s year to the cycles of growth and rest woven into creation, patterns reveal the hidden order behind everything.</p><p>This program teaches you to see, understand, and apply patterns across five domains: nature, data and markets, Scripture, human behavior, and strategic planning. You will develop the ability to anticipate outcomes, make better decisions, and design solutions that work with the grain of how God made the world.</p><p>Start with Module 1 to understand what patterns are and how your brain detects them, then explore patterns in nature, data, Scripture, and human behavior before completing a capstone pattern mapping project.</p>', '', 3)`,
    `INSERT OR IGNORE INTO modules (program_id, title, slug, description, sort_order) VALUES
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 1: What Is Pattern Recognition?', 'pr-intro', 'What patterns are, how the brain detects them, and why they matter for decision-making. Introduction to pattern types: cycles, sequences, symmetries, fractals, and networks.', 1),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 2: Patterns in Nature', 'pr-nature', 'The Fibonacci sequence, golden ratio, spirals, branching, and hexagonal patterns in God''s creation. How nature reveals mathematical and geometric order.', 2),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 3: Patterns in Data &amp; Markets', 'pr-data-markets', 'Trends, cycles, seasonality, and anomalies in data. How to read market patterns, identify opportunities, and avoid common pattern-falling traps like confirmation bias.', 3),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 4: Patterns in Scripture', 'pr-scripture', 'Typology, prophecy-fulfillment patterns, covenant structures, and the chiastic literary structures of the Bible. Seeing how God weaves patterns through redemptive history.', 4),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 5: Pattern-Based Decision Making', 'pr-decisions', 'Using pattern recognition in leadership, strategy, and problem-solving. How to distinguish meaningful patterns from noise, and how to apply pattern intelligence to real-world challenges.', 5),
        ((SELECT id FROM programs WHERE slug = 'pattern-recognition-vision-builders'), 'Module 6: Capstone \u2014 Pattern Mapping Project', 'pr-capstone', 'Identify a pattern in your community, industry, or personal life. Map it, analyze it, and present your findings. Output: a pattern map with observations, analysis, and recommended actions.', 6)
      `,
    // Rename & activate Systems Thinking for Vision Builders (existing DBs)
    `UPDATE programs SET title = 'Systems Thinking for Vision Builders', status = 'active' WHERE slug = 'systems-thinking'`,
    // Fix Architectural Thinking price_label for existing DBs
    `UPDATE programs SET price_label = 'Free' WHERE slug = 'architectural-thinking' AND price_label = 'Coming Soon'`,
    // Force Vision Builders sort_orders
    `UPDATE programs SET sort_order = 2 WHERE slug = 'intro-design-thinking' AND sort_order != 2`,
    `UPDATE programs SET sort_order = 3 WHERE slug = 'pattern-recognition-vision-builders'`,
    `UPDATE programs SET sort_order = 4 WHERE slug = 'architectural-thinking' AND sort_order != 4`,
    // Move Bible courses to 5-7 (after Vision Builders)
    `UPDATE programs SET sort_order = 5 WHERE slug = 'systems-thinking-genesis' AND sort_order != 5`,
    `UPDATE programs SET sort_order = 6 WHERE slug = 'revelation-study' AND sort_order != 6`,
    `UPDATE programs SET sort_order = 7 WHERE slug = 'psalms-worship-word' AND sort_order != 7`,
    // ── Quality Audit Tables ──
    `CREATE TABLE IF NOT EXISTS quality_runs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        trigger TEXT NOT NULL DEFAULT 'manual',
        status TEXT NOT NULL DEFAULT 'in_progress',
        total_checks INTEGER NOT NULL DEFAULT 0,
        passed_checks INTEGER NOT NULL DEFAULT 0,
        failed_checks INTEGER NOT NULL DEFAULT 0,
        warn_checks INTEGER NOT NULL DEFAULT 0,
        started_at TEXT DEFAULT '',
        completed_at TEXT DEFAULT '',
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_quality_runs_status ON quality_runs(status)`,
    `CREATE INDEX IF NOT EXISTS idx_quality_runs_trigger ON quality_runs(trigger)`,
    `CREATE TABLE IF NOT EXISTS quality_reports (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        run_id INTEGER NOT NULL,
        category TEXT NOT NULL,
        page_url TEXT DEFAULT '',
        check_name TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'fail',
        message TEXT DEFAULT '',
        details TEXT DEFAULT '{}',
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        FOREIGN KEY (run_id) REFERENCES quality_runs(id)
      )`,
    `CREATE INDEX IF NOT EXISTS idx_quality_reports_run ON quality_reports(run_id)`,
    `CREATE INDEX IF NOT EXISTS idx_quality_reports_category ON quality_reports(category)`,
    `CREATE INDEX IF NOT EXISTS idx_quality_reports_status ON quality_reports(status)`,
    // ── Fundraising Campaigns ──
    `CREATE TABLE IF NOT EXISTS campaigns (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        slug TEXT NOT NULL UNIQUE,
        description TEXT DEFAULT '',
        goal_amount REAL NOT NULL DEFAULT 0,
        raised_amount REAL NOT NULL DEFAULT 0,
        currency TEXT NOT NULL DEFAULT 'GHS',
        type TEXT NOT NULL DEFAULT 'donation',
        status TEXT NOT NULL DEFAULT 'draft',
        cover_image TEXT DEFAULT '',
        start_date TEXT DEFAULT '',
        end_date TEXT DEFAULT '',
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_campaigns_status ON campaigns(status)`,
    `CREATE INDEX IF NOT EXISTS idx_campaigns_slug ON campaigns(slug)`,
    addColumn("donations", "campaign_id", "INTEGER DEFAULT 0"),
    `CREATE INDEX IF NOT EXISTS idx_donations_campaign ON donations(campaign_id)`,
    // ── Seed: first fundraising campaign ──
    `INSERT OR IGNORE INTO campaigns (name, slug, description, goal_amount, currency, type, status, start_date, end_date) VALUES ('Train 1 Million Ghanaian Youth in Systems Thinking', '1-million-systems-thinkers', 'A national movement to equip 1,000,000 Ghanaian youth with systems thinking, problem-solving, and AI-era skills. Your GH\xA2100 sponsors one youth for a full semester of training in systems thinking, digital literacy, and creative problem-solving.', 1000000, 'GHS', 'crowdfunding', 'active', datetime('now'), datetime('now', '+90 days'))`,
    // ── Classifieds ──
    `CREATE TABLE IF NOT EXISTS classifieds (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT NOT NULL,
        description TEXT NOT NULL DEFAULT '',
        category TEXT NOT NULL DEFAULT 'jobs',
        listing_type TEXT NOT NULL DEFAULT 'free',
        price TEXT DEFAULT '',
        contact_name TEXT DEFAULT '',
        contact_email TEXT DEFAULT '',
        contact_phone TEXT DEFAULT '',
        location TEXT DEFAULT '',
        website TEXT DEFAULT '',
        status TEXT NOT NULL DEFAULT 'pending',
        featured INTEGER NOT NULL DEFAULT 0,
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        expires_at TEXT NOT NULL DEFAULT (datetime('now', '+30 days')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_classifieds_status ON classifieds(status)`,
    `CREATE INDEX IF NOT EXISTS idx_classifieds_category ON classifieds(category)`,
    `CREATE INDEX IF NOT EXISTS idx_classifieds_expires ON classifieds(expires_at)`,
    // ── Tutoring Marketplace ──
    `CREATE TABLE IF NOT EXISTS tutors (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        slug TEXT NOT NULL UNIQUE,
        bio TEXT NOT NULL DEFAULT '',
        subjects TEXT NOT NULL DEFAULT '[]',
        qualifications TEXT DEFAULT '',
        hourly_rate REAL DEFAULT 0,
        currency TEXT NOT NULL DEFAULT 'GHS',
        availability TEXT DEFAULT '',
        email TEXT NOT NULL DEFAULT '',
        phone TEXT DEFAULT '',
        photo_url TEXT DEFAULT '',
        video_url TEXT DEFAULT '',
        status TEXT NOT NULL DEFAULT 'pending',
        featured INTEGER NOT NULL DEFAULT 0,
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_tutors_status ON tutors(status)`,
    `CREATE INDEX IF NOT EXISTS idx_tutors_slug ON tutors(slug)`,
    `CREATE TABLE IF NOT EXISTS tutoring_subjects (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL UNIQUE,
        category TEXT NOT NULL DEFAULT 'academic',
        icon TEXT DEFAULT '\u{1F4DA}'
      )`,
