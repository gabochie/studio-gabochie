      await env.DB.prepare(
        `INSERT INTO momo_manual_claims (tx_ref, momo_txn_id, payer_number, rail, status) VALUES (?, ?, ?, ?, 'submitted')`
      ).bind(tx_ref, momoTxnId, payerNumber, rail).run();
    }
  } catch (_e) {
    return json({ status: "error", message: "Could not record your payment. Please try again." }, 500);
  }
  try {
    await env.DB.prepare(`INSERT INTO events (event_type, event_data, page) VALUES (?, ?, ?)`).bind("momo_claim_submitted", "tx:" + tx_ref, "momo-manual").run();
  } catch (_e) {
  }
  return json({ status: "ok", message: "Payment received \u2014 we are confirming it now. You will get an email receipt once confirmed (usually within a few hours)." });
}
