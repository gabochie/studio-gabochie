function formatDate(d) {
  if (!d) return "";
  var p = d.split(/[-T]/);
  if (p.length < 3) return d;
  var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return p[2] + " " + months[parseInt(p[1]) - 1] + " " + p[0];
}
