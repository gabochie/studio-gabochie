function genToken2() {
  var chars = "abcdefghijklmnopqrstuvwxyz0123456789";
  var r = "";
  for (var i = 0; i < 24; i++) r += chars.charAt(Math.floor(Math.random() * chars.length));
  return "ga_" + Date.now().toString(36) + "_" + r;
}
