// api/enroll/upgrade.js
async function verifyExpressPay(env, txRef, expectedAmount) {
  if (!txRef) return { ok: false, code: "MISSING_TX" };
  var token = "";
  try {
    var row = await env.DB.prepare("SELECT token FROM expresspay_tokens WHERE tx_ref = ?").bind(txRef).first();
    if (row && row.token) token = row.token;
  } catch (_e) {
  }
  if (!token) return { ok: false, code: "NO_TOKEN" };
  var q2 = await expresspayQuery(env, token);
  if (q2.error) return { ok: false, code: "VERIFY_FAILED" };
  if (q2.pending) return { ok: false, code: "PAYMENT_OPEN" };
  if (!q2.approved) return { ok: false, code: "PAYMENT_OPEN" };
  if (q2.orderId && q2.orderId !== txRef) return { ok: false, code: "TX_REF_MISMATCH" };
  if (expectedAmount != null && Math.abs(Number(q2.amount) - Number(expectedAmount)) > 0.01) return { ok: false, code: "AMOUNT_MISMATCH" };
  if (q2.currency && q2.currency !== "GHS") return { ok: false, code: "CURRENCY_MISMATCH" };
  return { ok: true };
}
__name(verifyExpressPay, "verifyExpressPay");
