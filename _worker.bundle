    ).first();
    const memberExpired = await env.DB.prepare(
      "SELECT COUNT(*) AS count FROM users WHERE membership_tier IN ('premium','vip') AND membership_expires_at != '' AND membership_expires_at < datetime('now')"
    ).first();
