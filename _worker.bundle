  "109": { slug: "food", label: "Food & Drink", icon: "\u{1F37D}\uFE0F" },
  "110": { slug: "education", label: "Education", icon: "\u{1F4DA}" },
  "111": { slug: "fashion", label: "Fashion", icon: "\u{1F457}" },
  "112": { slug: "health", label: "Health & Wellness", icon: "\u{1F9D8}" },
  "113": { slug: "business", label: "Business & Networking", icon: "\u{1F4BC}" },
  "114": { slug: "religion", label: "Religion & Spirituality", icon: "\u26EA" },
  "115": { slug: "government", label: "Government & Politics", icon: "\u{1F3DB}\uFE0F" },
