    `CREATE TABLE IF NOT EXISTS tutoring_bookings (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        tutor_id INTEGER NOT NULL,
        student_name TEXT NOT NULL,
        student_email TEXT NOT NULL,
        student_phone TEXT DEFAULT '',
        subject TEXT NOT NULL DEFAULT '',
        preferred_date TEXT DEFAULT '',
        preferred_time TEXT DEFAULT '',
        message TEXT DEFAULT '',
        status TEXT NOT NULL DEFAULT 'pending',
        payment_ref TEXT DEFAULT '',
        payment_amount REAL DEFAULT 0,
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        FOREIGN KEY (tutor_id) REFERENCES tutors(id)
      )`,
    `CREATE INDEX IF NOT EXISTS idx_bookings_tutor ON tutoring_bookings(tutor_id)`,
    `CREATE INDEX IF NOT EXISTS idx_bookings_status ON tutoring_bookings(status)`,
    `CREATE INDEX IF NOT EXISTS idx_bookings_email ON tutoring_bookings(student_email)`,
    // ── Career Applications ──
    `CREATE TABLE IF NOT EXISTS career_applications (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        job_title TEXT NOT NULL DEFAULT '',
        role_id TEXT NOT NULL DEFAULT '',
        name TEXT NOT NULL,
        email TEXT NOT NULL,
        phone TEXT DEFAULT '',
        country TEXT DEFAULT '',
        timezone TEXT DEFAULT '',
        availability_hours INTEGER DEFAULT 0,
        pay_expectation TEXT DEFAULT '',
        cv_url TEXT DEFAULT '',
        portfolio_url TEXT DEFAULT '',
        cover_letter TEXT DEFAULT '',
        source TEXT NOT NULL DEFAULT 'careers',
        status TEXT NOT NULL DEFAULT 'pending',
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
      )`,
    `CREATE INDEX IF NOT EXISTS idx_career_apps_status ON career_applications(status)`,
    `CREATE INDEX IF NOT EXISTS idx_career_apps_email ON career_applications(email)`,
    // Remote-application fields for databases created before the careers rebuild.
    addColumn("career_applications", "role_id", "TEXT DEFAULT ''"),
    addColumn("career_applications", "country", "TEXT DEFAULT ''"),
    addColumn("career_applications", "timezone", "TEXT DEFAULT ''"),
    addColumn("career_applications", "availability_hours", "INTEGER DEFAULT 0"),
