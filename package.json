{
  "name": "studio-gabochie",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev . --d1 DB",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run tests/api",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**,books/**,coverage/**\"",
    "check:mojibake": "node scripts/check-mojibake.cjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run lint:html && npm run check:mojibake && npm run test",
    "predeploy": "npm run lint && node scripts/check-fk-refs.js && npm run check:mojibake",
    "db:seed": "node scripts/db-seed.js",
    "db:setup": "node scripts/db-setup.js",
    "db:backup": "node scripts/db-backup.js",
    "scrape:instagram": "node scripts/scrape-instagram.js",
    "deploy": "npm run predeploy; wrangler pages deploy . --project-name studio-gabochie; npm run db:setup"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "htmlhint": "^1.1.0",
    "lint-staged": "^15.5.0",
    "serve": "^14.2.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.js": "eslint",
    "*.html": [
      "htmlhint"
    ]
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2",
      "minimatch": { "brace-expansion": "1.1.18" }
    },
    "htmlhint": {
      "glob": { "minimatch": { "brace-expansion": "5.0.9" } }
    },
    "vite": { "postcss": "8.5.28" },
    "postcss": { "nanoid": "3.3.18" },
    "ajv": { "fast-uri": "3.1.6" }
  },
  "dependencies": {
    "playwright": "^1.60.0"
  }
}
