{
  "name": "gideonabochie-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run tests/api",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**,books/**\"",
    "check": "npm run lint && npm run lint:html && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "htmlhint": "^1.1.0",
    "vitest": "^3.1.1"
  }
}
