{
  "name": "studio-gabochie",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev . --d1 DB",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run tests/api",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**,books/**,coverage/**\"",
    "check:mojibake": "node scripts/check-mojibake.cjs",
    "check:revenue": "node scripts/check-revenue-config.mjs",
    "podcast": "node scripts/generate-podcast.cjs",
    "lotl:scaffold": "node scripts/scaffold-lotl-year.cjs",
    "lotl:scripts": "node scripts/write-lotl-scripts.cjs",
    "lotl:tts": "node scripts/lotl-tts.cjs",
    "lotl:upload": "node scripts/lotl-upload-audio.cjs",
    "email:friday": "node scripts/generate-friday-email.cjs",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run lint && npm run lint:html && npm run check:mojibake && npm run check:revenue && npm run test",
    "predeploy": "npm run lint && node scripts/check-fk-refs.js && npm run check:mojibake",
    "db:seed": "node scripts/db-seed.js",
    "db:setup": "node scripts/db-setup.js",
    "db:backup": "node scripts/db-backup.js",
    "scrape:instagram": "node scripts/scrape-instagram.js",
    "deploy": "npm run predeploy && wrangler pages deploy . --project-name studio-gabochie && npm run db:setup"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "htmlhint": "^1.9.2",
    "js-yaml": "^4.3.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "serve": "^14.2.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.86.0"
  },
  "lint-staged": {
    "*.js": "eslint",
    "*.html": [
      "htmlhint"
    ]
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2",
      "minimatch": {
        "brace-expansion": "1.1.21"
      }
    },
    "htmlhint": {
      "glob": "14.0.6"
    },
    "vite": {
      "postcss": "8.5.28"
    },
    "postcss": {
      "nanoid": "3.3.20"
    },
    "ajv": {
      "fast-uri": "3.1.9"
    },
    "undici": "8.12.3",
    "braces": "3.0.3",
    "compression": "1.8.2",
    "sharp": "0.35.5"
  }
}
