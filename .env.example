# ==============================================================================
# Studio Gabochie — environment configuration
# Copy to `.dev.vars` for local development (wrangler), or add these in
# Cloudflare Pages → project → Settings → Environment variables for production.
# Values below are illustrative placeholders. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE
# ------------------------------------------------------------------------------
# Public base URL of the site (no trailing slash).
PUBLIC_BASE_URL="https://studio.gabochie.com"

# Shared secret for /api/email/cron (must match the GitHub Actions secret).
CRON_SECRET=""

# Shared secret for /api/agents/* endpoints (must match the GitHub Actions secret).
AGENT_AUTH_KEY=""

# Shared secret between GitHub Actions CI and the site's CI webhook endpoint.
CI_WEBHOOK_SECRET=""

# Admin-only API access.
ADMIN_API_KEY=""
ADMIN_KEY=""
ADMIN_API_URL=""

# ------------------------------------------------------------------------------
# DATABASE / STORAGE (bound in wrangler.json, not env — listed for reference)
#   D1 binding:     DB
#   R2 binding:     ASSETS / BOOKS
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# PAYMENTS — ExpressPay (required)
#   Sandbox merchant id example: 306264946940
# ------------------------------------------------------------------------------
EXPRESSPAY_MERCHANT_ID=""
EXPRESSPAY_API_KEY=""
EXPRESSPAY_BASE_URL=""          # leave unset for default
EXPRESSPAY_LIVE=""              # "1" for production; default = sandbox

# ------------------------------------------------------------------------------
# PAYMENTS — Moolre (optional; disabled when unset)
# ------------------------------------------------------------------------------
MOOLRE_ACCOUNT_NUMBER=""
MOOLRE_API_USER=""
MOOLRE_PUBLIC_KEY=""
MOOLRE_BASE_URL=""
MOOLRE_BUSINESS_EMAIL=""
MOOLRE_SANDBOX=""              # "1" for sandbox

# ------------------------------------------------------------------------------
# PAYMENTS — NOWPayments crypto (optional; disabled when unset)
# ------------------------------------------------------------------------------
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# ------------------------------------------------------------------------------
# PAYMENTS — manual / offline methods (optional)
# ------------------------------------------------------------------------------
MOMO_NUMBER=""                  # manual MoMo wallet (default merchant 0559624456)
MOMO_NAME=""                    # default GABOCHIE DESIGN
BANK_NAME=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_BRANCH=""

CRYPTO_BTC_ADDRESS=""
CRYPTO_EVM_ADDRESS=""
CRYPTO_SOL_ADDRESS=""
CRYPTO_TRX_ADDRESS=""
CRYPTO_USDT_ADDRESS=""

GHS_USD_RATE=""                # fallback FX rate if live fetch fails

# ------------------------------------------------------------------------------
# EMAIL — Brevo (required for email automation)
# ------------------------------------------------------------------------------
BREVO_API_KEY=""
BREVO_WEBHOOK_SECRET=""
NOTIFY_EMAIL=""                 # where internal notifications are sent

# ------------------------------------------------------------------------------
# AI (optional; disabled when unset)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_ENDPOINT=""
OPENROUTER_API_KEY=  # gitleaks:allow
ANTHROPIC_API_KEY=""
AI_API_KEY=""
AI_MODEL=""

# ------------------------------------------------------------------------------
# BOT PROTECTION — Cloudflare Turnstile (optional)
# ------------------------------------------------------------------------------
TURNSTILE_SECRET=""

# ------------------------------------------------------------------------------
# WHATSAPP (optional; disabled when unset)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ------------------------------------------------------------------------------
# EVENTS — Eventbrite (optional)
# ------------------------------------------------------------------------------
EVENTBRITE_API_KEY=""

# ------------------------------------------------------------------------------
# SOCIAL — Instagram (optional)
# ------------------------------------------------------------------------------
IG_USERNAME=""
IG_PASSWORD=""

# ------------------------------------------------------------------------------
# ACCOUNTS — access control + signed tokens
# ------------------------------------------------------------------------------
CF_ACCESS_TEAM=""
CF_ACCESS_AUD=""
TRACKING_JWT_SECRET=""
UNSUBSCRIBE_SECRET=""
